# ===============================
# DFM Selection Observer for Tooltips
# ===============================
class DFMSelectionObserver:
    """Observer to handle selection of DFM highlighted objects and show tooltips"""
    
    def __init__(self, task_panel=None):
        self.task_panel = task_panel
        self.dfm_highlights = {}  # Store highlight info: {object_name: issue_description}
        print(f"DEBUG: DFMSelectionObserver initialized with task_panel: {task_panel is not None}")
    
    def addSelection(self, doc, obj, sub, pnt):
        """Called when an object is selected"""
        try:
            obj_name = obj
            print(f"DEBUG: DFM Selection - Object: {obj_name}, Sub: {sub}, Point: {pnt}")
            print(f"DEBUG: Available DFM highlights: {list(self.dfm_highlights.keys())}")
            
            # Get the actual FreeCAD object to check its properties
            try:
                import FreeCAD
                if hasattr(FreeCAD, 'ActiveDocument') and FreeCAD.ActiveDocument:
                    fc_obj = FreeCAD.ActiveDocument.getObject(obj_name)
                    if fc_obj:
                        print(f"DEBUG: Object type: {fc_obj.TypeId}, Label: {fc_obj.Label}")
                        if hasattr(fc_obj, 'Name'):
                            print(f"DEBUG: Object Name: {fc_obj.Name}")
            except Exception as e:
                print(f"DEBUG: Could not get FreeCAD object details: {e}")
            
            # Check if this is a DFM highlighted object (direct match)
            if obj_name in self.dfm_highlights:
                print(f"DEBUG: [OK] Direct match found for DFM highlight: {obj_name}")
            # Also check if the object name starts with DFM_Issue_ (in case of naming variations)
            elif obj_name.startswith('DFM_Issue_'):
                print(f"DEBUG: [OK] DFM_Issue pattern match found: {obj_name}")
                # Try to find the closest match in our highlights
                for highlight_key in self.dfm_highlights.keys():
                    if highlight_key == obj_name or obj_name in highlight_key:
                        obj_name = highlight_key
                        print(f"DEBUG: Using highlight key: {highlight_key}")
                        break
            else:
                print(f"DEBUG: ❌ No DFM highlight match found for: {obj_name}")
                # Check if any DFM highlights exist in the document
                try:
                    import FreeCAD
                    if hasattr(FreeCAD, 'ActiveDocument') and FreeCAD.ActiveDocument:
                        doc_obj_names = [obj.Name for obj in FreeCAD.ActiveDocument.Objects]
                        dfm_objects = [name for name in doc_obj_names if name.startswith('DFM_Issue_')]
                        print(f"DEBUG: DFM objects in document: {dfm_objects}")
                except:
                    pass
            
            # Process the DFM highlight if found
            if obj_name in self.dfm_highlights:
                issue_description = self.dfm_highlights[obj_name]
                print(f"DEBUG: DFM Tooltip - {issue_description}")
                
                # Show tooltip in FreeCAD status bar
                try:
                    import FreeCADGui
                    if hasattr(FreeCADGui, 'getMainWindow'):
                        main_window = FreeCADGui.getMainWindow()
                        if hasattr(main_window, 'statusBar'):
                            status_bar = main_window.statusBar()
                            status_bar.showMessage(f"DFM Issue: {issue_description}", 5000)  # Show for 5 seconds
                            print("DEBUG: DFM tooltip shown in status bar")
                except Exception as e:
                    print(f"DEBUG: Failed to show status bar message: {e}")
                
                # Show as popup tooltip in 3D view with enhanced visibility
                try:
                    import FreeCADGui
                    from PySide2 import QtWidgets, QtCore, QtGui
                    
                    # Get the 3D view widget
                    mdi = FreeCADGui.getMainWindow().findChild(QtWidgets.QMdiArea)
                    if mdi and mdi.activeSubWindow():
                        view_widget = mdi.activeSubWindow().widget()
                        if view_widget:
                            # Create a more visible tooltip with rich formatting
                            cursor_pos = QtGui.QCursor.pos()
                            
                            # Enhanced tooltip with better formatting
                            tooltip_text = f"""<div style='background-color: #ffffcc; padding: 8px; border: 2px solid #ff6600; border-radius: 4px;'>
<b style='color: #cc0000;'>🔍 DFM Manufacturing Issue</b><br/>
<span style='color: #000000;'>{issue_description}</span><br/>
<i style='color: #666666; font-size: 10px;'>Click for details in Manufacturing Issues section</i>
</div>"""
                            
                            # Show enhanced tooltip at cursor position
                            QtWidgets.QToolTip.showText(cursor_pos, tooltip_text, view_widget, QtCore.QRect(), 8000)  # Show for 8 seconds
                            print("DEBUG: Enhanced DFM tooltip shown as 3D view popup")
                            
                            # Also create a temporary message box for critical issues
                            if 'critical' in issue_description.lower() or 'thin wall' in issue_description.lower():
                                try:
                                    # Create a non-blocking message for critical issues
                                    msg = QtWidgets.QMessageBox()
                                    msg.setIcon(QtWidgets.QMessageBox.Warning)
                                    msg.setWindowTitle("Critical DFM Issue Detected")
                                    msg.setText(f"⚠️ {issue_description}")
                                    msg.setInformativeText("This issue requires immediate attention for successful manufacturing.")
                                    msg.setStandardButtons(QtWidgets.QMessageBox.Ok)
                                    msg.setDefaultButton(QtWidgets.QMessageBox.Ok)
                                    
                                    # Show non-blocking
                                    msg.show()
                                    print("DEBUG: Critical issue popup shown")
                                except Exception as popup_e:
                                    print(f"DEBUG: Failed to show critical issue popup: {popup_e}")
                                    
                except Exception as e:
                    print(f"DEBUG: Failed to show 3D view tooltip: {e}")
                    # Fallback to simple tooltip
                    try:
                        from PySide2 import QtWidgets
                        QtWidgets.QToolTip.showText(QtGui.QCursor.pos(), f"DFM Issue: {issue_description}")
                        print("DEBUG: Fallback tooltip shown")
                    except:
                        pass
                
                # Show detailed information in chat interface if available
                try:
                    if self.task_panel and hasattr(self.task_panel, 'add_system_message'):
                        # Find the full issue details from the stored highlights
                        full_issue_info = None
                        for highlight_key, highlight_data in self.dfm_highlights.items():
                            if highlight_key == obj_name and isinstance(highlight_data, dict):
                                full_issue_info = highlight_data
                                break
                        
                        if full_issue_info:
                            severity = full_issue_info.get('severity', 'unknown')
                            issue_type = full_issue_info.get('type', 'unknown')
                            recommendations = full_issue_info.get('recommendations', [])
                            
                            # Create detailed message for chat interface
                            severity_emoji = {
                                'critical': '🔴',
                                'high': '🟠', 
                                'medium': '🟡',
                                'low': '🔵'
                            }.get(severity, '⚪')
                            
                            detailed_msg = f"""
{severity_emoji} **Selected DFM Issue Details:**
**Type:** {issue_type.replace('_', ' ').title()}
**Severity:** {severity.title()}
**Description:** {issue_description}

**Recommendations:**"""
                            
                            if recommendations:
                                for i, rec in enumerate(recommendations[:3], 1):  # Show first 3 recommendations
                                    detailed_msg += f"\n{i}. {rec}"
                            else:
                                detailed_msg += "\n• Review geometry for manufacturability"
                            
                            self.task_panel.add_system_message(detailed_msg)
                            print("DEBUG: Detailed DFM issue info added to chat interface")
                        else:
                            # Fallback message
                            self.task_panel.add_system_message(f"🔍 **Selected DFM Issue:** {issue_description}")
                            print("DEBUG: Basic DFM issue info added to chat interface")
                except Exception as chat_e:
                    print(f"DEBUG: Failed to show issue in chat interface: {chat_e}")
                
                # Also show in console for debugging
                try:
                    import FreeCAD
                    FreeCAD.Console.PrintMessage(f"DFM Issue Selected: {issue_description}\n")
                except:
                    pass
                    
        except Exception as e:
            print(f"DEBUG: DFM Selection error: {e}")
    
    def update_highlights(self, highlights_dict):
        """Update the stored highlight information"""
        self.dfm_highlights = highlights_dict
        print(f"DEBUG: Updated DFM highlights: {list(highlights_dict.keys())}")
        
    def set_task_panel(self, task_panel):
        """Update the task panel reference for tooltip display"""
        self.task_panel = task_panel
        print(f"DEBUG: DFM observer task panel updated: {task_panel is not None}")
    
    def setSelection(self, doc):
        """Called when selection is set"""
        pass
    
    def clearSelection(self, doc):
        """Called when selection is cleared"""
        pass

# ===============================
# Manufacturing Feature Manager
# ===============================
class ManufacturingFeatureManager:
    """Manages manufacturing features like DFM, cost estimation, and tool recommendations"""
    
    def __init__(self):
        """Initialize the manufacturing feature manager"""
        self.last_dfm_result = None
        self.last_cost_result = None
        self.last_tool_result = None
        self.cloud_integration = None
        
        # Try to initialize cloud integration
        if _CLOUD_SERVICES_AVAILABLE:
            try:
                from cloud_services.cloud_integration import CloudIntegration
                this_dir = os.path.dirname(os.path.abspath(__file__))
                config_path = os.path.join(this_dir, "cloud_config.json")
                self.cloud_integration = CloudIntegration(config_path)
                print("Cloud integration initialized for manufacturing features")
            except Exception as e:
                print(f"Error initializing cloud integration: {str(e)}")
                traceback.print_exc()
    
    def analyze_dfm(self, manufacturing_process="3d_printing", material="pla", production_volume=1, advanced_analysis=True):
        """Analyze design for manufacturability using industry-grade DFM engine"""
        try:
            # Use cloud integration if available
            if self.cloud_integration:
                result = self.cloud_integration.analyze_dfm(
                    manufacturing_process=manufacturing_process,
                    material=material,
                    production_volume=production_volume,
                    advanced_analysis=advanced_analysis
                )
                
                # Check if cloud service failed to provide detailed analysis
                if result and result.get('success'):
                    data = result.get('data', {})
                    design_issues = data.get('design_issues', [])
                    
                    # Check if cloud returned "Unable to perform detailed analysis"
                    has_insufficient_analysis = any(
                        isinstance(issue, str) and 'Unable to perform detailed analysis' in issue
                        for issue in design_issues
                    )
                    
                    if has_insufficient_analysis:
                        print("🔄 Cloud DFM returned insufficient analysis, using comprehensive geometric analysis...")
                        
                        try:
                            # DIRECT COMPREHENSIVE GEOMETRIC ANALYSIS
                            print("🔍 Performing comprehensive geometric analysis...")
                            
                            # Extract CAD data for analysis
                            cad_data = extract_cad_data_for_features()
                            
                            # Perform comprehensive geometric analysis using our implemented logic
                            geometric_issues = self._perform_comprehensive_geometric_analysis()
                            
                            if geometric_issues and len(geometric_issues) > 0:
                                print(f"🎯 Comprehensive analysis found {len(geometric_issues)} specific geometric issues")
                                
                                # Create enhanced result with geometric findings
                                enhanced_result = self._create_geometric_dfm_result(
                                    cloud_result=result,
                                    geometric_issues=geometric_issues,
                                    manufacturing_process=manufacturing_process,
                                    material=material,
                                    production_volume=production_volume
                                )
                                
                                print("🎆 Comprehensive geometric analysis complete - real manufacturing issues identified!")
                                self.last_dfm_result = enhanced_result
                                return enhanced_result
                            else:
                                print("⚠️ No specific geometric issues found, using cloud result")
                            
                            # FALLBACK TO BASIC ANALYSIS IF NO GEOMETRIC ISSUES FOUND
                            print("🔄 Using basic manufacturability analysis...")
                            
                            # Initialize enhanced local analyzer
                            local_analyzer = EnhancedLocalDFMAnalyzer()
                            
                            # Perform enhanced local analysis
                            local_result = local_analyzer.analyze_dfm(
                                cad_data=cad_data,
                                manufacturing_process=manufacturing_process,
                                material=material,
                                production_volume=production_volume
                            )
                            
                            if local_result.get('success'):
                                print("[OK] Enhanced local DFM analysis successful!")
                                
                                # Create hybrid result combining cloud + local insights
                                hybrid_result = self._create_hybrid_dfm_result(
                                    cloud_result=result,
                                    local_result=local_result,
                                    manufacturing_process=manufacturing_process,
                                    material=material,
                                    production_volume=production_volume
                                )
                                
                                print("🎆 Hybrid DFM analysis complete - combining cloud AI + local expertise!")
                                self.last_dfm_result = hybrid_result
                                return hybrid_result
                            else:
                                print("❌ Enhanced local DFM analysis failed, using cloud result")
                                
                        except Exception as local_e:
                            print(f"Enhanced local DFM analysis error: {str(local_e)}")
                
                self.last_dfm_result = result
                return result
            # Otherwise use cloud functions if available
            elif _CLOUD_FUNCTIONS_AVAILABLE:
                result = analyze_dfm(manufacturing_process, material, production_volume)
                self.last_dfm_result = result
                return result
            # Fall back to direct API call
            else:
                payload = {
                    "manufacturing_process": manufacturing_process,
                    "material": material,
                    "production_volume": production_volume,
                    "advanced_analysis": advanced_analysis,
                    "cad_data": extract_cad_data_for_features()
                }
                result = call_feature("dfm_analysis", payload)
                self.last_dfm_result = result
                return result
                
        except Exception as e:
            print(f"Error in DFM analysis: {str(e)}")
            traceback.print_exc()
            
            # Try enhanced local DFM analysis as fallback
            try:
                print("🔄 Attempting enhanced local DFM analysis...")
                from utils.enhanced_local_dfm import EnhancedLocalDFMAnalyzer
                
                # Extract CAD data for local analysis
                cad_data = extract_cad_data_for_features()
                
                # Initialize enhanced local analyzer
                local_analyzer = EnhancedLocalDFMAnalyzer()
                
                # Perform enhanced local analysis
                result = local_analyzer.analyze_dfm(
                    cad_data=cad_data,
                    manufacturing_process=manufacturing_process,
                    material=material,
                    production_volume=production_volume
                )
                
                if result.get('success'):
                    print("[OK] Enhanced local DFM analysis successful!")
                    self.last_dfm_result = result
                    return result
                else:
                    print("❌ Enhanced local DFM analysis failed")
                    
            except Exception as local_e:
                print(f"Enhanced local DFM analysis error: {str(local_e)}")
            
            return {
                "success": False,
                "error": str(e),
                "service": "dfm",
                "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S")
            }
    
    def _create_hybrid_dfm_result(self, cloud_result, local_result, manufacturing_process, material, production_volume):
        """Create a hybrid DFM result combining cloud AI insights with enhanced local analysis"""
        try:
            # Get data from both sources
            cloud_data = cloud_result.get('data', {})
            local_data = local_result.get('data', {})
            
            # Start with the enhanced local analysis as the base (more accurate for Indian market)
            hybrid_data = local_data.copy()
            
            # Enhance with cloud AI insights where available
            # 1. Use cloud's material suggestions if they exist and are meaningful
            cloud_materials = cloud_data.get('material_suggestions', [])
            if cloud_materials and cloud_materials != ['ABS', 'PLA', 'Aluminum']:  # Not generic
                hybrid_data['alternative_materials'] = cloud_materials
            
            # 2. Use cloud's process recommendations if they exist and are meaningful
            cloud_processes = cloud_data.get('process_recommendations', [])
            if cloud_processes and cloud_processes != ['3D Printing', 'CNC Machining']:  # Not generic
                hybrid_data['alternative_processes_ai'] = cloud_processes
            
            # 3. Combine manufacturing features analysis
            cloud_features = cloud_data.get('manufacturing_features', {})
            if cloud_features:
                hybrid_data['ai_insights'] = {
                    'complexity_rating': cloud_features.get('complexity_rating', 'Unknown'),
                    'moldability_score': cloud_features.get('moldability_score', 0),
                    'ai_analysis_available': True
                }
            else:
                hybrid_data['ai_insights'] = {
                    'ai_analysis_available': False,
                    'note': 'Cloud AI analysis not available for this geometry'
                }
            
            # 4. PRESERVE DESIGN_ISSUES FROM CLOUD DATA (PROBLEM AREAS BUTTON FIX)
            cloud_design_issues = cloud_data.get('design_issues', [])
            if cloud_design_issues:
                hybrid_data['design_issues'] = cloud_design_issues
                print(f"DEBUG: Preserved {len(cloud_design_issues)} design_issues in hybrid result")
            
            # 5. Enhanced analysis summary
            hybrid_data['analysis_summary'] = {
                'primary_analysis': 'Enhanced Local DFM (Indian Market Focus)',
                'ai_enhancement': 'Cloud AI Insights' if cloud_features else 'Not Available',
                'cost_analysis': 'Verified Indian Market Rates',
                'supplier_context': 'Indian Manufacturing Ecosystem',
                'confidence_level': 'High' if cloud_features else 'Medium'
            }
            
            # 5. Add hybrid service identifier
            hybrid_result = {
                'success': True,
                'data': hybrid_data,
                'service': 'hybrid_dfm_cloud_local',
                'timestamp': local_result.get('timestamp', ''),
                'analysis_components': {
                    'enhanced_local_dfm': True,
                    'cloud_ai_insights': bool(cloud_features),
                    'indian_market_context': True,
                    'verified_rates': True
                }
            }
            
            return hybrid_result
            
        except Exception as e:
            print(f"Error creating hybrid DFM result: {str(e)}")
            # Fallback to local result if hybrid creation fails
            return local_result
    
    def _create_claude_dfm_result(self, cloud_result, claude_result, manufacturing_process, material, production_volume):
        """Create a DFM result combining cloud data with Claude's advanced issue detection"""
        try:
            # Get data from both sources
            cloud_data = cloud_result.get('data', {})
            claude_issues = claude_result.get('issues', [])
            claude_recommendations = claude_result.get('recommendations', [])
            severity_summary = claude_result.get('severity_summary', {})
            
            # Create enhanced data structure with Claude's findings
            enhanced_data = {
                # Preserve cloud geometry analysis
                'geometry_summary': cloud_data.get('geometry_summary', {}),
                'cost_analysis': cloud_data.get('cost_analysis', {}),
                'process_recommendations': cloud_data.get('process_recommendations', []),
                'material_suggestions': cloud_data.get('material_suggestions', []),
                
                # Add Claude's advanced issue detection
                'manufacturing_issues': [],
                'design_issues': [],  # For UI compatibility
                'manufacturability_score': self._calculate_score_from_issues(claude_issues),
                'overall_rating': self._get_rating_from_score(self._calculate_score_from_issues(claude_issues)),
                
                # Enhanced recommendations combining both sources
                'recommendations': claude_recommendations,
                
                # Claude-specific insights
                'claude_analysis': {
                    'issues_detected': len(claude_issues),
                    'severity_breakdown': severity_summary,
                    'analysis_type': 'advanced_ai_detection',
                    'manufacturing_focus': manufacturing_process
                },
                
                # Analysis metadata
                'analysis_summary': {
                    'primary_analysis': 'Claude AI Advanced DFM Detection',
                    'ai_enhancement': 'Anthropic Claude API',
                    'issue_detection': 'Real Manufacturing Problems Identified',
                    'confidence_level': 'Very High'
                }
            }
            
            # Convert Claude issues to both formats for compatibility
            for issue in claude_issues:
                # Format for manufacturing_issues (detailed)
                manufacturing_issue = {
                    'title': issue.get('title', 'Manufacturing Issue'),
                    'severity': issue.get('severity', 'medium'),
                    'description': issue.get('description', ''),
                    'recommendation': issue.get('recommendation', ''),
                    'type': issue.get('type', 'manufacturing_issue'),
                    'location': issue.get('location', 'geometry'),
                    'impact': issue.get('impact', 'Affects manufacturing quality'),
                    'position': issue.get('position', {'x': 0, 'y': 0, 'z': 0})
                }
                enhanced_data['manufacturing_issues'].append(manufacturing_issue)
                
                # Format for design_issues (UI compatibility)
                design_issue = {
                    'severity': issue.get('severity', 'medium'),
                    'description': f"{issue.get('title', 'Issue')}: {issue.get('description', '')}",
                    'recommendation': issue.get('recommendation', ''),
                    'type': issue.get('type', 'manufacturing_issue'),
                    'position': issue.get('position', {'x': 0, 'y': 0, 'z': 0})
                }
                enhanced_data['design_issues'].append(design_issue)
            
            print(f"DEBUG: Claude result created with {len(enhanced_data['manufacturing_issues'])} issues")
            print(f"DEBUG: Claude result created with {len(enhanced_data['design_issues'])} design_issues")
            
            # Create final result structure
            claude_dfm_result = {
                'success': True,
                'data': enhanced_data,
                'service': 'claude_dfm_advanced',
                'timestamp': claude_result.get('timestamp', ''),
                'analysis_components': {
                    'claude_ai_detection': True,
                    'cloud_geometry_analysis': True,
                    'real_issue_identification': True,
                    'manufacturing_focused': True
                }
            }
            
            return claude_dfm_result
            
        except Exception as e:
            print(f"Error creating Claude DFM result: {str(e)}")
            # Fallback to cloud result if Claude integration fails
            return cloud_result
    
    def _calculate_score_from_issues(self, issues):
        """Calculate manufacturability score based on Claude's issue detection"""
        if not issues:
            return 95  # High score if no issues found
        
        # Start with perfect score and deduct based on severity
        score = 100
        for issue in issues:
            severity = issue.get('severity', 'medium')
            if severity == 'critical':
                score -= 25
            elif severity == 'high':
                score -= 15
            elif severity == 'medium':
                score -= 8
            elif severity == 'low':
                score -= 3
        
        return max(score, 10)  # Minimum score of 10
    
    def _get_rating_from_score(self, score):
        """Convert numeric score to rating"""
        if score >= 90:
            return 'excellent'
        elif score >= 75:
            return 'good'
        elif score >= 60:
            return 'fair'
        else:
            return 'poor'
    
