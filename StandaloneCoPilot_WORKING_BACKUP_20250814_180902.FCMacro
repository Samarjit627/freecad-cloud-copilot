        self.send_button.setMinimumHeight(80)
        input_layout.addWidget(self.send_button)
        
        layout.addLayout(input_layout)
        
        # Connect enter key to send message
        self.input_field.installEventFilter(self)
        
        # Add buttons
        button_layout = QtWidgets.QHBoxLayout()
        
        self.analyze_button = QtWidgets.QPushButton("Analyze")
        self.analyze_button.clicked.connect(self.on_analyze_clicked)
        
        self.suggestions_button = QtWidgets.QPushButton("Suggestions")
        self.suggestions_button.clicked.connect(self.on_suggestions_clicked)
        
        self.clear_button = QtWidgets.QPushButton("Clear")
        self.clear_button.clicked.connect(self.on_clear_clicked)
        
        button_layout.addWidget(self.analyze_button)
        button_layout.addWidget(self.suggestions_button)
        button_layout.addWidget(self.clear_button)
        
        layout.addLayout(button_layout)
        
        # Add cloud manufacturing features section
        self.add_manufacturing_features_ui(layout)
        
        # Add initial message
        self.add_system_message("Welcome to the Manufacturing Co-Pilot!")
        self.add_system_message("Ask questions about manufacturing or CAD design.")
        
        # Add cloud status message
        if self.cloud_connected:
            self.add_system_message(f"Connected to cloud service at {self.cloud_client.api_url}")
        else:
            self.add_system_message(f"Failed to connect to cloud service: {self.cloud_client.last_error}")
    
    def eventFilter(self, obj, event):
        """Handle events for input field"""
        if obj is self.input_field and event.type() == QtCore.QEvent.KeyPress:
            if event.key() == QtCore.Qt.Key_Return and not event.modifiers() & QtCore.Qt.ShiftModifier:
                self.send_message()
                return True
        return super().eventFilter(obj, event)
    
    def send_message(self):
        """Send a message to the cloud service"""
        message = self.input_field.toPlainText().strip()
        if not message:
            return
        
        # Add user message to chat history
        self.add_user_message(message)
        
        # Clear input field
        self.input_field.clear()
        
        # Show processing indicator
        self.add_system_message("Processing...")
        
        # Try text-to-CAD first (if available)
        if hasattr(self, 'nl_cad_editor') and hasattr(self.nl_cad_editor, 'text_to_cad') and self.nl_cad_editor.text_to_cad.is_text_to_cad_request(message):
            self.process_cad_command(message)
        # Check if this is a regular CAD command
        elif self.is_cad_command(message):
            self.process_cad_command(message)
        else:
            # Use Axis 5 Claude AI for conversational CAD generation and manufacturing intelligence
            try:
                # Remove processing indicator
                self.remove_last_processing_message()
                
                # Use Claude AI processor for advanced conversational processing
                if hasattr(self, 'ai_processor') and self.ai_processor:
                    print(f"🤖 Axis 5 processing conversational request: {message[:50]}...")
                    ai_response = self.ai_processor.process_advanced_command(message)
                    
                    if ai_response and ai_response.get('success'):
                        response_text = ai_response.get('response', 'No response received')
                        
                        # Check if Claude generated FreeCAD code for CAD generation
                        freecad_code = ai_response.get('freecad_code')
                        if freecad_code:
                            print(f"[OK] Axis 5 generated FreeCAD code: {len(freecad_code)} chars")
                            # Execute the FreeCAD code for CAD generation
                            try:
                                exec(freecad_code)
                                if FreeCAD.ActiveDocument:
                                    FreeCAD.ActiveDocument.recompute()
                                if hasattr(FreeCADGui, 'ActiveDocument') and FreeCADGui.ActiveDocument:
                                    FreeCADGui.ActiveDocument.ActiveView.fitAll()
                                response_text += "\n\n[OK] CAD model generated successfully and visible in 3D view!"
                            except Exception as code_err:
                                print(f"Error executing Axis 5's FreeCAD code: {str(code_err)}")
                                response_text += f"\n\n⚠️ Error executing generated CAD code: {str(code_err)}"
                        
                        # Add Axis 5's conversational response to chat
                        source = ai_response.get('source', 'ai')
                        if source == 'claude_conversational':
                            self.add_assistant_message(f"🤖 Axis 5: {response_text}")
                        else:
                            self.add_assistant_message(response_text)
                    else:
                        error_msg = ai_response.get('error', 'Unknown error') if ai_response else 'No response'
                        print(f"Axis 5 processing failed: {error_msg}")
                        # Fallback to cloud service
                        response = self.cloud_client.get_chat_response(message)
                        
                        # Extract response text
                        if "response" in response:
                            response_text = response["response"]
                        elif "error" in response:
                            response_text = f"Error: {response['error']}"
                        else:
                            print(f"Debug: Received empty response from cloud: {response}")
                            response_text = "I'm processing your request locally."
                        
                        # Add fallback response
                        self.add_assistant_message(response_text)
                else:
                    # Fallback to cloud service if AI processor not available
                    response = self.cloud_client.get_chat_response(message)
                    
                    # Extract response text
                    if "response" in response:
                        response_text = response["response"]
                    elif "error" in response:
                        response_text = f"Error: {response['error']}"
                    else:
                        print(f"Debug: Received empty response from cloud: {response}")
                        response_text = "I'm processing your request locally."
                    
                    # Add fallback response
                    self.add_assistant_message(response_text)
                
            except Exception as e:
                # Remove processing indicator
                self.remove_last_processing_message()
                
                # Add error message
                self.add_system_message(f"Axis 5 Error: {str(e)}")
                print(f"Error in Axis 5 processing: {e}")
                traceback.print_exc()
    
    def is_cad_command(self, text):
        """Check if the text is a CAD command"""
        cad_indicators = [
            'create', 'make', 'add', 'generate',
            'box', 'cylinder', 'sphere', 'cube',
            'bracket', 'gear', 'housing', 'shaft',
            'extrude', 'extend', 'pull', 'fillet', 'round'
        ]
        
        text_lower = text.lower()
        return any(indicator in text_lower for indicator in cad_indicators)
    
    def process_cad_command(self, text):
        """Process a CAD command using the NL CAD editor"""
        try:
            # Remove processing indicator
            self.remove_last_processing_message()
            
            # Add system message
            self.add_system_message(f"Creating CAD model from: '{text}'")
            
            # Update status indicator
            self.cloud_feature_status.setText("Processing Text-to-CAD request...")
            
            # Process command with NL CAD editor
            result = self.nl_cad_editor.process_command(text)
            
            if result['success']:
                # Add success message
                self.add_system_message(f"[OK] {result['message']}")
                
                # Check for engineering analysis from Text-to-CAD
                if 'engineering_analysis' in result and result['engineering_analysis']:
                    # Format engineering analysis as a detailed message
                    analysis_message = f"I've created the CAD model based on your description. You can see it in the 3D view.\n\n"
                    analysis_message += f"**Engineering Analysis:**\n{result['engineering_analysis']}"
                    self.add_assistant_message(analysis_message)
                else:
                    # Add standard assistant message with details
                    self.add_assistant_message(f"I've created the CAD model based on your description. You can see it in the 3D view.")
            else:
                # Add error message
                self.add_system_message(f"❌ {result['message']}")
                
                # Add assistant message with error
                self.add_assistant_message(f"I couldn't create the CAD model. {result['message']}")
            
        except Exception as e:
            # Add error message
            self.add_system_message(f"Error processing CAD command: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status indicator
            self.cloud_feature_status.setText("Ready")
    
    def update_status(self, connected, quality="unknown", latency=0):
        """Update the cloud connection status indicator"""
        if connected:
            # Set color based on connection quality
            if quality == "excellent":
                self.status_indicator.setStyleSheet("color: #00AA00;")  # Bright green
                status_text = "Cloud: Excellent"
            elif quality == "good":
                self.status_indicator.setStyleSheet("color: #00CC00;")  # Green
                status_text = "Cloud: Good"
            elif quality == "fair":
                self.status_indicator.setStyleSheet("color: #CCCC00;")  # Yellow
                status_text = "Cloud: Fair"
            elif quality == "poor":
                self.status_indicator.setStyleSheet("color: #CC6600;")  # Orange
                status_text = "Cloud: Poor"
            else:
                self.status_indicator.setStyleSheet("color: #00CC00;")  # Default green
                status_text = "Cloud: Connected"
                
            self.status_text.setText(status_text)
            self.cloud_connected = True
            
            # Update tooltip with detailed info
            tooltip = f"Cloud Status: {quality.title()}\nLatency: {latency}ms"
            self.status_widget.setToolTip(tooltip)
        else:
            self.status_indicator.setStyleSheet("color: red;")
            self.status_text.setText("Cloud: Disconnected")
            self.cloud_connected = False
            self.status_widget.setToolTip("Cloud connection failed. Click to retry.")
    
    def retry_connection(self, event):
        """Retry cloud connection when status indicator is clicked"""
        self.add_system_message("Retrying cloud connection...")
        success = self.cloud_client.test_connection()
        if success:
            self.add_system_message("Cloud connection restored!")
        else:
            self.add_system_message(f"Cloud connection failed: {self.cloud_client.last_error}")
    
    def check_connection(self):
        """Periodically check cloud connection"""
        # Only run check if more than 5 minutes since last check
        current_time = time.time()
        if current_time - self.cloud_client.last_check_time > 300:
            print("Performing periodic connection check")
            self.cloud_client.test_connection()
    
    def add_system_message(self, message):
        """Add a system message to the chat history"""
        print(f"DEBUG: add_system_message called with message: {message}")
        timestamp = datetime.now().strftime("%H:%M")
        chat_entry = f"<b>[{timestamp}] System:</b> {message}"
        
        # Initialize chat_entries as a list if it doesn't exist
        if not hasattr(self, 'chat_entries') or self.chat_entries is None:
            print("DEBUG: Initializing chat_entries as a list in add_system_message")
            self.chat_entries = []
            
        # Ensure chat_entries is a list before appending
        if not isinstance(self.chat_entries, list):
            print(f"DEBUG: Converting chat_entries from {type(self.chat_entries)} to list in add_system_message")
            self.chat_entries = [str(self.chat_entries)]
            
        self.chat_entries.append(chat_entry)
        print("DEBUG: Updated chat_entries with system message, refreshing display")
        # Force refresh of the chat display
        self._update_chat_display()
        
    def remove_last_processing_message(self):
        """Remove the last 'Processing...' message from chat history"""
        print("DEBUG: Removing last processing message")
        
        # Initialize chat_entries if needed
        if not hasattr(self, 'chat_entries') or not isinstance(self.chat_entries, list):
            print("DEBUG: No chat_entries list to remove from")
            return
            
        # Find and remove the last processing message
        for i in range(len(self.chat_entries) - 1, -1, -1):
            if "Processing..." in self.chat_entries[i]:
                print(f"DEBUG: Found processing message at index {i}")
                self.chat_entries.pop(i)
                print("DEBUG: Removed processing message, refreshing display")
                self._update_chat_display()
                return
                
        print("DEBUG: No processing message found to remove")
    
    def add_user_message(self, message):
        """Add a user message to the chat history"""
        print(f"DEBUG: add_user_message called with message: {message}")
        timestamp = datetime.now().strftime("%H:%M")
        chat_entry = f"<b>[{timestamp}] You:</b> {message}"
        
        # Initialize chat_entries as a list if it doesn't exist
        if not hasattr(self, 'chat_entries') or self.chat_entries is None:
            print("DEBUG: Initializing chat_entries as a list in add_user_message")
            self.chat_entries = []
            
        # Ensure chat_entries is a list before appending
        if not isinstance(self.chat_entries, list):
            print(f"DEBUG: Converting chat_entries from {type(self.chat_entries)} to list in add_user_message")
            self.chat_entries = [str(self.chat_entries)]
            
        self.chat_entries.append(chat_entry)
        print("DEBUG: Updated chat_entries with user message, refreshing display")
        # Force refresh of the chat display
        self._update_chat_display()
    
    def add_assistant_message(self, message):
        """Add an assistant message to the chat history"""
        print(f"DEBUG: add_assistant_message called with message length: {len(message)}")
        timestamp = datetime.now().strftime("%H:%M")
        chat_entry = f"<b>[{timestamp}] Axis 5:</b> {message}"
        print(f"DEBUG: Adding entry to chat_entries, length: {len(chat_entry)}")
        
        # Initialize chat_entries as a list if it doesn't exist
        if not hasattr(self, 'chat_entries') or self.chat_entries is None:
            print("DEBUG: Initializing chat_entries as a list")
            self.chat_entries = []
            
        # Ensure chat_entries is a list before appending
        if not isinstance(self.chat_entries, list):
            print(f"DEBUG: Converting chat_entries from {type(self.chat_entries)} to list")
            self.chat_entries = [str(self.chat_entries)]
            
        self.chat_entries.append(chat_entry)
        print("DEBUG: Updated chat_entries, refreshing display")
        # Force refresh of the chat display
        self._update_chat_display()
        
    def _update_chat_display(self):
        """Update the chat display with the current chat history"""
        print("DEBUG: _update_chat_display called")
        
        try:
            # Check if chat_entries attribute exists and is a list
            if not hasattr(self, 'chat_entries'):
                print("DEBUG: Initializing chat_entries as a list")
                self.chat_entries = []
            
            # Ensure chat_entries is a list
            if not isinstance(self.chat_entries, list):
                print(f"DEBUG: Converting chat_entries from {type(self.chat_entries)} to list")
                self.chat_entries = [str(self.chat_entries)]
            
            # Check if chat_history attribute exists and is a QTextEdit widget
            if hasattr(self, 'chat_history') and isinstance(self.chat_history, QtWidgets.QTextEdit):
                print("DEBUG: chat_history is a QTextEdit widget")
                print(f"DEBUG: Found {len(self.chat_entries)} chat entries")
                
                # Join all entries with proper HTML line breaks
                html_content = "<html><body>"
                for entry in self.chat_entries:
                    html_content += entry + "<br><br>"
                html_content += "</body></html>"
                
                # Set the HTML content to the widget
                print(f"DEBUG: Setting HTML content of length {len(html_content)}")
                self.chat_history.setHtml(html_content)
                print("DEBUG: Updated chat_history widget with HTML content")
                
                # Scroll to bottom
                scrollbar = self.chat_history.verticalScrollBar()
                scrollbar.setValue(scrollbar.maximum())
                print("DEBUG: Scrolled to bottom of chat_history")
            else:
                print("DEBUG: chat_history is not a QTextEdit widget, outputting to console instead")
                print("\n=== CHAT HISTORY ===\n")
                for entry in self.chat_entries:
                    # Strip HTML tags for console output
                    plain_text = re.sub('<[^<]+?>', '', entry)
                    print(plain_text)
                print("\n=== END CHAT HISTORY ===\n")
        except Exception as e:
            print(f"ERROR: Failed to update chat display: {str(e)}")
            traceback.print_exc()
            
    def on_clear_clicked(self):
        """Handle clear button click"""
        self.chat_history.clear()
        self.add_system_message("Chat history cleared.")

    def add_manufacturing_features_ui(self, layout):
        """Add cloud manufacturing features UI elements"""
        # Create group box for manufacturing features
        mfg_group = QtWidgets.QGroupBox("Cloud Manufacturing Features")
        mfg_layout = QtWidgets.QVBoxLayout()
        
    def on_analyze_clicked(self):
        """Handle analyze button click - now runs full DFM analysis with professional overlays"""
        self.add_system_message("Running DFM analysis with professional overlays...")
        try:
            # Check if there's an active document
            if FreeCAD.ActiveDocument:
                doc_name = FreeCAD.ActiveDocument.Name
                objects = FreeCAD.ActiveDocument.Objects
                object_count = len(objects)
                
                if object_count == 0:
                    self.add_system_message("No objects found to analyze")
                    self.add_assistant_message("Please create or import a CAD object first, then click Analyze to see DFM overlays with tooltips.")
                    return
                
                # Run full DFM analysis with professional overlays
                self.add_assistant_message(f"🔍 Analyzing {object_count} objects in '{doc_name}' for manufacturing issues...")
                
                # Run DFM analysis using the manufacturing feature manager
                result = self.mfg_feature_manager.analyze_dfm(
                    manufacturing_process="3d_printing",  # Default process
                    material="pla",                       # Default material
                    production_volume=1,                  # Default volume
                    advanced_analysis=True                # Enable advanced analysis
                )
                
                if result and result.get('success'):
                    data = result.get('data', {})
                    issues = data.get('issues', [])
                    score = data.get('manufacturability_score', 0)
                    
                    self.add_assistant_message(f"[OK] DFM Analysis Complete!\n\n"
                                             f"📊 Manufacturability Score: {score}/100\n"
                                             f"🔍 Found {len(issues)} manufacturing issues\n\n"
                                             f"🎯 **Professional overlays with tooltips are now active!**\n"
                                             f"• **Hover** over colored areas to see issue details\n"
                                             f"• **Click** on overlays to pin/unpin tooltips\n"
                                             f"• Overlays automatically follow object movements")
                    
                    if issues:
                        issues_text = "\n".join([f"• {issue.get('title', 'Issue')}: {issue.get('description', 'No description')}" 
                                               for issue in issues[:5]])  # Show first 5 issues
                        if len(issues) > 5:
                            issues_text += f"\n... and {len(issues) - 5} more issues (see overlays)"
                        self.add_assistant_message(f"🚨 **Manufacturing Issues Found:**\n{issues_text}")
                else:
                    # Fallback to basic analysis if DFM fails
                    analysis_text = f"Active document: {doc_name} with {object_count} objects\n"
                    for obj in objects:
                        if hasattr(obj, 'Shape'):
                            volume = obj.Shape.Volume
                            bbox = obj.Shape.BoundBox
                            dimensions = f"{bbox.XLength:.1f}x{bbox.YLength:.1f}x{bbox.ZLength:.1f}"
                            analysis_text += f"- {obj.Label}: {obj.TypeId}, Volume: {volume:.1f} mm³, Size: {dimensions} mm\n"
                        else:
                            analysis_text += f"- {obj.Label}: {obj.TypeId}\n"
                    
                    self.add_assistant_message(f"Here's my basic analysis:\n\n{analysis_text}\n\n"
                                             f"💡 **Tip:** For DFM overlays with tooltips, ensure you have a mesh or solid object selected.")
            else:
                self.add_system_message("No active document found")
                self.add_assistant_message("There is no active document to analyze. Please create or open a document first.")
        except Exception as e:
            self.add_system_message(f"Error analyzing model: {str(e)}")
            self.add_assistant_message(f"❌ Analysis failed: {str(e)}\n\n"
                                     f"💡 **Quick Test:** Try creating a simple cube first:\n"
                                     f"```python\n"
                                     f"import FreeCAD, Part\n"
                                     f"doc = FreeCAD.newDocument()\n"
                                     f"cube = doc.addObject('Part::Box', 'TestCube')\n"
                                     f"cube.Length = 20\n"
                                     f"cube.Width = 15\n"
                                     f"cube.Height = 10\n"
                                     f"doc.recompute()\n"
                                     f"```\n"
                                     f"Then click Analyze again!")
            traceback.print_exc()
    
