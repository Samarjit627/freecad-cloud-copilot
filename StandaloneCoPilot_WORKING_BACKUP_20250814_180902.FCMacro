# Environment variable loading for Claude
def load_anthropic_api_key():
    """Load Anthropic API key from environment or .env file"""
    # Try environment variable first
    api_key = os.environ.get('ANTHROPIC_API_KEY')
    if api_key:
        return api_key
    
    # Try .env file
    try:
        env_file = os.path.join(_THIS_DIR, '.env')
        if os.path.exists(env_file):
            with open(env_file, 'r') as f:
                for line in f:
                    if line.startswith('ANTHROPIC_API_KEY='):
                        return line.split('=', 1)[1].strip().strip('"\'')
    except Exception as e:
        print(f"Warning: Could not load .env file: {e}")
    
    return None

# ========== PROFESSIONAL DFM OVERLAY/TOOLTIP SYSTEM ==========
# Professional DFM overlay system with per-issue mesh overlays and 3D view tooltips

# ---------- STYLE ----------
SEVERITY_STYLE = {
    "critical": {"color": (1.0, 0.0, 0.0),   "transparency": 35},  # #FF0000
    "high":     {"color": (1.0, 0.302, 0.0), "transparency": 35},  # #FF4D00
    "medium":   {"color": (1.0, 0.702, 0.0), "transparency": 30},  # #FFB300
    "low":      {"color": (0.0, 0.5, 1.0),   "transparency": 30},  # #0080FF
}
OVERLAY_PART_PREFIX = "DFM_OVERLAYS_FOR_"   # container that inherits transforms
ISSUE_PREFIX        = "DFM_Issue_"          # each issue is its own object
FACET_TEMP_SUFFIX   = "_FacetColor"

# Registries / globals
_DFM_BASES = set()
_DFM_OBSERVER = None
_DFM_TOOLTIP = None

# ---------- GEOM HELPERS ----------
def V(t): return FreeCAD.Vector(float(t[0]), float(t[1]), float(t[2]))

def get_mesh_from_object(obj, lin_def=0.1, ang_def=0.5):
    # Mesh::Feature → copy; Part::Feature (STEP) → tessellate
    if hasattr(obj, "Mesh"):
        return obj.Mesh.copy()
    if hasattr(obj, "Shape"):
        return MeshPart.meshFromShape(Shape=obj.Shape,
                                      LinearDeflection=float(lin_def),
                                      AngularDeflection=float(ang_def))
    raise ValueError(f"Object {obj.Name} is not meshable.")

def build_centers_and_tris(mesh):
    centers, tris = [], []
    for f in mesh.Facets:
        p1, p2, p3 = f.Points
        a, b, c = V(p1), V(p2), V(p3)
        centers.append(FreeCAD.Vector((a.x+b.x+c.x)/3.0, (a.y+b.y+c.y)/3.0, (a.z+b.z+c.z)/3.0))
        tris.append((a,b,c))
    return centers, tris

def nearest_face_index(p, centers):
    best_i, best_d2 = -1, inf
    for i, c in enumerate(centers):
        d2 = (c - p).Length ** 2
        if d2 < best_d2:
            best_i, best_d2 = i, d2
    return best_i

def project_point_to_triangle(p, a, b, c):
    ab, ac = b-a, c-a
    n = ab.cross(ac)
    nn = n.dot(n)
    if nn == 0:
        return min((a,b,c), key=lambda q: (q-p).Length)
    proj = p - n * ((p - a).dot(n) / nn)
    v0, v1, v2 = ab, ac, proj - a
    d00, d01, d11 = v0.dot(v0), v0.dot(v1), v1.dot(v1)
    d20, d21 = v2.dot(v0), v2.dot(v1)
    denom = d00*d11 - d01*d01
    if denom == 0:
        return min((a,b,c), key=lambda q: (q-p).Length)
    v = (d11*d20 - d01*d21) / denom
    w = (d00*d21 - d01*d20) / denom
    u = 1.0 - v - w
    u = max(0.0, min(1.0, u))
    v = max(0.0, min(1.0, v))
    if u + v > 1.0:
        s = u + v
        u, v = u/s, v/s
    w = 1.0 - u - v
    return a*u + b*v + c*w

def faces_within_radius(point, centers, r_mm):
    r2 = r_mm * r_mm
    return [i for i, c in enumerate(centers) if (c - point).Length**2 <= r2]

# ---------- CONTAINERS / TRANSFORMS ----------
def _overlay_part_name(base_name): return OVERLAY_PART_PREFIX + base_name

def _ensure_overlay_part(base_obj):
    doc = FreeCAD.ActiveDocument
    name = _overlay_part_name(base_obj.Name)
    part = doc.getObject(name)
    if not part:
        part = doc.addObject("App::Part", name)
    part.Placement = base_obj.Placement
    return part

def _clear_overlays_for(base_obj):
    doc = FreeCAD.ActiveDocument
    part = doc.getObject(_overlay_part_name(base_obj.Name))
    if part:
        for ch in list(part.Group):
            doc.removeObject(ch.Name)
        doc.removeObject(part.Name)
        doc.recompute()
    _DFM_BASES.discard(base_obj.Name)

def sync_overlay_part_to_base(base_obj_name):
    doc = FreeCAD.ActiveDocument
    base = doc.getObject(base_obj_name)
    if not base: return
    part = doc.getObject(_overlay_part_name(base_obj_name))
    if not part: return
    part.Placement = base.Placement

# ---------- PER-ISSUE OVERLAY BUILDER (Method 2) ----------
def _build_issue_overlay(mesh, face_indices, issue_idx, base_obj, severity, tooltip_text):
    if not face_indices:
        return None
    new_mesh = Mesh.Mesh()
    for idx in face_indices:
        facet = mesh.Facets[int(idx)]
        p1, p2, p3 = facet.Points
        new_mesh.addFacet(V(p1), V(p2), V(p3))

    doc = FreeCAD.ActiveDocument
    name = f"{ISSUE_PREFIX}{issue_idx:03d}"
    obj = doc.addObject("Mesh::Feature", name)
    obj.Mesh = new_mesh

    # Attach metadata for tooltip
    if not hasattr(obj, "addProperty"):
        return obj
    if "IssueTooltip" not in obj.PropertiesList:
        obj.addProperty("App::PropertyString", "IssueTooltip", "DFM", "Tooltip text for this DFM issue.")
    if "IssueSeverity" not in obj.PropertiesList:
        obj.addProperty("App::PropertyString", "IssueSeverity", "DFM", "Severity bucket.")
    obj.IssueTooltip = tooltip_text
    obj.IssueSeverity = severity

    # Style
    style = SEVERITY_STYLE.get(severity, SEVERITY_STYLE["medium"])
    vo = obj.ViewObject
    vo.ShapeColor = style["color"]
    vo.Transparency = int(style["transparency"])
    vo.DisplayMode = "Shaded"
    vo.Lighting = "One side"

    # Parent under overlay part so transforms follow the base
    part = _ensure_overlay_part(base_obj)
    part.addObject(obj)
    obj.Placement = FreeCAD.Placement()  # identity; inherit from part

    return obj

def dfm_visualize_per_issue(obj_name, issues, radius_mm=3.0, clear=True, lin_def=0.1, ang_def=0.5):
    """
    One overlay object per issue. Each gets IssueTooltip and IssueSeverity properties.
    """
    doc = FreeCAD.ActiveDocument
    base = doc.getObject(obj_name)
    if not base:
        raise ValueError(f"Base object '{obj_name}' not found.")

    if clear:
        _clear_overlays_for(base)

    mesh = get_mesh_from_object(base, lin_def, ang_def)
    centers, tris = build_centers_and_tris(mesh)

    created = []
    for k, it in enumerate(issues, start=1):
        pos = it.get("position")
        if not pos or len(pos) != 3:
            continue

        p = FreeCAD.Vector(float(pos[0]), float(pos[1]), float(pos[2]))
        fi = nearest_face_index(p, centers)
        if fi < 0: 
            continue
        a, b, c = tris[fi]
        p_proj = project_point_to_triangle(p, a, b, c)
        face_ids = faces_within_radius(p_proj, centers, radius_mm) or [fi]

        sev = (it.get("severity") or "medium").strip().lower()
        if sev not in SEVERITY_STYLE:
            sev = "medium"

        # Text for tooltip – choose the exact message you pass in
        tooltip_text = it.get("tooltip") or it.get("title") or "DFM Issue"
        if it.get("description"):
            tooltip_text = f"{tooltip_text}: {it['description']}"

        obj = _build_issue_overlay(mesh, face_ids, k, base, sev, tooltip_text)
        if obj:
            created.append(obj)

    sync_overlay_part_to_base(base.Name)
    _DFM_BASES.add(base.Name)
    FreeCAD.ActiveDocument.recompute()
    return created

# ---------- 3D-VIEW TOOLTIP CONTROLLER ----------
class _DfmTooltipController(QtWidgets.QLabel):
    """
    Shows a styled tooltip on top of the 3D view when hovering a DFM_Issue_* object.
    Click pins/unpins the tooltip.
    """
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowFlags(QtCore.Qt.ToolTip)
        self.setAttribute(QtCore.Qt.WA_TransparentForMouseEvents, False)
        self.setStyleSheet("""
            QLabel {
                background: rgba(30,30,30,220);
                color: #fff;
                border: 1px solid rgba(255,255,255,60);
                border-radius: 6px;
                padding: 6px 8px;
                font-size: 11pt;
            }
        """)
        self._pinned = False
        self.hide()

    def show_text(self, text, global_pos):
        self.setText(text)
        self.adjustSize()
        self.move(global_pos + QtCore.QPoint(12, 16))
        if not self._pinned:
            self.show()

    def pin_toggle(self):
        if self.isVisible():
            self._pinned = not self._pinned
            # Slight visual cue on pin
            if self._pinned:
                self.setStyleSheet(self.styleSheet() + "QLabel { border: 2px solid #4da3ff; }")
            else:
                self.setStyleSheet(self.styleSheet().replace("border: 2px solid #4da3ff;", "border: 1px solid rgba(255,255,255,60);"))

    def hide_if_unpinned(self):
        if not self._pinned:
            self.hide()

class _DfmDocObserver(object):
    """
    Auto-sync overlay part Placement with its base when base moves.
    Also wires up a hover/click handler that shows the tooltip.
    """
    def __init__(self):
        self._handler_installed = False
        self._view = FreeCADGui.ActiveDocument.ActiveView

        # Qt overlay tooltip widget
        global _DFM_TOOLTIP
        if _DFM_TOOLTIP is None:
            try:
                # Try to parent it to the 3D view widget so it stays on top
                parent_widget = self._view.getWidget()
                _DFM_TOOLTIP = _DfmTooltipController(parent=parent_widget)
            except Exception as e:
                FreeCAD.Console.PrintWarning(f"[DFM] Could not get 3D view widget: {e}, using no parent\n")
                # Fallback: create tooltip without parent
                _DFM_TOOLTIP = _DfmTooltipController(parent=None)

        # Install event callback once
        if not self._handler_installed:
            try:
                self._view.addEventCallback("SoEvent", self._on_event)
                self._handler_installed = True
            except Exception as e:
                FreeCAD.Console.PrintWarning(f"[DFM] Could not install event callback: {e}\n")

    def slotChangedObject(self, obj, prop):
        try:
            if prop == "Placement" and obj is not None and obj.Name in _DFM_BASES:
                part = FreeCAD.ActiveDocument.getObject(_overlay_part_name(obj.Name))
                if part:
                    part.Placement = obj.Placement
        except Exception as e:
            FreeCAD.Console.PrintError(f"[DFM] Observer error: {e}\n")

    def slotDeletedObject(self, obj):
        try:
            if obj is None: return
            name = getattr(obj, "Name", None)
            if not name: return
            if name in _DFM_BASES:
                part = FreeCAD.ActiveDocument.getObject(_overlay_part_name(name))
                if part:
                    for ch in list(part.Group):
                        FreeCAD.ActiveDocument.removeObject(ch.Name)
                    FreeCAD.ActiveDocument.removeObject(part.Name)
                _DFM_BASES.discard(name)
        except Exception as e:
            FreeCAD.Console.PrintError(f"[DFM] Observer delete error: {e}\n")

    def _on_event(self, info):
        """
        Hover: show IssueTooltip in 3D view when cursor is over a DFM_Issue_* object.
        Left click: pin/unpin tooltip.
        """
        try:
            etype = info.get("Type", "")
            pos = info.get("Position")  # Qt coords relative to view
            if pos is None:
                return

            # Click toggles pin when tooltip is visible/overlays
            if etype == "BUTTONDOWN" and info.get("Button") == "BUTTON1":
                if _DFM_TOOLTIP:
                    _DFM_TOOLTIP.pin_toggle()
                return

            # Mouse move → hit test
            if etype == "MOUSEMOVE":
                view = self._view
                hit = view.getObjectInfo(pos)
                # getObjectInfo returns dict with "Object", "Component", etc. when hitting a shape/mesh
                if hit and isinstance(hit, dict):
                    obj_name = hit.get("Object")
                    if obj_name and obj_name.startswith(ISSUE_PREFIX):
                        obj = FreeCAD.ActiveDocument.getObject(obj_name)
                        if obj and hasattr(obj, "IssueTooltip"):
                            # Translate view coords to global screen coords for widget placement
                            g = view.getWidget().mapToGlobal(QtCore.QPoint(pos[0], pos[1]))
                            _DFM_TOOLTIP.show_text(obj.IssueTooltip, g)
                            return
                # If not over an issue overlay, hide if not pinned
                if _DFM_TOOLTIP:
                    _DFM_TOOLTIP.hide_if_unpinned()
        except Exception as e:
            FreeCAD.Console.PrintError(f"[DFM] Hover handler error: {e}\n")

def enable_auto_sync_and_tooltips():
    global _DFM_OBSERVER
    if _DFM_OBSERVER is None:
        try:
            _DFM_OBSERVER = _DfmDocObserver()
            FreeCAD.addDocumentObserver(_DFM_OBSERVER)
            FreeCAD.Console.PrintMessage("[DFM] Auto-sync + 3D tooltips enabled.\n")
        except Exception as e:
            FreeCAD.Console.PrintWarning(f"[DFM] Could not enable full tooltip system: {e}\n")
            FreeCAD.Console.PrintMessage("[DFM] Using fallback selection-based tooltips.\n")

def disable_auto_sync_and_tooltips():
    global _DFM_OBSERVER
    try:
        if _DFM_OBSERVER is not None:
            view = FreeCADGui.ActiveDocument.ActiveView
            view.removeEventCallback("SoEvent", _DFM_OBSERVER._on_event)
            FreeCAD.removeDocumentObserver(_DFM_OBSERVER)
    except Exception:
        pass
    _DFM_OBSERVER = None
    FreeCAD.Console.PrintMessage("[DFM] Auto-sync + 3D tooltips disabled.\n")

# ---------- PUBLIC API ----------
def dfm_draw_per_issue_overlays(obj_name, issues, radius_mm=3.0, clear=True,
                                lin_def=0.1, ang_def=0.5):
    """
    Main entry: builds ONE overlay per issue (surface-aligned triangles),
    assigns per-issue tooltip text, and enables hover tooltips.
    """
    out = dfm_visualize_per_issue(obj_name, issues, radius_mm, clear, lin_def, ang_def)
    enable_auto_sync_and_tooltips()
    return out

def dfm_toggle_overlays(obj_name, visible=True):
    part = FreeCAD.ActiveDocument.getObject(OVERLAY_PART_PREFIX + obj_name)
    if not part:
        FreeCAD.Console.PrintMessage("[DFM] No overlays to toggle.\n")
        return
    part.ViewObject.Visibility = bool(visible)
    for ch in part.Group:
        ch.ViewObject.Visibility = bool(visible)

