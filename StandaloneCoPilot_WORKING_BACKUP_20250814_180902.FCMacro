    def compare_manufacturing_methods(self, materials=None, processes=None, quantities=None):
        """Compare costs across different manufacturing methods"""
        try:
            if materials is None:
                materials = ["pla", "abs", "nylon"]
            if processes is None:
                processes = ["3d_printing", "cnc_machining", "injection_molding"]
            if quantities is None:
                quantities = [1, 10, 100, 1000]
                
            # Use cloud integration if available
            if self.cloud_integration:
                return self.cloud_integration.compare_manufacturing_methods(
                    materials=materials,
                    processes=processes,
                    quantities=quantities
                )
            # Otherwise use cloud functions if available
            elif _CLOUD_FUNCTIONS_AVAILABLE:
                return compare_manufacturing_methods(
                    materials=materials,
                    processes=processes,
                    quantities=quantities
                )
            # Fall back to direct API call
            else:
                payload = {
                    "materials": materials,
                    "processes": processes,
                    "quantities": quantities,
                    "cad_data": extract_cad_data_for_features()
                }
                return call_feature("manufacturing_comparison", payload)
        except Exception as e:
            print(f"Error in manufacturing comparison: {str(e)}")
            traceback.print_exc()
            return {
                "success": False,
                "error": str(e),
                "service": "manufacturing_comparison",
                "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S")
            }
    
    def visualize_dfm_issues(self):
        """Visualize DFM issues in the FreeCAD view using enhanced visualization"""
        try:
            # BYPASS the problematic cloud_integration method and use direct visualization
            # The cloud_integration.visualize_dfm_issues() has a get_dfm_issues() call that returns wrong cached data
            print("DEBUG: Using direct visualization to bypass cloud_integration issues")
            
            if self.last_dfm_result and self.last_dfm_result.get("success", False):
                # Basic visualization if cloud integration not available
                data = self.last_dfm_result.get("data", {})
                
                # Try to get issues from multiple sources (Claude-detected manufacturing_issues first)
                issues = data.get("manufacturing_issues", [])
                if not issues:
                    # Fallback to design_issues if manufacturing_issues not available
                    issues = data.get("design_issues", [])
                if not issues:
                    # Final fallback to legacy issues format
                    issues = data.get("issues", [])
                
                print(f"DEBUG: Found {len(issues)} issues to visualize")
                if issues:
                    print(f"DEBUG: First issue: {issues[0]}")
                
                if not issues:
                    print("No DFM issues to visualize")
                    return False
                
                # Get active document and preserve it
                doc = FreeCAD.ActiveDocument
                if not doc:
                    print("No active document")
                    return
                
                # Store the current document name to prevent switching
                current_doc_name = doc.Name
                print(f"DEBUG: Visualizing on document: {current_doc_name}")
                
                # Remove any existing DFM visualization
                self._remove_existing_dfm_visualization(doc)
                    
                # Create a group for DFM issues
                dfm_group = doc.addObject("App::DocumentObjectGroup", "DFM_Issues")
                
                # ROBUST DFM OVERLAY SYSTEM: Professional surface-aligned highlighting
                print(f"DEBUG: Creating robust DFM overlays for {len(issues)} issues...")
                
                # Use the professional DFM visualization system
                try:
                    # Find the mesh/CAD object to highlight
                    target_obj = None
                    for obj in doc.Objects:
                        if hasattr(obj, 'Mesh') or hasattr(obj, 'Shape'):
                            target_obj = obj
                            break
                    
                    if target_obj:
                        print(f"DEBUG: Found target object: {target_obj.Name}")
                        # Use the robust DFM visualization system
                        created_overlays = self._dfm_visualize(target_obj.Name, issues, method="overlay", radius_mm=3.0)
                        print(f"DEBUG: Created {len(created_overlays) if created_overlays else 0} professional DFM overlays")
                    else:
                        print("DEBUG: No suitable mesh or CAD object found for overlay visualization")
                        
                except Exception as overlay_error:
                    print(f"DEBUG: Professional overlay system failed: {overlay_error}")
                    print("DEBUG: Falling back to chat-only DFM analysis")
                
                # NOTE: Arrow visualization logic preserved for future use if needed
                # Can be re-enabled by calling self._create_arrow_visualization_BACKUP()
                
                # Recompute document and refresh view to ensure visibility
                doc.recompute()
                
                # Force view refresh to make rectangles visible
                try:
                    import FreeCADGui
                    if hasattr(FreeCADGui, 'ActiveDocument') and FreeCADGui.ActiveDocument:
                        FreeCADGui.ActiveDocument.ActiveView.fitAll()
                        FreeCADGui.updateGui()
                    print(f"DEBUG: Document recomputed and view refreshed - {len(issues)} DFM rectangles should now be visible")
                except Exception as e:
                    print(f"DEBUG: View refresh failed: {e}")
                
                # Activate DFM selection observer for tooltip functionality
                try:
                    import FreeCADGui
                    if hasattr(FreeCADGui, 'Selection'):
                        # Remove any existing DFM observer
                        try:
                            if hasattr(self, 'dfm_observer'):
                                FreeCADGui.Selection.removeObserver(self.dfm_observer)
                        except:
                            pass
                        
                        # Create and add new DFM observer with task panel access
                        # Find the task panel instance for tooltip display
                        task_panel = None
                        try:
                            # Look for the active StandaloneCoPilotTaskPanel instance
                            import FreeCADGui
                            if hasattr(FreeCADGui, 'Control') and hasattr(FreeCADGui.Control, 'activeDialog'):
                                active_dialog = FreeCADGui.Control.activeDialog()
                                if hasattr(active_dialog, 'add_system_message'):
                                    task_panel = active_dialog
                        except:
                            pass
                        
                        self.dfm_observer = DFMSelectionObserver(task_panel=task_panel)
                        FreeCADGui.Selection.addObserver(self.dfm_observer)
                        print("DEBUG: DFM selection observer activated for tooltip functionality with chat interface")
                        
                        # Populate tooltip information for the rectangles
                        # Use same naming format as professional overlay system (3-digit format)
                        tooltip_info = {}
                        for i, issue in enumerate(issues):
                            rect_name = f"DFM_Issue_{i+1:03d}"  # Match professional overlay naming: DFM_Issue_001, etc.
                            tooltip_text = issue.get('title', 'Manufacturing Issue')
                            description = issue.get('description', 'Manufacturing issue detected')
                            tooltip_info[rect_name] = f"{tooltip_text}: {description}"
                        
                        # Update the observer with tooltip information
                        self.dfm_observer.update_highlights(tooltip_info)
                        print(f"DEBUG: Updated DFM observer with {len(tooltip_info)} tooltip entries")
                except Exception as e:
                    print(f"DEBUG: Failed to activate DFM selection observer: {e}")
                
                # CRITICAL: Ensure we stay on the original document
                try:
                    target_doc = FreeCAD.getDocument(current_doc_name)
                    if target_doc and FreeCAD.ActiveDocument != target_doc:
                        print(f"DEBUG: Switching back to original document: {current_doc_name}")
                        FreeCAD.setActiveDocument(current_doc_name)
                        import FreeCADGui
                        if hasattr(FreeCADGui, 'ActiveDocument'):
                            FreeCADGui.ActiveDocument = FreeCADGui.getDocument(current_doc_name)
                    else:
                        print(f"DEBUG: Already on correct document: {current_doc_name}")
                except Exception as e:
                    print(f"DEBUG: Document preservation failed: {e}")
                
                return True
                    
        except Exception as e:
            print(f"Error visualizing DFM issues: {str(e)}")
            traceback.print_exc()
            return False
    
    def _remove_existing_dfm_visualization(self, doc):
        """Remove any existing DFM visualization objects"""
        try:
            # Find and remove existing DFM issue group
            for obj in doc.Objects:
                if obj.Name == "DFM_Issues" and obj.TypeId == "App::DocumentObjectGroup":
                    doc.removeObject(obj.Name)
                    break
        except Exception as e:
            print(f"Error removing existing DFM visualization: {str(e)}")
    
    def _get_actual_mesh_bounding_box(self, doc):
        """Get the bounding box of mesh objects (like your CAD model)"""
        try:
            # Find mesh objects first (like your uploaded CAD model)
            for obj in doc.Objects:
                if hasattr(obj, "Mesh") and hasattr(obj.ViewObject, "Visibility") and obj.ViewObject.Visibility:
                    bbox = obj.Mesh.BoundBox
                    print(f"DEBUG: Found mesh object '{obj.Label}' with bounding box: ({bbox.XMin:.2f}, {bbox.YMin:.2f}, {bbox.ZMin:.2f}) to ({bbox.XMax:.2f}, {bbox.YMax:.2f}, {bbox.ZMax:.2f})")
                    return (bbox.XMin, bbox.YMin, bbox.ZMin, bbox.XMax, bbox.YMax, bbox.ZMax)
            
            # Fallback to shape objects if no mesh found
            for obj in doc.Objects:
                if hasattr(obj, "Shape") and hasattr(obj.ViewObject, "Visibility") and obj.ViewObject.Visibility:
                    bbox = obj.Shape.BoundBox
                    print(f"DEBUG: Found shape object '{obj.Label}' with bounding box: ({bbox.XMin:.2f}, {bbox.YMin:.2f}, {bbox.ZMin:.2f}) to ({bbox.XMax:.2f}, {bbox.YMax:.2f}, {bbox.ZMax:.2f})")
                    return (bbox.XMin, bbox.YMin, bbox.ZMin, bbox.XMax, bbox.YMax, bbox.ZMax)
            
            print("DEBUG: No mesh or shape objects found, using small default bounding box")
            return (0, 0, 0, 10, 1, 2)  # Small default for your thin part
        except Exception as e:
            print(f"Error getting actual mesh bounding box: {str(e)}")
            return (0, 0, 0, 10, 1, 2)  # Small default for your thin part
    
    def _project_point_to_surface(self, mesh_object, point):
        """
        Project the analysis point to the actual mesh surface using robust mesh intersection.
        This ensures highlights appear ON the geometry, not floating in space.
        """
        try:
            if not hasattr(mesh_object, 'Mesh') or not mesh_object.Mesh:
                print(f"DEBUG: No mesh data available for surface projection")
                return point
                
            mesh_data = mesh_object.Mesh
            fc_point = FreeCAD.Vector(point[0], point[1], point[2])
            
            print(f"DEBUG: Projecting point {point} to mesh surface...")
            
            # METHOD 1: Find nearest point on mesh surface (most reliable)
            try:
                # Use correct FreeCAD mesh API
                nearest_point = mesh_data.nearestPointOnMesh(fc_point)
                if nearest_point and len(nearest_point) >= 3:
                    surface_point = (nearest_point[0], nearest_point[1], nearest_point[2])
                    distance = fc_point.distanceToPoint(FreeCAD.Vector(*surface_point))
                    
                    # Only use if reasonably close (within 50% of model size)
                    bbox = mesh_data.BoundBox
                    max_dimension = max(bbox.XLength, bbox.YLength, bbox.ZLength)
                    if distance < max_dimension * 0.5:
                        print(f"DEBUG: Found nearest surface point {surface_point} (distance: {distance:.2f})")
                        return surface_point
            except Exception as e:
                print(f"DEBUG: Nearest point method failed: {e}")
                
            # METHOD 1B: Alternative nearest point approach
            try:
                # Find closest mesh point by direct distance calculation
                min_distance = float('inf')
                closest_point = None
                
                # Sample mesh points efficiently
                sample_step = max(1, mesh_data.CountPoints // 200)  # Sample up to 200 points
                for i in range(0, mesh_data.CountPoints, sample_step):
                    mesh_point = mesh_data.Points[i]
                    distance = fc_point.distanceToPoint(mesh_point)
                    if distance < min_distance:
                        min_distance = distance
                        closest_point = (mesh_point.x, mesh_point.y, mesh_point.z)
                
                if closest_point and min_distance < float('inf'):
                    print(f"DEBUG: Found closest mesh point {closest_point} (distance: {min_distance:.2f})")
                    return closest_point
                    
            except Exception as e:
                print(f"DEBUG: Alternative nearest point method failed: {e}")
            
            # METHOD 2: Ray casting from multiple strategic directions
            directions_and_origins = [
                # Cast rays from outside the mesh towards the point
                ((point[0], point[1], point[2] + 100), (0, 0, -1)),  # From above
                ((point[0], point[1], point[2] - 100), (0, 0, 1)),   # From below
                ((point[0] + 100, point[1], point[2]), (-1, 0, 0)),  # From right
                ((point[0] - 100, point[1], point[2]), (1, 0, 0)),   # From left
                ((point[0], point[1] + 100, point[2]), (0, -1, 0)),  # From front
                ((point[0], point[1] - 100, point[2]), (0, 1, 0)),   # From back
            ]
            
            closest_distance = float('inf')
            best_surface_point = None
            
            for origin, direction in directions_and_origins:
                try:
                    # Cast ray from outside towards the mesh
                    result = mesh_data.nearestFacetOnRay(origin, direction)
                    if result and len(result) >= 2:
                        intersection_point = result[1]  # Intersection point
                        if len(intersection_point) >= 3:
                            surface_point = (intersection_point[0], intersection_point[1], intersection_point[2])
                            distance = fc_point.distanceToPoint(FreeCAD.Vector(*surface_point))
                            
                            if distance < closest_distance:
                                closest_distance = distance
                                best_surface_point = surface_point
                                print(f"DEBUG: Ray cast hit at {surface_point} (distance: {distance:.2f})")
                except Exception as e:
                    continue
            
            if best_surface_point and closest_distance < float('inf'):
                print(f"DEBUG: Best surface projection: {best_surface_point} (distance: {closest_distance:.2f})")
                return best_surface_point
            
            # METHOD 3: Fallback - find closest mesh point by brute force sampling
            try:
                print(f"DEBUG: Using fallback mesh point sampling...")
                min_distance = float('inf')
                closest_mesh_point = None
                
                # Sample mesh points to find the closest one
                sample_step = max(1, mesh_data.CountPoints // 1000)  # Sample up to 1000 points
                for i in range(0, mesh_data.CountPoints, sample_step):
                    mesh_point = mesh_data.Points[i]
                    distance = fc_point.distanceToPoint(mesh_point)
                    if distance < min_distance:
                        min_distance = distance
                        closest_mesh_point = (mesh_point.x, mesh_point.y, mesh_point.z)
                
                if closest_mesh_point:
                    print(f"DEBUG: Closest mesh point: {closest_mesh_point} (distance: {min_distance:.2f})")
                    return closest_mesh_point
                    
            except Exception as e:
                print(f"DEBUG: Fallback sampling failed: {e}")
            
            # Final fallback: return original point
            print(f"DEBUG: All projection methods failed, using original point {point}")
            return point
            
        except Exception as e:
            print(f"ERROR: Surface projection completely failed: {str(e)}")
            return point

    def _project_point_to_surface_with_normal(self, mesh_object, point):
        """
        Project point to mesh surface and return both surface point and surface normal.
        This enables proper overlay alignment with the mesh geometry.
        """
        try:
            if not hasattr(mesh_object, 'Mesh') or not mesh_object.Mesh:
                print(f"DEBUG: No mesh data for surface normal calculation")
                return point, (0, 0, 1)
                
            mesh_data = mesh_object.Mesh
            fc_point = FreeCAD.Vector(point[0], point[1], point[2])
            
            # Calculate surface point and normal
            try:
                # Use the input point directly as the surface point
                surface_point = point
                fc_surface_point = FreeCAD.Vector(surface_point[0], surface_point[1], surface_point[2])
                print(f"DEBUG: Using input point as surface point: {surface_point}")
            except Exception as surface_calc_error:
                print(f"DEBUG: Error calculating surface point: {surface_calc_error}")
                # Use center of bounding box as fallback
                surface_point = (
                    (mesh_data.BoundBox.XMin + mesh_data.BoundBox.XMax) / 2,
                    (mesh_data.BoundBox.YMin + mesh_data.BoundBox.YMax) / 2,
                    (mesh_data.BoundBox.ZMin + mesh_data.BoundBox.ZMax) / 2
                )
                fc_surface_point = FreeCAD.Vector(surface_point[0], surface_point[1], surface_point[2])
                
            except Exception as surface_calc_error:
                print(f"DEBUG: Error calculating surface point: {surface_calc_error}")
                # Use center of bounding box as fallback
                surface_point = (
                    (mesh_data.BoundBox.XMin + mesh_data.BoundBox.XMax) / 2,
                    (mesh_data.BoundBox.YMin + mesh_data.BoundBox.YMax) / 2,
                    (mesh_data.BoundBox.ZMin + mesh_data.BoundBox.ZMax) / 2
                )
                fc_surface_point = FreeCAD.Vector(surface_point[0], surface_point[1], surface_point[2])
            
            # Find surface normal at the calculated point
            surface_normal = (0, 0, 1)  # Default upward normal
            
            try:
                # Find the closest facet to the surface point
                min_distance = float('inf')
                closest_facet = None
                
                print(f"DEBUG: Searching through {mesh_data.CountFacets} facets for closest to point {fc_surface_point}")
                
                # Sample facets to find the closest one (for performance)
                sample_step = max(1, mesh_data.CountFacets // 100)  # Sample more facets for better accuracy
                facets_checked = 0
                
                for i in range(0, mesh_data.CountFacets, sample_step):
                    try:
                        facet = mesh_data.Facets[i]
                        facets_checked += 1
                        
                        # Get facet vertices - Points are tuples (x,y,z), not Vector objects
                        p1, p2, p3 = facet.Points
                        facet_center = FreeCAD.Vector(
                            (p1[0] + p2[0] + p3[0]) / 3,  # x coordinates
                            (p1[1] + p2[1] + p3[1]) / 3,  # y coordinates
                            (p1[2] + p2[2] + p3[2]) / 3   # z coordinates
                        )
                        distance = fc_surface_point.distanceToPoint(facet_center)
                        
                        if distance < min_distance:
                            min_distance = distance
                            closest_facet = facet
                            
                    except Exception as facet_error:
                        print(f"DEBUG: Error processing facet {i}: {facet_error}")
                        continue
                
                print(f"DEBUG: Checked {facets_checked} facets, min distance: {min_distance:.3f}")
                
                if closest_facet and min_distance < 50.0:  # Only use if reasonably close
                    try:
                        normal = closest_facet.Normal
                        surface_normal = (normal.x, normal.y, normal.z)
                        print(f"DEBUG: Found surface normal: {surface_normal} at facet distance {min_distance:.2f}")
                    except Exception as normal_error:
                        print(f"DEBUG: Error getting facet normal: {normal_error}")
                        surface_normal = (0, 0, 1)
                else:
                    print(f"DEBUG: No suitable facet found (distance: {min_distance:.3f}), using default normal")
                    
            except Exception as e:
                print(f"DEBUG: Surface normal calculation failed: {e}")
            
            return surface_point, surface_normal
            
        except Exception as e:
            print(f"ERROR: Surface projection with normal failed: {str(e)}")
            return point, (0, 0, 1)

    def _get_mesh_object(self, doc):
        """Get the mesh object from the document with improved detection"""
        try:
            mesh_objects = []
            
            # Look for mesh objects with different criteria
            for obj in doc.Objects:
                # Check for Mesh objects (STL, OBJ imports)
                if hasattr(obj, "Mesh") and obj.Mesh and obj.Mesh.CountFacets > 0:
                    mesh_objects.append(obj)
                    print(f"DEBUG: Found mesh object: {obj.Name} ({obj.Mesh.CountFacets} facets)")
                
                # Check for Part objects with Shape (native CAD)
                elif hasattr(obj, "Shape") and obj.Shape and hasattr(obj.Shape, "Faces") and len(obj.Shape.Faces) > 0:
                    # Convert Part to mesh for consistent processing
                    try:
                        import MeshPart
                        mesh_obj = MeshPart.meshFromShape(obj.Shape, LinearDeflection=0.1, AngularDeflection=0.1)
                        if mesh_obj and mesh_obj.CountFacets > 0:
                            # Create a temporary mesh object for processing
                            temp_mesh = doc.addObject("Mesh::Feature", f"TempMesh_{obj.Name}")
                            temp_mesh.Mesh = mesh_obj
                            mesh_objects.append(temp_mesh)
                            print(f"DEBUG: Converted Part object to mesh: {obj.Name} -> {temp_mesh.Name} ({mesh_obj.CountFacets} facets)")
                    except Exception as e:
                        print(f"DEBUG: Could not convert Part {obj.Name} to mesh: {e}")
            
            if mesh_objects:
                # Prefer visible objects
                for obj in mesh_objects:
                    if hasattr(obj, "ViewObject") and hasattr(obj.ViewObject, "Visibility"):
                        if obj.ViewObject.Visibility:
                            print(f"DEBUG: Using visible mesh object: {obj.Name}")
                            return obj
                
                # If no visible objects, use the first one
                print(f"DEBUG: Using first available mesh object: {mesh_objects[0].Name}")
                return mesh_objects[0]
            
            print(f"DEBUG: No mesh objects found in document")
            return None
            
        except Exception as e:
            print(f"ERROR: Failed to get mesh object: {str(e)}")
            return None

    def _create_surface_overlay(self, doc, highlight_name, x, y, z, surface_normal, highlight_color, issue_type):
        """Create a surface-aligned overlay as fallback when face-level highlighting fails"""
        try:
            print(f"DEBUG: Creating surface overlay fallback at ({x:.2f}, {y:.2f}, {z:.2f})")
            
            # Create a highly selectable surface-aligned overlay based on issue type
            if 'thin_wall' in issue_type.lower():
                # Rectangular overlay for wall issues - made much more prominent for selection
                overlay = doc.addObject("Part::Box", highlight_name)
                overlay.Length = 5.0  # 5mm length (much larger for better selection)
                overlay.Width = 5.0   # 5mm width (much larger for better selection)
                overlay.Height = 1.0  # Much thicker (1.0mm) for reliable selection
            else:
                # Disc overlay for other issues - made much more prominent for selection
                overlay = doc.addObject("Part::Cylinder", highlight_name)
                overlay.Radius = 2.5   # 2.5mm radius (much larger for better selection)
                overlay.Height = 1.0   # Much thicker (1.0mm) for reliable selection
            
            # Position with much larger surface normal offset for reliable selection
            normal_x, normal_y, normal_z = surface_normal
            offset_distance = 1.0  # Much larger offset for reliable selection (1.0mm)
            
            overlay_center = FreeCAD.Vector(
                x + (normal_x * offset_distance),
                y + (normal_y * offset_distance), 
                z + (normal_z * offset_distance)
            )
            
            # Calculate rotation to align with surface
            try:
                normal_vector = FreeCAD.Vector(normal_x, normal_y, normal_z)
                up_vector = FreeCAD.Vector(0, 0, 1)
                
                if normal_vector.dot(up_vector) < 0.9:
                    rotation_axis = up_vector.cross(normal_vector)
                    if rotation_axis.Length > 0.01:
                        rotation_axis.normalize()
                        angle = math.acos(max(-1, min(1, up_vector.dot(normal_vector))))
                        surface_rotation = FreeCAD.Rotation(rotation_axis, math.degrees(angle))
                    else:
                        surface_rotation = FreeCAD.Rotation(0, 0, 0)
                else:
                    surface_rotation = FreeCAD.Rotation(0, 0, 0)
            except:
                surface_rotation = FreeCAD.Rotation(0, 0, 0)
            
            # Apply placement and color
            overlay.Placement = FreeCAD.Placement(overlay_center, surface_rotation)
            
            if hasattr(overlay, 'ViewObject'):
                overlay.ViewObject.ShapeColor = highlight_color
                overlay.ViewObject.Transparency = 20  # Less transparent for better visibility and selection
                overlay.ViewObject.Selectable = True  # Ensure the overlay is selectable
                overlay.ViewObject.DisplayMode = "Shaded"  # Use shaded mode for better visibility
                # Make the overlay stand out more for selection
                overlay.ViewObject.LineWidth = 2.0
                overlay.ViewObject.PointSize = 3.0
            
            print(f"DEBUG: Created surface overlay fallback with {highlight_color} color")
            return overlay
            
        except Exception as overlay_error:
            print(f"DEBUG: Surface overlay creation failed: {overlay_error}")
            # Ultimate fallback: simple sphere
            sphere = doc.addObject("Part::Sphere", highlight_name)
            sphere.Radius = 0.3
            sphere.Placement = FreeCAD.Placement(FreeCAD.Vector(x, y, z), FreeCAD.Rotation())
            return sphere

    def _group_nearby_issues(self, issues, model_width):
        """Smart grouping to reduce overlapping rectangles and improve visualization clarity"""
        try:
            # Group issues by type and proximity to reduce overlap
            grouped = []
            used_indices = set()
            
            # Define grouping distance (10% of model width)
            group_distance = model_width * 0.1
            
            for i, issue in enumerate(issues):
                if i in used_indices:
                    continue
                    
                # Start a new group with this issue as primary
                group = {
                    'primary_issue': issue,
                    'issues': [issue],
                    'type': issue.get('type', 'general'),
                    'severity': issue.get('severity', 'medium')
                }
                used_indices.add(i)
                
                # Find nearby issues of the same type to group together
                if 'position' in issue and issue['position']:
                    primary_x, primary_y, primary_z = issue['position']
                    
                    for j, other_issue in enumerate(issues):
                        if j in used_indices or j <= i:
                            continue
                            
                        # Only group issues of the same type
                        if other_issue.get('type', 'general') != group['type']:
                            continue
                            
                        if 'position' in other_issue and other_issue['position']:
                            other_x, other_y, other_z = other_issue['position']
                            
                            # Calculate distance
                            distance = ((primary_x - other_x)**2 + (primary_y - other_y)**2 + (primary_z - other_z)**2)**0.5
                            
                            # Group if within distance threshold
                            if distance < group_distance:
                                group['issues'].append(other_issue)
                                used_indices.add(j)
                                
                                # Update severity to highest in group
                                if other_issue.get('severity') == 'critical' or group['severity'] != 'critical':
                                    if other_issue.get('severity') == 'critical':
                                        group['severity'] = 'critical'
                                    elif other_issue.get('severity') == 'high' and group['severity'] not in ['critical']:
                                        group['severity'] = 'high'
                
                grouped.append(group)
            
            # Further reduce by limiting to most critical issues per type
            final_groups = []
            type_counts = {}
            
            # Sort by severity (critical first)
            severity_order = {'critical': 0, 'high': 1, 'medium': 2, 'low': 3}
            grouped.sort(key=lambda g: (severity_order.get(g['severity'], 4), g['type']))
            
            for group in grouped:
                issue_type = group['type']
                
                # Limit thin_wall issues to 5 most critical
                if issue_type == 'thin_wall':
                    if type_counts.get(issue_type, 0) < 5:
                        final_groups.append(group)
                        type_counts[issue_type] = type_counts.get(issue_type, 0) + 1
                # Keep all other issue types
                else:
                    final_groups.append(group)
            
            return final_groups
            
        except Exception as e:
            print(f"Error in smart grouping: {str(e)}")
            # Fallback: return individual issues as single-item groups
            return [{'primary_issue': issue, 'issues': [issue], 'type': issue.get('type', 'general'), 'severity': issue.get('severity', 'medium')} for issue in issues[:10]]  # Limit to 10
    
    def _analyze_issue_position(self, issue, bbox, doc):
        """Analyze CAD structure to determine accurate position for manufacturing issue"""
        try:
            # Extract issue information
            description = issue.get('description', '').lower()
            title = issue.get('title', '').lower()
            severity = issue.get('severity', 'medium')
            
            # CAD dimensions
            x_min, y_min, z_min, x_max, y_max, z_max = bbox
            width = x_max - x_min
            depth = y_max - y_min
            height = z_max - z_min
            center_x = x_min + width / 2
            center_y = y_min + depth / 2
            center_z = z_min + height / 2
            
            print(f"DEBUG: Analyzing issue: '{title}' - '{description[:50]}...'")
            
            # APPROACH 2: Smart CAD Structure Analysis - FIXED KEYWORD MATCHING
            # Map issue types to likely geometric locations with PRIORITY-BASED classification
            
            # PRIORITY 1: GATE PLACEMENT ISSUES (most specific) - IMPROVED DETECTION
            if any(keyword in description.lower() or keyword in title.lower() for keyword in 
                   ['gate placement', 'gate locations', 'gate positioning', 'limited gate', 'gate options']):
                # Position at base center for gate placement
                x = center_x
                y = center_y
                z = z_min + height * 0.1  # Near bottom for gate issues
                print(f"DEBUG: Gate placement issue - positioned at base center")
                return (x, y, z)
            
            # PRIORITY 1B: FLOW/FILLING ISSUES (different from gate placement)
            elif any(keyword in description.lower() or keyword in title.lower() for keyword in 
                     ['flow', 'filling', 'material flow']):
                # Position at end sections where flow issues occur
                x = x_max - width * 0.2  # Near end of part
                y = center_y
                z = center_z  # Middle height for flow issues
                print(f"DEBUG: Flow/filling issue - positioned at end section")
                return (x, y, z)
            
            # PRIORITY 2A: EJECTION ISSUES (specific positioning) - IMPROVED DETECTION
            elif any(keyword in description.lower() or keyword in title.lower() for keyword in 
                     ['ejection', 'ejector', 'ejector pin', 'insufficient ejection', 'ejection area']):
                # Position on main body surfaces where ejector pins would be
                x = center_x - width * 0.2  # Offset from center for ejector area
                y = center_y
                z = center_z + height * 0.1  # Upper-middle for ejector pins
                print(f"DEBUG: Ejection issue - positioned on ejector surface")
                return (x, y, z)
            
            # PRIORITY 2B: DRAFT ANGLE ISSUES (check before general wall issues)
            elif any(keyword in description or keyword in title for keyword in 
                     ['draft', 'angle', 'vertical']):
                # Position on vertical walls (side areas)
                x = x_min + width * 0.2  # Side wall area
                y = center_y
                z = center_z + height * 0.2  # Upper portion of walls
                print(f"DEBUG: Draft angle issue - positioned on vertical surface")
                return (x, y, z)
            
            # PRIORITY 3: COOLING/RATIO ISSUES (check before thickness issues)
            elif any(keyword in description or keyword in title for keyword in 
                     ['cooling', 'ratio', 'warpage', 'uneven', 'length-to-thickness']):
                # Position on center areas where cooling issues occur
                x = center_x
                y = center_y
                z = z_min + height * 0.3  # Lower-middle for cooling issues
                print(f"DEBUG: Cooling/ratio issue - positioned on center section")
                return (x, y, z)
            
            # PRIORITY 4: THREAD/UNDERCUT ISSUES
            elif any(keyword in description or keyword in title for keyword in 
                     ['thread', 'undercut', 'neck', 'cap', 'screw', 'overhang']):
                # Position at top/neck area where threads typically are
                x = center_x
                y = center_y
                z = z_max - height * 0.15  # Near top for thread issues
                print(f"DEBUG: Thread/undercut issue - positioned at neck/top area")
                return (x, y, z)
            
            # PRIORITY 5: SHARP CORNER ISSUES
            elif any(keyword in description or keyword in title for keyword in 
                     ['sharp', 'corner', 'edge', 'radius', 'fillet']):
                # Position at corner/edge areas
                x = x_min + width * 0.1  # Near corner
                y = y_min + depth * 0.1
                z = center_z
                print(f"DEBUG: Sharp corner issue - positioned at edge/corner")
                return (x, y, z)
            
            # PRIORITY 6: WALL THICKNESS ISSUES - MESH-AWARE POSITIONING
            elif any(keyword in description.lower() or keyword in title.lower() for keyword in 
                     ['wall thickness', 'thin wall', 'thick wall', 'minimum wall', 'extremely thin']):
                # Find the actual thinnest section of the mesh
                thin_pos = self._find_thinnest_mesh_section(doc, bbox)
                if thin_pos:
                    print(f"DEBUG: Wall thickness issue - positioned at actual thin section: {thin_pos}")
                    return thin_pos
                # Fallback to geometric calculation
                x = center_x  # Center for thin wall issues
                y = center_y
                z = center_z  # Middle height for visibility
                print(f"DEBUG: Wall thickness issue - positioned at center (fallback)")
                return (x, y, z)
            
            # PRIORITY 7: SURFACE FINISH ISSUES
            elif any(keyword in description or keyword in title for keyword in 
                     ['surface', 'finish', 'texture', 'smooth', 'rough']):
                # Position on main visible surface
                x = center_x + width * 0.2
                y = center_y + depth * 0.2
                z = center_z + height * 0.1
                print(f"DEBUG: Surface finish issue - positioned on visible surface")
                return (x, y, z)
            
            # PRIORITY 8: STRUCTURAL/STRENGTH ISSUES
            elif any(keyword in description or keyword in title for keyword in 
                     ['strength', 'stress', 'weak', 'break', 'structural', 'support']):
                # Position on potential stress concentration areas
                x = center_x
                y = center_y + depth * 0.3
                z = center_z - height * 0.2  # Lower area for structural issues
                print(f"DEBUG: Structural issue - positioned on stress area")
                return (x, y, z)
            
            # 9. SEVERITY-BASED FALLBACK POSITIONING
            else:
                print(f"DEBUG: Using severity-based fallback positioning")
                if severity == 'critical' or severity == 'high':
                    # Critical issues - position prominently (front-center)
                    x = center_x
                    y = y_max - depth * 0.1  # Front of model
                    z = center_z + height * 0.2
                elif severity == 'medium':
                    # Medium issues - position on side
                    x = x_max - width * 0.1  # Right side
                    y = center_y
                    z = center_z
                else:
                    # Low severity - position at top
                    x = center_x
                    y = center_y
                    z = z_max - height * 0.1  # Top area
                
                return (x, y, z)
                
        except Exception as e:
            print(f"ERROR: Failed to analyze issue position: {str(e)}")
            # Emergency fallback to center
            center_x = bbox[0] + (bbox[3] - bbox[0]) / 2
            center_y = bbox[1] + (bbox[4] - bbox[1]) / 2
            center_z = bbox[2] + (bbox[5] - bbox[2]) / 2
            return (center_x, center_y, center_z)
    
    def _find_thinnest_mesh_section(self, doc, bbox):
        """Find the actual thinnest section of the mesh using FreeCAD's native analysis"""
        try:
            print(f"DEBUG: Starting advanced mesh analysis...")
            
            # Find the mesh object
            mesh_obj = None
            for obj in doc.Objects:
                if hasattr(obj, 'Mesh') and obj.Mesh.CountFacets > 0:
                    mesh_obj = obj
                    break
            
            if not mesh_obj:
                print(f"DEBUG: No mesh object found")
                return None
            
            mesh = mesh_obj.Mesh
            x_min, y_min, z_min, x_max, y_max, z_max = bbox
            width = x_max - x_min
            depth = y_max - y_min
            height = z_max - z_min
            
            print(f"DEBUG: Mesh has {mesh.CountFacets} facets, {mesh.CountPoints} points")
            print(f"DEBUG: Analyzing bounding box: ({x_min:.2f}, {y_min:.2f}, {z_min:.2f}) to ({x_max:.2f}, {y_max:.2f}, {z_max:.2f})")
            
            # COMPREHENSIVE GEOMETRIC ANALYSIS
            all_issues = []
            
            # 1. THIN WALL DETECTION - Cross-sectional analysis
            print(f"DEBUG: Analyzing thin walls...")
            num_samples = 25  # High resolution sampling
            for i in range(num_samples):
                x_sample = x_min + (width * i / (num_samples - 1))
                
                # Find all mesh points near this X coordinate
                nearby_points = []
                tolerance = width * 0.04  # 4% tolerance for precision
                
                for point in mesh.Points:
                    if abs(point.x - x_sample) <= tolerance:
                        nearby_points.append(point)
                
                if len(nearby_points) >= 4:
                    # Calculate local thickness (Y-direction for clamp)
                    y_coords = [p.y for p in nearby_points]
                    z_coords = [p.z for p in nearby_points]
                    
                    local_thickness = max(y_coords) - min(y_coords)
                    
                    # Identify thin sections (< 1.5mm = problematic for injection molding)
                    if local_thickness < 1.5:
                        center_y = (max(y_coords) + min(y_coords)) / 2
                        center_z = (max(z_coords) + min(z_coords)) / 2
                        
                        # More nuanced severity assignment for better color distribution
                        if local_thickness < 0.6:
                            severity = 'critical'  # Red - extremely thin walls
                        elif local_thickness < 1.0:
                            severity = 'high'      # Orange - thin walls
                        elif local_thickness < 1.5:
                            severity = 'medium'    # Yellow - borderline walls
                        else:
                            severity = 'low'       # Blue - acceptable walls
                        
                        all_issues.append({
                            'position': (x_sample, center_y, center_z),
                            'thickness': local_thickness,
                            'type': 'thin_wall',
                            'severity': severity,
                            'description': f'Thin wall: {local_thickness:.2f}mm (min recommended: 1.2mm)'
                        })
                        
                        print(f"DEBUG: Thin wall at X={x_sample:.2f}, thickness={local_thickness:.2f}mm, severity={severity}")
            
            # 2. SHARP CORNER DETECTION - Curvature analysis
            print(f"DEBUG: Analyzing sharp corners...")
            try:
                # Analyze mesh facets for sharp angles
                sharp_corners = []
                for i, facet in enumerate(mesh.Facets):
                    if i % 50 == 0:  # Sample every 50th facet for performance
                        # Get facet normal and adjacent facets
                        normal = facet.Normal
                        
                        # Check for sharp transitions (simplified approach)
                        # In a real implementation, you'd check adjacent facet angles
                        if abs(normal.z) < 0.3:  # Steep angle indicator
                            center = facet.Center
                            # Vary severity based on angle steepness for better color distribution
                            if abs(normal.z) < 0.1:
                                severity = 'critical'  # Red - very sharp corners
                            elif abs(normal.z) < 0.2:
                                severity = 'high'      # Orange - sharp corners
                            else:
                                severity = 'medium'    # Yellow - moderate corners
                            
                            sharp_corners.append({
                                'position': (center.x, center.y, center.z),
                                'type': 'sharp_corner',
                                'severity': severity,
                                'description': f'Sharp corner detected (angle severity: {severity})'
                            })
                
                if sharp_corners:
                    # Take the most prominent sharp corner
                    all_issues.extend(sharp_corners[:2])  # Limit to 2 for clarity
                    print(f"DEBUG: Found {len(sharp_corners)} sharp corners")
                    
            except Exception as e:
                print(f"DEBUG: Sharp corner analysis failed: {e}")
            
            # 3. UNDERCUT DETECTION - Overhang analysis
            print(f"DEBUG: Analyzing undercuts...")
            try:
                undercuts = []
                # Sample Z-levels to find overhangs
                for z_level in [z_min + height * 0.3, z_min + height * 0.7]:
                    points_at_level = [p for p in mesh.Points if abs(p.z - z_level) < height * 0.1]
                    
                    if len(points_at_level) > 10:
                        x_coords = [p.x for p in points_at_level]
                        y_coords = [p.y for p in points_at_level]
                        
                        # Check for overhangs (simplified)
                        x_range = max(x_coords) - min(x_coords)
                        if x_range > width * 0.5:  # Potential overhang
                            center_x_level = (max(x_coords) + min(x_coords)) / 2
                            center_y_level = (max(y_coords) + min(y_coords)) / 2
                            
                            # Vary severity based on overhang extent for better color distribution
                            overhang_ratio = x_range / width
                            if overhang_ratio > 0.9:
                                severity = 'critical'  # Red - severe undercuts
                            elif overhang_ratio > 0.8:
                                severity = 'high'      # Orange - significant undercuts
                            elif overhang_ratio > 0.6:
                                severity = 'medium'    # Yellow - moderate undercuts
                            else:
                                severity = 'low'       # Blue - minor undercuts
                            
                            undercuts.append({
                                'position': (center_x_level, center_y_level, z_level),
                                'type': 'undercut',
                                'severity': severity,
                                'description': f'Undercut/overhang at Z={z_level:.2f}mm (extent: {overhang_ratio:.1%})'
                            })
                
                if undercuts:
                    all_issues.extend(undercuts[:1])  # Limit to 1 for clarity
                    print(f"DEBUG: Found {len(undercuts)} potential undercuts")
                    
            except Exception as e:
                print(f"DEBUG: Undercut analysis failed: {e}")
            
            # 4. ASPECT RATIO ISSUES - Length/width ratio
            print(f"DEBUG: Analyzing aspect ratio...")
            # Calculate center coordinates
            center_x = x_min + width / 2
            center_y = y_min + depth / 2
            center_z = z_min + height / 2
            
            aspect_ratio = width / depth if depth > 0 else 0
            if aspect_ratio > 8 or aspect_ratio < 0.125:  # Very long/thin or very wide/thin
                all_issues.append({
                    'position': (center_x, center_y, center_z),
                    'type': 'aspect_ratio',
                    'severity': 'medium',
                    'description': f'Poor aspect ratio: {aspect_ratio:.1f}:1 (recommended: 2:1 to 4:1)'
                })
                print(f"DEBUG: Poor aspect ratio: {aspect_ratio:.1f}:1")
            
            # 5. DRAFT ANGLE ISSUES - Mold release analysis
            print(f"DEBUG: Analyzing draft angles...")
            try:
                # Simplified draft angle analysis for vertical surfaces
                if height > width * 0.5:  # Tall parts need draft angles
                    all_issues.append({
                        'position': (center_x, center_y, z_min + height * 0.8),  # Top area
                        'type': 'draft_angle',
                        'severity': 'high',
                        'description': 'Vertical surfaces need 1-3° draft angle for mold release'
                    })
                    print(f"DEBUG: Draft angle issue detected for tall part (H:{height:.1f}mm)")
            except Exception as e:
                print(f"DEBUG: Draft angle analysis failed: {e}")
            
            # 6. SINK MARK ANALYSIS - Thick sections
            print(f"DEBUG: Analyzing sink marks...")
            try:
                # Check for thick sections that may cause sink marks
                max_thickness = max([issue.get('thickness', 0) for issue in all_issues if issue.get('type') == 'thin_wall'] + [1.5])
                if max_thickness > 4.0:  # Thick sections > 4mm
                    all_issues.append({
                        'position': (center_x, center_y, center_z),
                        'type': 'sink_mark',
                        'severity': 'medium',
                        'description': f'Thick sections ({max_thickness:.1f}mm) may cause sink marks'
                    })
                    print(f"DEBUG: Sink mark risk detected - thickness: {max_thickness:.1f}mm")
            except Exception as e:
                print(f"DEBUG: Sink mark analysis failed: {e}")
            
            # 7. WARPAGE ANALYSIS - Asymmetric geometry
            print(f"DEBUG: Analyzing warpage risk...")
            try:
                # Check for asymmetric cooling (simplified)
                thickness_variation = len([i for i in all_issues if i.get('type') == 'thin_wall'])
                if thickness_variation > 5:  # Many thickness variations
                    all_issues.append({
                        'position': (center_x, center_y, center_z),
                        'type': 'warpage',
                        'severity': 'medium',
                        'description': f'High thickness variation ({thickness_variation} areas) increases warpage risk'
                    })
                    print(f"DEBUG: Warpage risk detected - {thickness_variation} thickness variations")
            except Exception as e:
                print(f"DEBUG: Warpage analysis failed: {e}")
            
            # 8. FLOW LENGTH ANALYSIS - Material flow distance
            print(f"DEBUG: Analyzing flow length...")
            try:
                flow_length = max(width, depth)  # Longest flow path
                if flow_length > 100:  # Long flow path
                    all_issues.append({
                        'position': (x_min + width * 0.9, center_y, center_z),  # Far end
                        'type': 'flow_length',
                        'severity': 'medium',
                        'description': f'Long flow path ({flow_length:.1f}mm) may cause flow lines'
                    })
                    print(f"DEBUG: Long flow path detected: {flow_length:.1f}mm")
            except Exception as e:
                print(f"DEBUG: Flow length analysis failed: {e}")
            
            # 9. GATE PLACEMENT ANALYSIS - Injection point optimization
            print(f"DEBUG: Analyzing gate placement...")
            try:
                # Recommend gate placement for clamp geometry
                if width > depth * 2:  # Long thin part
                    all_issues.append({
                        'position': (center_x, y_min, center_z),  # Side gate
                        'type': 'gate_placement',
                        'severity': 'low',
                        'description': 'Consider side gate placement for uniform filling'
                    })
                    print(f"DEBUG: Gate placement recommendation for long part")
                
                # Add additional gate placement recommendations with varied severities
                if volume > 50000:  # Large parts need multiple gates
                    all_issues.append({
                        'position': (x_min + width * 0.25, center_y, center_z),
                        'type': 'gate_placement',
                        'severity': 'medium',
                        'description': 'Large part may require multiple gate locations'
                    })
                    all_issues.append({
                        'position': (x_min + width * 0.75, center_y, center_z),
                        'type': 'gate_placement', 
                        'severity': 'low',
                        'description': 'Secondary gate location for balanced filling'
                    })
            except Exception as e:
                print(f"DEBUG: Gate placement analysis failed: {e}")
            
            # 10. SURFACE FINISH ANALYSIS - Add critical surface finish issues
            print(f"DEBUG: Analyzing surface finish requirements...")
            try:
                # Critical surface finish areas (high visibility surfaces)
                all_issues.append({
                    'position': (center_x, y_max, z_max - height * 0.1),  # Top front surface
                    'type': 'surface_finish',
                    'severity': 'critical',
                    'description': 'Critical surface finish area - high visibility'
                })
                
                # High priority surface areas
                all_issues.append({
                    'position': (x_max - width * 0.1, center_y, center_z),  # Side surface
                    'type': 'surface_finish',
                    'severity': 'high',
                    'description': 'High priority surface finish - visible edge'
                })
                
                print(f"DEBUG: Added surface finish analysis points")
            except Exception as e:
                print(f"DEBUG: Surface finish analysis failed: {e}")
            
            # 11. COOLING ANALYSIS - Add cooling-related issues
            print(f"DEBUG: Analyzing cooling requirements...")
            try:
                # Hot spots that need cooling attention
                if volume > 30000:  # Larger parts have cooling challenges
                    all_issues.append({
                        'position': (center_x, center_y, center_z),  # Center mass
                        'type': 'cooling',
                        'severity': 'critical',
                        'description': 'Large mass center requires enhanced cooling'
                    })
                
                # Cooling channel recommendations
                all_issues.append({
                    'position': (center_x, y_min + depth * 0.2, center_z),
                    'type': 'cooling',
                    'severity': 'low',
                    'description': 'Recommended cooling channel location'
                })
                
                print(f"DEBUG: Added cooling analysis points")
            except Exception as e:
                print(f"DEBUG: Cooling analysis failed: {e}")
            
            # Return the most critical issue found
            if all_issues:
                # Sort by severity: critical > high > medium
                severity_order = {'critical': 0, 'high': 1, 'medium': 2}
                all_issues.sort(key=lambda x: severity_order.get(x['severity'], 3))
                
                most_critical = all_issues[0]
                print(f"DEBUG: Most critical issue: {most_critical['type']} - {most_critical['description']}")
                print(f"DEBUG: Total geometric issues found: {len(all_issues)}")
                
                # Store all issues for comprehensive reporting
                self.detected_geometric_issues = all_issues
                
                return most_critical['position']
            
            print(f"DEBUG: No specific geometric issues found")
            return None
            
        except Exception as e:
            print(f"ERROR: Mesh analysis failed: {str(e)}")
            return None
    
    def _perform_comprehensive_geometric_analysis(self):
        """Perform comprehensive geometric analysis and return detected issues"""
        try:
            print("🔍 Starting comprehensive geometric analysis...")
            
            # Get active document
            doc = FreeCAD.ActiveDocument
            if not doc:
                print("No active document for geometric analysis")
                return []
            
            # Find the mesh or solid object
            target_obj = None
            for obj in doc.Objects:
                if hasattr(obj, 'Mesh') and obj.Mesh.CountFacets > 0:
                    target_obj = obj
                    break
                elif hasattr(obj, 'Shape') and obj.Shape.Volume > 0:
                    target_obj = obj
                    break
            
            if not target_obj:
                print("No suitable object found for geometric analysis")
                return []
            
            # Get bounding box
            if hasattr(target_obj, 'Mesh'):
                bbox = target_obj.Mesh.BoundBox
            else:
                bbox = target_obj.Shape.BoundBox
            
            bbox_tuple = (bbox.XMin, bbox.YMin, bbox.ZMin, bbox.XMax, bbox.YMax, bbox.ZMax)
            
            # Use the existing comprehensive analysis logic
            position = self._find_thinnest_mesh_section(doc, bbox_tuple)
            
            # Return the stored geometric issues if available
            if hasattr(self, 'detected_geometric_issues') and self.detected_geometric_issues:
                print(f"🎯 Returning {len(self.detected_geometric_issues)} detected geometric issues")
                return self.detected_geometric_issues
            else:
                print("⚠️ No geometric issues detected by analysis")
                return []
                
        except Exception as e:
            print(f"ERROR: Comprehensive geometric analysis failed: {str(e)}")
            return []
    
    def _create_geometric_dfm_result(self, cloud_result, geometric_issues, manufacturing_process, material, production_volume):
        """Create DFM result with geometric analysis findings"""
        try:
            print(f"🔧 Creating DFM result with {len(geometric_issues)} geometric issues...")
            
            # Start with the cloud result structure
            result = cloud_result.copy() if cloud_result else {}
            data = result.get('data', {})
            
            # Convert geometric issues to DFM format
            dfm_issues = []
            for issue in geometric_issues:
                dfm_issue = {
                    'title': issue.get('type', 'Manufacturing Issue').replace('_', ' ').title(),
                    'description': issue.get('description', 'Geometric issue detected'),
                    'severity': issue.get('severity', 'medium'),
                    'position': issue.get('position', (0, 0, 0)),
                    'type': issue.get('type', 'geometric'),
                    'recommendations': self._get_recommendations_for_issue(issue, manufacturing_process)
                }
                dfm_issues.append(dfm_issue)
            
            # Update the result with geometric findings
            data['design_issues'] = dfm_issues
            data['analysis_method'] = 'Comprehensive Geometric Analysis'
            data['issues_found'] = len(dfm_issues)
            
            # Update manufacturability score based on issues
            critical_issues = len([i for i in dfm_issues if i['severity'] == 'critical'])
            high_issues = len([i for i in dfm_issues if i['severity'] == 'high'])
            medium_issues = len([i for i in dfm_issues if i['severity'] == 'medium'])
            
            # Calculate score (start at 100, deduct for issues)
            score = 100 - (critical_issues * 25) - (high_issues * 15) - (medium_issues * 10)
            score = max(score, 20)  # Minimum score of 20
            
            data['manufacturability_score'] = score
            data['overall_rating'] = 'Excellent' if score >= 90 else 'Good' if score >= 70 else 'Fair' if score >= 50 else 'Poor'
            
            result['data'] = data
            result['success'] = True
            
            print(f"[OK] Created geometric DFM result: {len(dfm_issues)} issues, score: {score}/100")
            return result
            
        except Exception as e:
            print(f"ERROR: Failed to create geometric DFM result: {str(e)}")
            return cloud_result if cloud_result else {'success': False, 'error': str(e)}
    
    def _get_recommendations_for_issue(self, issue, manufacturing_process):
        """Get specific recommendations for each type of geometric issue"""
        issue_type = issue.get('type', '')
        process = manufacturing_process.lower()
        
        recommendations = []
        
        if issue_type == 'thin_wall':
            if 'injection' in process:
                recommendations = [
                    "Increase wall thickness to minimum 1.2mm for injection molding",
                    "Add ribs or gussets for structural support",
                    "Consider material with better flow characteristics"
                ]
            elif 'cnc' in process:
                recommendations = [
                    "Increase thickness to avoid tool deflection",
                    "Use shorter, more rigid cutting tools",
                    "Add support structures during machining"
                ]
        elif issue_type == 'sharp_corner':
            recommendations = [
                "Add fillets with minimum 0.5mm radius",
                "Avoid sharp internal corners for stress concentration",
                "Consider draft angles for molding processes"
            ]
        elif issue_type == 'undercut':
            if 'injection' in process:
                recommendations = [
                    "Eliminate undercuts or add side actions",
                    "Redesign geometry for straight pull molding",
                    "Consider split-line placement"
                ]
        elif issue_type == 'aspect_ratio':
            recommendations = [
                "Optimize length-to-width ratio (2:1 to 4:1)",
                "Add ribs to prevent warpage",
                "Consider material shrinkage compensation"
            ]
        elif issue_type == 'draft_angle':
            recommendations = [
                "Add 1-3° draft angle to vertical surfaces",
                "Use tapered walls for easier mold release",
                "Consider split-line placement to minimize draft requirements"
            ]
        elif issue_type == 'sink_mark':
            recommendations = [
                "Reduce wall thickness in thick sections",
                "Add ribs instead of thick walls for strength",
                "Use uniform wall thickness throughout"
            ]
        elif issue_type == 'warpage':
            recommendations = [
                "Maintain uniform wall thickness",
                "Add ribs for structural support",
                "Consider symmetric cooling design"
            ]
        elif issue_type == 'flow_length':
            recommendations = [
                "Consider multiple gate locations",
                "Optimize part orientation in mold",
                "Use materials with better flow properties"
            ]
        elif issue_type == 'gate_placement':
            recommendations = [
                "Position gate for balanced filling",
                "Avoid gate marks in visible areas",
                "Consider hot runner system for multiple gates"
            ]
        else:
            recommendations = ["Review geometry for manufacturability"]
        
        return recommendations
    
    def _get_model_bounding_box(self, doc):
        """Get the bounding box of all visible objects in the document"""
        try:
            # Find all visible shapes
            shapes = []
            for obj in doc.Objects:
                if hasattr(obj, "Shape") and hasattr(obj.ViewObject, "Visibility") and obj.ViewObject.Visibility:
                    shapes.append(obj.Shape)
            
            if not shapes:
                return (-50, -50, -50, 50, 50, 50)  # Default bounding box
            
            # Calculate combined bounding box
            bbox = shapes[0].BoundBox
            for shape in shapes[1:]:
                bbox.add(shape.BoundBox)
            
            return (bbox.XMin, bbox.YMin, bbox.ZMin, bbox.XMax, bbox.YMax, bbox.ZMax)
        except Exception as e:
            print(f"Error getting model bounding box: {str(e)}")
            return (-50, -50, -50, 50, 50, 50)  # Default bounding box
    
    def _get_model_size(self, doc):
        """Get the approximate size of the model"""
        try:
            bbox = self._get_model_bounding_box(doc)
            size_x = bbox[3] - bbox[0]
            size_y = bbox[4] - bbox[1]
            size_z = bbox[5] - bbox[2]
            return max(size_x, size_y, size_z)
        except Exception as e:
            print(f"Error getting model size: {str(e)}")
            return 100  # Default size
    
    def _create_text_label(self, doc, text, position):
        """Create a text label at the specified position"""
        try:
            # Check if Draft workbench is available
            if hasattr(FreeCAD, "getDraftWorkingPlane"):
                import Draft
                label = Draft.makeText([text], point=position)
                return label
            return None
        except Exception as e:
            print(f"Error creating text label: {str(e)}")
            return None
    
    # ========== ROBUST DFM VISUALIZATION SYSTEM ==========
    
    # DFM Visualization Constants
    SEVERITY_STYLE = {
        "critical": {"color": (1.0, 0.0, 0.0),   "transparency": 35},  # #FF0000
        "high":     {"color": (1.0, 0.302, 0.0), "transparency": 35},  # #FF4D00
        "medium":   {"color": (1.0, 0.702, 0.0), "transparency": 30},  # #FFB300
        "low":      {"color": (0.0, 0.5, 1.0),   "transparency": 30},  # #0080FF
    }
    OVERLAY_PART_PREFIX = "DFM_OVERLAYS_FOR_"
    FACET_TEMP_SUFFIX = "_FacetColor"
    
    # Keep track of bases with overlays for auto-sync observer
    _DFM_BASE_REGISTRY = set()
    _DFM_OBSERVER = None
    
    def _V(self, t):
        """Convert tuple to FreeCAD Vector"""
        return FreeCAD.Vector(float(t[0]), float(t[1]), float(t[2]))
    
    def _get_mesh_from_object(self, obj, lin_def=0.1, ang_def=0.5):
        """Get mesh from Mesh::Feature (STL/OBJ) or Part::Feature (STEP/Solid)"""
        if hasattr(obj, "Mesh"):  # STL/OBJ
            return obj.Mesh.copy()
        elif hasattr(obj, "Shape"):  # STEP or any Part::Feature
            import MeshPart
            return MeshPart.meshFromShape(Shape=obj.Shape,
                                          LinearDeflection=float(lin_def),
                                          AngularDeflection=float(ang_def))
        else:
            raise ValueError(f"Object {obj.Name} is not meshable.")
    
    def _build_centers_and_tris(self, mesh):
        """Build facet centers and triangles from mesh"""
        centers, tris = [], []
        for f in mesh.Facets:
            p1, p2, p3 = f.Points
            a, b, c = self._V(p1), self._V(p2), self._V(p3)
            centers.append(FreeCAD.Vector((a.x+b.x+c.x)/3.0, (a.y+b.y+c.y)/3.0, (a.z+b.z+c.z)/3.0))
            tris.append((a,b,c))
        return centers, tris
    
    def _nearest_face_index(self, p, centers):
        """Find nearest face index to point"""
        best_i, best_d2 = -1, 1e100
        for i,c in enumerate(centers):
            d2 = (c - p).Length ** 2
            if d2 < best_d2:
                best_i, best_d2 = i, d2
        return best_i
    
    def _project_point_to_triangle(self, p, a, b, c):
        """Project point to triangle with barycentric clamping"""
        ab, ac = b-a, c-a
        n = ab.cross(ac)
        nn = n.dot(n)
        if nn == 0:  # degenerate
            return min((a,b,c), key=lambda q: (q-p).Length)
        # orthogonal projection
        proj = p - n * ((p - a).dot(n) / nn)
        # barycentric clamp
        v0, v1, v2 = ab, ac, proj - a
        d00, d01, d11 = v0.dot(v0), v0.dot(v1), v1.dot(v1)
        d20, d21 = v2.dot(v0), v2.dot(v1)
        denom = d00*d11 - d01*d01
        if denom == 0:
            return min((a,b,c), key=lambda q: (q-p).Length)
        v = (d11*d20 - d01*d21) / denom
        w = (d00*d21 - d01*d20) / denom
        u = 1.0 - v - w
        u = max(0.0, min(1.0, u))
        v = max(0.0, min(1.0, v))
        if u+v > 1.0:
            s = u+v
            u, v = u/s, v/s
        w = 1.0 - u - v
        return a*u + b*v + c*w
    
    def _faces_within_radius(self, point, centers, r_mm):
        """Find faces within radius of point"""
        r2 = r_mm*r_mm
        return [i for i,c in enumerate(centers) if (c - point).Length**2 <= r2]
    
    def _overlay_part_name(self, base_obj_name):
        """Generate overlay part name"""
        return self.OVERLAY_PART_PREFIX + base_obj_name
    
    def _ensure_overlay_part(self, base_obj):
        """Create or reuse App::Part for overlays tied to base object"""
        doc = FreeCAD.ActiveDocument
        part_name = self._overlay_part_name(base_obj.Name)
        part = doc.getObject(part_name)
        if not part:
            part = doc.addObject("App::Part", part_name)
        # hard-set placement to base
        part.Placement = base_obj.Placement
        return part
    
    def _clear_overlays_for(self, base_obj):
        """Clear overlays for base object"""
        doc = FreeCAD.ActiveDocument
        part = doc.getObject(self._overlay_part_name(base_obj.Name))
        if part:
            # delete children then the part
            for ch in list(part.Group):
                doc.removeObject(ch.Name)
            doc.removeObject(part.Name)
            doc.recompute()
        # also un-register base if present
        if base_obj.Name in self._DFM_BASE_REGISTRY:
            self._DFM_BASE_REGISTRY.discard(base_obj.Name)
    
    def _build_overlay(self, mesh, indices, name, color, transparency, parent_part):
        """Build overlay mesh from indices"""
        if not indices: 
            return None
        import Mesh
        new_mesh = Mesh.Mesh()
        for idx in indices:
            facet = mesh.Facets[int(idx)]
            p1,p2,p3 = facet.Points
            new_mesh.addFacet(self._V(p1), self._V(p2), self._V(p3))
        obj = FreeCAD.ActiveDocument.addObject("Mesh::Feature", name)
        obj.Mesh = new_mesh
        vo = obj.ViewObject
        vo.ShapeColor = color
        vo.Transparency = int(transparency)
        vo.DisplayMode = "Shaded"
        vo.Lighting = "One side"
        # Put overlay under the overlay App::Part so it inherits transform
        parent_part.addObject(obj)
        obj.Placement = FreeCAD.Placement()  # identity; inherits parent transform
        return obj
    
    def _dfm_visualize(self, obj_name, issues, method="overlay", radius_mm=3.0, clear=True, lin_def=0.1, ang_def=0.5):
        """
        Professional DFM visualization with per-issue overlays and 3D tooltips
        obj_name: FreeCAD tree object name (Mesh::Feature or Part::Feature)
        method: "overlay" (recommended) - uses professional per-issue system
        radius_mm: local patch radius around each issue projection (3.0mm default)
        lin_def / ang_def: tessellation quality for STEP (lower = finer)
        """
        # Use the professional DFM overlay system with per-issue tooltips
        return dfm_draw_per_issue_overlays(obj_name, issues, radius_mm, clear, lin_def, ang_def)
    
    def _method2_overlays(self, base_obj, issues, radius_mm=2.5, clear=True, lin_def=0.1, ang_def=0.5):
        """Method 2: Overlay submeshes (preferred)"""
        from collections import defaultdict
        
        if clear: 
            self._clear_overlays_for(base_obj)
        mesh = self._get_mesh_from_object(base_obj, lin_def, ang_def)
        centers, tris = self._build_centers_and_tris(mesh)

        # Create (or reuse) a transform-carrying container (App::Part)
        part = self._ensure_overlay_part(base_obj)

        buckets = defaultdict(set)
        for it in issues:
            pos = it.get("position")
            if not pos or len(pos)!=3: 
                continue
            p = FreeCAD.Vector(float(pos[0]), float(pos[1]), float(pos[2]))
            i0 = self._nearest_face_index(p, centers)
            if i0 < 0: 
                continue
            a,b,c = tris[i0]
            p_proj = self._project_point_to_triangle(p, a, b, c)
            face_ids = self._faces_within_radius(p_proj, centers, radius_mm) or [i0]
            sev = (it.get("severity") or "medium").lower().strip()
            if sev not in self.SEVERITY_STYLE: 
                sev = "medium"
            buckets[sev].update(face_ids)

        created = []
        for sev, idxs in buckets.items():
            style = self.SEVERITY_STYLE[sev]
            overlay = self._build_overlay(mesh, sorted(idxs),
                                         f"DFM_{sev.upper()}_{base_obj.Name}",
                                         style["color"], style["transparency"],
                                         parent_part=part)
            if overlay: 
                created.append(overlay)

        # Register for auto-sync
        self._DFM_BASE_REGISTRY.add(base_obj.Name)
        FreeCAD.ActiveDocument.recompute()
        return created
    
    def _method1_facet_color(self, base_obj, issues, radius_mm=2.5, lin_def=0.1, ang_def=0.5):
        """Method 1: Facet coloring (fallback)"""
        from collections import defaultdict
        
        mesh = self._get_mesh_from_object(base_obj, lin_def, ang_def)
        centers, tris = self._build_centers_and_tris(mesh)
        n = len(centers)
        diffuse = [(0.8,0.8,0.8)] * n
        per_sev = defaultdict(set)
        
        for it in issues:
            pos = it.get("position")
            if not pos or len(pos)!=3: 
                continue
            p = FreeCAD.Vector(float(pos[0]), float(pos[1]), float(pos[2]))
            i0 = self._nearest_face_index(p, centers)
            if i0 < 0: 
                continue
            a,b,c = tris[i0]
            p_proj = self._project_point_to_triangle(p, a, b, c)
            face_ids = self._faces_within_radius(p_proj, centers, radius_mm) or [i0]
            sev = (it.get("severity") or "medium").lower().strip()
            if sev not in self.SEVERITY_STYLE: 
                sev = "medium"
            per_sev[sev].update(face_ids)

        # paint by severity (critical overwrites)
        order = ["low","medium","high","critical"]
        for sev in order:
            if sev not in per_sev: 
                continue
            color = self.SEVERITY_STYLE[sev]["color"]
            for i in per_sev[sev]:
                diffuse[int(i)] = color

        shown_obj_name = None
        if hasattr(base_obj, "Mesh"):
            base_obj.ViewObject.DiffuseColor = diffuse
            base_obj.ViewObject.DisplayMode = "Shaded"
            base_obj.ViewObject.Lighting = "One side"
            base_obj.ViewObject.Transparency = 0
            shown_obj_name = base_obj.Name
        else:
            # STEP: make a display mesh that follows transforms via an App::Part container
            part = self._ensure_overlay_part(base_obj)
            temp = FreeCAD.ActiveDocument.addObject("Mesh::Feature", f"{base_obj.Name}{self.FACET_TEMP_SUFFIX}")
            temp.Mesh = mesh
            temp.ViewObject.DiffuseColor = diffuse
            temp.ViewObject.DisplayMode = "Shaded"
            temp.ViewObject.Lighting = "One side"
            part.addObject(temp)
            temp.Placement = FreeCAD.Placement()  # identity; inherits
            shown_obj_name = temp.Name

        # Register for auto-sync
        self._DFM_BASE_REGISTRY.add(base_obj.Name)
        FreeCAD.ActiveDocument.recompute()
        return shown_obj_name
    
    def toggle_overlays(self, base_obj_name, visible=True):
        """Toggle overlay visibility using professional DFM overlay system"""
        dfm_toggle_overlays(base_obj_name, visible)
    
    def sync_overlay_part_to_base(self, base_obj_name):
        """Manual sync overlay part to base object using professional DFM overlay system"""
        sync_overlay_part_to_base(base_obj_name)
    
    # ========== END ROBUST DFM VISUALIZATION SYSTEM ==========

    def get_cost_analysis(self):
        """Get detailed cost analysis from the DFM service"""
        try:
            if self.cloud_integration and self.last_dfm_result and self.last_dfm_result.get("success", False):
                return self.cloud_integration.get_cost_analysis()
            return None
        except Exception as e:
            print(f"Error getting cost analysis: {str(e)}")
            return None
    
    def get_alternative_processes(self):
        """Get alternative manufacturing processes from the DFM service"""
        try:
            if self.cloud_integration and self.last_dfm_result and self.last_dfm_result.get("success", False):
                return self.cloud_integration.get_alternative_processes()
            return None
        except Exception as e:
            print(f"Error getting alternative processes: {str(e)}")
            return None
    
    def visualize_tool_paths(self):
        """Visualize tool paths in the FreeCAD view"""
        try:
            if self.cloud_integration:
                self.cloud_integration.visualize_tool_paths()
            elif self.last_tool_result and self.last_tool_result.get("success", False):
                # Basic visualization if cloud integration not available
                tool_paths = self.last_tool_result.get("data", {}).get("tool_paths", [])
                if not tool_paths:
                    FreeCAD.Console.PrintMessage("No tool paths to visualize\n")
                    return
                    
                # Create visualization objects
                doc = FreeCAD.ActiveDocument
                if not doc:
                    FreeCAD.Console.PrintError("No active document for visualization\n")
                    return
                    
                # Create a group for tool paths
                path_group = doc.addObject("App::DocumentObjectGroup", "Tool_Paths")
                
                # Add visualization for each tool path
                for i, path in enumerate(tool_paths):
                    points = path.get("points", [])
                    tool_name = path.get("tool_name", f"Tool_{i+1}")
                    
                    if not points or len(points) < 2:
                        continue
                        
                    # Create a polyline for the tool path
                    polyline = []
                    for point in points:
                        polyline.append(FreeCAD.Vector(point[0], point[1], point[2]))
                    
                    # Create a wire from the points
                    wire = Part.makePolygon(polyline)
                    path_obj = doc.addObject("Part::Feature", f"Path_{tool_name}")
                    path_obj.Shape = wire
                    
                    # Set color and line width
                    if hasattr(path_obj, "ViewObject"):
                        path_obj.ViewObject.LineColor = (0.0, 0.0, 1.0)  # Blue
                        path_obj.ViewObject.LineWidth = 2.0
                    
                    # Add to group
                    path_group.addObject(path_obj)
                
                doc.recompute()
                FreeCAD.Console.PrintMessage(f"Visualized {len(tool_paths)} tool paths\n")
        except Exception as e:
            print(f"Error visualizing tool paths: {str(e)}")
            traceback.print_exc()

# Context manager for design context
class DesignContextManager:
    """Manage design context for natural language CAD"""
    
    def __init__(self):
        self.context = {
            'project': 'default',
            'process': 'any',
            'material': 'any',
            'units': 'mm',
            'current_objects': []
        }
    
    def update_context(self, key, value):
        """Update a context value"""
        self.context[key] = value
    
    def get_context(self):
        """Get the current context"""
        return self.context
    
    def add_object(self, obj):
        """Add an object to the current context"""
        if obj not in self.context['current_objects']:
            self.context['current_objects'].append(obj)
    
    def clear_objects(self):
        """Clear the current objects"""
        self.context['current_objects'] = []

# Claude AI processor for conversational CAD generation
class CloudAIProcessor:
    """Process natural language using Claude AI for conversational CAD generation"""
    
    def __init__(self, cloud_client=None):
        self.cloud_client = cloud_client
        self.context_memory = []
        self.anthropic_client = None
        
        # Initialize Claude/Anthropic client for conversational CAD generation
        if ANTHROPIC_AVAILABLE and ANTHROPIC_API_KEY:
            try:
                self.anthropic_client = anthropic.Anthropic(api_key=ANTHROPIC_API_KEY)
                print("[OK] Claude AI conversational CAD generation ready")
            except Exception as e:
                print(f"⚠️ Failed to initialize Claude AI: {str(e)}")
        else:
            if not ANTHROPIC_AVAILABLE:
                print("⚠️ Claude AI library not available")
            elif not ANTHROPIC_API_KEY:
                print("⚠️ ANTHROPIC_API_KEY not found - Claude integration disabled")
        
        print(f"Debug: CloudAIProcessor initialized - Cloud: {cloud_client is not None}, Claude: {self.anthropic_client is not None}")
    
    def process_advanced_command(self, text, context=None):
        """Process command with Claude AI for conversational CAD generation"""
        # Try Claude AI first for conversational CAD generation
        if self.anthropic_client:
            try:
                return self.claude_conversational_process(text, context)
            except Exception as e:
                print(f"Claude conversational processing failed: {str(e)}, falling back")
        
        # Fallback to cloud client
        if self.cloud_client and self.cloud_client.connected:
            return self.cloud_process(text, context)
        else:
            return self.local_process(text, context)
    
    def claude_conversational_process(self, text, context=None):
        """Process using Claude AI for conversational CAD generation"""
        try:
            if not self.anthropic_client:
                print("Claude AI not available for conversational processing")
                return self.local_process(text, context)
            
            # Build comprehensive system prompt for conversational CAD generation
            system_prompt = """You are Axis 5, an expert CAD/manufacturing assistant integrated into FreeCAD. You provide conversational CAD generation and manufacturing intelligence.

Your capabilities:
1. Generate FreeCAD Python code from natural language descriptions
2. Create CAD models (brackets, gears, bottles, holders, containers, etc.)
3. Provide DFM analysis and manufacturing advice
4. Recommend tools, processes, and materials
5. Answer technical questions about CAD and manufacturing
6. Engage in natural conversation about design and manufacturing

When generating CAD code:
- Use FreeCAD Python API (FreeCAD, Part, Draft modules)
- Create objects in the active document
- Include proper recompute() calls
- Make objects visible with appropriate view settings

For manufacturing advice:
- Consider processes like 3D printing, CNC, injection molding
- Provide cost estimates and material recommendations
- Suggest design optimizations for manufacturability

Always be conversational, helpful, and provide practical solutions."""
            
            # Add context if available
            user_message = text
            if context:
                user_message = f"Context: {context}\n\nUser: {text}"
            
            # Add conversation memory for continuity
            if self.context_memory:
                recent_context = "\n".join(self.context_memory[-4:])  # Last 4 exchanges
                user_message = f"Recent conversation:\n{recent_context}\n\nCurrent: {text}"
            
            print(f"🤖 Axis 5 processing: {text[:100]}...")
            
            # Call Claude API for conversational response
            response = self.anthropic_client.messages.create(
                model="claude-3-sonnet-20240229",
                max_tokens=4000,
                system=system_prompt,
                messages=[
                    {"role": "user", "content": user_message}
                ]
            )
            
            response_text = response.content[0].text
            print(f"[OK] Axis 5 response generated: {len(response_text)} chars")
            
            # Store conversation in memory
            self.context_memory.append(f"User: {text}")
            self.context_memory.append(f"Axis 5: {response_text[:200]}...")
            
            # Keep memory manageable
            if len(self.context_memory) > 12:
                self.context_memory = self.context_memory[-12:]
            
            # Extract FreeCAD code if present
            freecad_code = self.extract_freecad_code(response_text)
            
            return {
                'success': True,
                'response': response_text,
                'freecad_code': freecad_code,
                'source': 'claude_conversational',
                'conversation_mode': True
            }
            
        except Exception as e:
            print(f"Error in Claude conversational processing: {str(e)}")
            return {
                'success': False,
                'error': str(e),
                'response': f"Axis 5 AI temporarily unavailable: {str(e)}. Using fallback processing."
            }
    
    def extract_freecad_code(self, text):
        """Extract FreeCAD Python code from Claude's conversational response"""
        try:
            import re
            
            # Look for Python code blocks
            python_pattern = r'```python\s*\n(.*?)\n```'
            matches = re.findall(python_pattern, text, re.DOTALL)
            
            if matches:
                return matches[0].strip()
            
            # Look for general code blocks
            code_pattern = r'```\s*\n(.*?)\n```'
            matches = re.findall(code_pattern, text, re.DOTALL)
            
            if matches:
                # Check if it looks like FreeCAD code
                code = matches[0].strip()
                if any(keyword in code for keyword in ['FreeCAD', 'Part.', 'Draft.', 'doc.addObject', 'App.ActiveDocument']):
                    return code
            
            return None
            
        except Exception as e:
            print(f"Error extracting FreeCAD code: {str(e)}")
            return None
    
    def cloud_process(self, text, context):
        """Use cloud AI for processing"""
        try:
            if not self.cloud_client:
                print("Debug: No cloud client available, falling back to local processing")
                return self.local_process(text, context)
            
            # Build prompt with context
            prompt = self.build_ai_prompt(text, context)
            
            # Query cloud AI
            print(f"Debug: Using cloud client to process: {text}")
            response = self.cloud_client.get_chat_response(prompt)
            
            # Extract response text
            if "response" in response:
                response_text = response["response"]
                try:
                    # Try to parse as JSON
                    if '{' in response_text and '}' in response_text:
                        json_str = response_text[response_text.find('{'):response_text.rfind('}')+1]
                        parsed = json.loads(json_str)
                        return parsed
                    else:
                        return self.parse_text_response(response_text)
                except json.JSONDecodeError:
                    return self.parse_text_response(response_text)
            else:
                return self.local_process(text, context)
        except Exception as e:
            print(f"Cloud AI error: {e}")
            return self.local_process(text, context)
    
    def build_ai_prompt(self, text, context):
        """Build comprehensive prompt for AI"""
        ctx = context or {}
        prompt = f"""I need to create a CAD model based on this description: \"{text}\". 
        Please analyze this request and provide a structured response with the following information:
        
        1. What type of object should be created (e.g., bracket, gear, housing)
        2. The key dimensions and parameters needed
        3. Any specific features that should be added (e.g., holes, fillets)
        4. Any manufacturing constraints to consider
        
        Format your response as a JSON object with these keys: intent, object_type, parameters, features, constraints.
        For example: {{"intent": "create", "object_type": "bracket", "parameters": {{"length": 100, "width": 50, "height": 20}}, "features": ["mounting_holes", "fillets"], "constraints": ["3d_printable"]}}
        """
        
        return prompt
    
    def local_process(self, text, context):
        """Local processing with pattern matching"""
        text_lower = text.lower()
        print(f"Debug: Using local processing for: {text}")
        
        # Basic pattern matching
        result = {
            'intent': 'create',
            'object_type': self.extract_object_type(text),
            'parameters': self.extract_parameters(text),
            'features': [],
            'constraints': []
        }
        
        # Extract features
        if 'hole' in text_lower or 'drill' in text_lower:
            result['features'].append('holes')
        if 'fillet' in text_lower or 'round' in text_lower:
            result['features'].append('fillets')
        if 'chamfer' in text_lower or 'bevel' in text_lower:
            result['features'].append('chamfers')
        
        return result
    
    def extract_object_type(self, text):
        """Extract what type of object to create"""
        objects = ['bracket', 'gear', 'housing', 'enclosure', 'mount', 
                  'plate', 'shaft', 'spacer', 'frame', 'support', 'box', 'cylinder']
        
        text_lower = text.lower()
        for obj in objects:
            if obj in text_lower:
                return obj
        return 'box'  # Default to box
    
    def extract_parameters(self, text):
        """Extract dimensional parameters"""
        params = {}
        
        # Extract dimensions (100x50x20 format)
        dim_match = re.search(r'(\d+)\s*x\s*(\d+)(?:\s*x\s*(\d+))?', text)
        if dim_match:
            params['length'] = float(dim_match.group(1))
            params['width'] = float(dim_match.group(2))
            if dim_match.group(3):
                params['height'] = float(dim_match.group(3))
        else:
            # Default dimensions
            params['length'] = 100.0
            params['width'] = 50.0
            params['height'] = 20.0
        
        return params
    
    def parse_text_response(self, response):
        """Parse text response when JSON parsing fails"""
        result = {
            'intent': 'create',
            'object_type': 'box',
            'parameters': {'length': 100.0, 'width': 50.0, 'height': 20.0},
            'features': [],
            'constraints': []
        }
        
        # Try to extract key information from text
        object_match = re.search(r'object_?type:?\s*(\w+)', response, re.IGNORECASE)
        if object_match:
            result['object_type'] = object_match.group(1).lower()
        
        # Look for dimensions
        length_match = re.search(r'length:?\s*(\d+(?:\.\d+)?)', response, re.IGNORECASE)
        if length_match:
            result['parameters']['length'] = float(length_match.group(1))
            
        width_match = re.search(r'width:?\s*(\d+(?:\.\d+)?)', response, re.IGNORECASE)
        if width_match:
            result['parameters']['width'] = float(width_match.group(1))
            
        height_match = re.search(r'height:?\s*(\d+(?:\.\d+)?)', response, re.IGNORECASE)
        if height_match:
            result['parameters']['height'] = float(height_match.group(1))
            
        return result

# Natural Language CAD Editor
class NaturalLanguageCADEditor:
    """Natural Language CAD Editor with Claude and Text-to-CAD Integration"""
    
    def __init__(self, cloud_client=None):
        """Initialize the NL CAD editor"""
        self.cloud_client = cloud_client
        self.ai_processor = CloudAIProcessor(cloud_client)
        self.context = DesignContextManager()
        
        # Initialize Text-to-CAD integration
        this_dir = os.path.dirname(os.path.abspath(__file__))
        config_path = os.path.join(this_dir, "cloud_config.json")
        try:
            if _TEXT_TO_CAD_AVAILABLE:
                self.text_to_cad = TextToCADIntegration(config_path)
                print(f"Text-to-CAD integration initialized, connected: {self.text_to_cad.connected}")
            else:
                self.text_to_cad = None
                print("Text-to-CAD integration not available")
        except Exception as e:
            print(f"Error initializing Text-to-CAD integration: {str(e)}")
            self.text_to_cad = None
        
        # Initialize Claude/Anthropic integration
        self.anthropic_client = None
        self.claude_available = False
        if _ANTHROPIC_AVAILABLE:
            api_key = load_anthropic_api_key()
            if api_key:
                try:
                    self.anthropic_client = anthropic.Anthropic(api_key=api_key)
                    self.claude_available = True
                    print("Claude/Anthropic integration initialized")
                except Exception as e:
                    print(f"Error initializing Claude: {str(e)}")
            else:
                print("ANTHROPIC_API_KEY not found - Claude features disabled")
        

        self.command_handlers = {}
        
        # Register command handlers
        self.register_command_handler('create', self.handle_create)
        self.register_command_handler('make', self.handle_create)
        self.register_command_handler('add', self.handle_create)
        self.register_command_handler('generate', self.handle_create)
        
        # Register advanced CAD handlers
        self.register_command_handler('gear', self.handle_gear)
        self.register_command_handler('extrude', self.handle_extrude)
        self.register_command_handler('fillet', self.handle_fillet)
        self.register_command_handler('cylinder', self.handle_cylinder)
    
    def register_command_handler(self, keyword, handler):
        """Register a command handler for a keyword"""
        self.command_handlers[keyword.lower()] = handler
    
    def process_command(self, text):
        """Process a natural language CAD command with Claude and Text-to-CAD integration"""
        print(f"Processing CAD command: {text}")
        
        # Check if this is a Text-to-CAD request first
        if self.text_to_cad and self.text_to_cad.is_text_to_cad_request(text):
            return self.handle_text_to_cad_request(text)
        
        # Check if Claude should handle this request
        if self.claude_available and self.should_use_claude(text):
            return self.handle_claude_request(text)
        
        # Check if this is a complex command that needs AI processing
        if self.is_complex_command(text):
            # Use AI processor
            ai_spec = self.ai_processor.process_advanced_command(text, self.context.get_context())
            return self.create_from_ai_spec(ai_spec)
        
        # Simple command processing
        text_lower = text.lower()
        
        # Check for specific advanced commands first
        if 'extrude' in text_lower or 'extend' in text_lower or 'pull' in text_lower:
            print(f"Debug: Detected extrude command: {text}")
            return self.handle_extrude(text)
            
        if 'fillet' in text_lower or 'round' in text_lower or 'corner' in text_lower:
            print(f"Debug: Detected fillet command: {text}")
            return self.handle_fillet(text)
            
        if 'gear' in text_lower or 'cog' in text_lower:
            print(f"Debug: Detected gear command: {text}")
            return self.handle_gear(text)
            
        # Find matching handler for other commands
        for keyword, handler in self.command_handlers.items():
            if keyword in text_lower:
                print(f"Debug: Found handler for keyword: {keyword}")
                return handler(text)
        
        # Default to create handler if no match
        return self.handle_create(text)
    
    def handle_create(self, text):
        """Handle create commands"""
        try:
            # Extract parameters using AI processor
            params = self.ai_processor.local_process(text, self.context.get_context())
            
            # Get object type
            obj_type = params['object_type']
            dimensions = params['parameters']
            
            # Check for specific object types that need special handling
            if obj_type in ['gear']:
                return self.handle_gear(text)
                
            # Create the basic shape
            obj = None
            doc = FreeCAD.ActiveDocument or FreeCAD.newDocument("CADPart")
            
            if obj_type in ['box', 'cube', 'block']:
                length = dimensions.get('length', 100)
                width = dimensions.get('width', 50)
                height = dimensions.get('height', 20)
                
                box = Part.makeBox(length, width, height)
                obj = doc.addObject("Part::Feature", "Box")
                obj.Shape = box
            
            elif obj_type in ['cylinder', 'tube', 'rod', 'shaft']:
                radius = dimensions.get('radius', 10)
                if 'diameter' in dimensions:
                    radius = dimensions['diameter'] / 2
                height = dimensions.get('height', 50)
                
                cylinder = Part.makeCylinder(radius, height)
                obj = doc.addObject("Part::Feature", "Cylinder")
                obj.Shape = cylinder
            
            elif obj_type in ['sphere', 'ball']:
                radius = dimensions.get('radius', 25)
                if 'diameter' in dimensions:
                    radius = dimensions['diameter'] / 2
                
                sphere = Part.makeSphere(radius)
                obj = doc.addObject("Part::Feature", "Sphere")
                obj.Shape = sphere
            
            else:  # Default to box
                length = dimensions.get('length', 100)
                width = dimensions.get('width', 50)
                height = dimensions.get('height', 20)
                
                box = Part.makeBox(length, width, height)
                obj = doc.addObject("Part::Feature", obj_type.capitalize())
                obj.Shape = box
            
            # Commit changes
            doc.recompute()
            
            # Add features if specified
            if 'features' in params:
                for feature in params['features']:
                    if feature == 'holes':
                        # Add holes - simplified implementation
                        pass
                    elif feature == 'fillets':
                        self.add_fillets_to_object(obj, 2.0)  # Default 2mm radius
            
            return {'success': True, 'message': f"Created {obj_type}", 'object': obj}
            
        except Exception as e:
            print(f"Error creating object: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error: {str(e)}"}
    
    def is_complex_command(self, text):
        """Determine if command needs AI processing"""
        complex_indicators = [
            'with', 'that has', 'including', 'having',
            'assembly', 'mechanism', 'system',
            'compatible', 'optimized', 'analyze'
        ]
        
        text_lower = text.lower()
        return any(indicator in text_lower for indicator in complex_indicators)
    
    def create_from_ai_spec(self, ai_spec):
        """Create part from AI specification"""
        try:
            # Check if we have a valid spec
            if not ai_spec or not isinstance(ai_spec, dict):
                return {'success': False, 'message': "Invalid AI specification"}
                
            # Get object type
            obj_type = ai_spec.get('object_type', 'box')
            params = ai_spec.get('parameters', {})
            
            # Create the object
            result = None
            
            if obj_type == 'box':
                length = params.get('length', 100)
                width = params.get('width', 50)
                height = params.get('height', 20)
                
                doc = FreeCAD.ActiveDocument or FreeCAD.newDocument("CADPart")
                box = Part.makeBox(length, width, height)
                obj = doc.addObject("Part::Feature", "Box")
                obj.Shape = box
                doc.recompute()
                
                result = {'success': True, 'message': f"Created box with AI specifications", 'object': obj}
            
            elif obj_type == 'gear':
                teeth = params.get('teeth', 20)
                module = params.get('module', 2.0)
                width = params.get('width', 10.0)
                
                result = self.create_gear(teeth, module, width)
                
            elif obj_type == 'cylinder':
                radius = params.get('radius', 10.0)
                if 'diameter' in params:
                    radius = params['diameter'] / 2
                height = params.get('height', 50.0)
                
                doc = FreeCAD.ActiveDocument or FreeCAD.newDocument("CADPart")
                cylinder = Part.makeCylinder(radius, height)
                obj = doc.addObject("Part::Feature", "Cylinder")
                obj.Shape = cylinder
                doc.recompute()
                
                result = {'success': True, 'message': f"Created cylinder with AI specifications", 'object': obj}
                
            # Add more object types here
                
            if not result:
                return {'success': False, 'message': f"Unsupported object type: {obj_type}"}
                
            return result
            
        except Exception as e:
            print(f"Error creating from AI spec: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error: {str(e)}"}
            
    def handle_gear(self, text):
        """Create a gear based on text description"""
        try:
            print(f"Creating gear from: {text}")
            
            # Extract teeth count
            teeth_match = re.search(r'(\d+)\s*(?:tooth|teeth|toothed)', text, re.IGNORECASE)
            teeth = int(teeth_match.group(1)) if teeth_match else 20
            
            # Extract module if specified
            module_match = re.search(r'module\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            module = float(module_match.group(1)) if module_match else 2.0
            
            # Extract width if specified
            width_match = re.search(r'width\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            width = float(width_match.group(1)) if width_match else 10.0
            
            return self.create_gear(teeth, module, width)
            
        except Exception as e:
            print(f"Error creating gear: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error creating gear: {str(e)}"}
    
    def create_gear(self, teeth=20, module=2.0, width=10.0):
        """Create a gear with the specified parameters"""
        try:
            # Ensure we have an active document
            doc = FreeCAD.ActiveDocument
            if not doc:
                doc = FreeCAD.newDocument("Gear")
            
            # Calculate gear dimensions
            pitch_diameter = teeth * module
            outer_diameter = pitch_diameter + 2 * module  # Addendum
            root_diameter = pitch_diameter - 2.5 * module  # Dedendum
            
            # Create the base cylinder at the root diameter
            base_cylinder = Part.makeCylinder(root_diameter/2, width)
            
            # Create the teeth by adding blocks around the perimeter
            tooth_angle = 360.0 / teeth  # Angle between teeth
            tooth_width_angle = tooth_angle * 0.4  # Width of each tooth in degrees
            
            # Create a compound shape to hold all teeth
            all_teeth = []
            
            for i in range(teeth):
                # Calculate the angle for this tooth
                angle = i * tooth_angle
                
                # Create a tooth as a box
                tooth_height = (outer_diameter - root_diameter) / 2  # Radial height of tooth
                tooth_width = root_diameter * math.sin(math.radians(tooth_width_angle))  # Arc width at root diameter
                
                # Create the tooth as a box
                tooth = Part.makeBox(tooth_height, tooth_width, width)
                
                # Position the tooth at the edge of the root cylinder
                tooth.translate(FreeCAD.Vector(root_diameter/2, -tooth_width/2, 0))
                
                # Rotate the tooth to its position
                tooth.rotate(FreeCAD.Vector(0, 0, 0), FreeCAD.Vector(0, 0, 1), angle)
                
                # Add to our collection
                all_teeth.append(tooth)
            
            # Fuse all teeth with the base cylinder
            gear_shape = base_cylinder
            for tooth in all_teeth:
                gear_shape = gear_shape.fuse(tooth)
            
            # Create a center bore
            bore = module * 5  # Reasonable bore size based on module
            center_hole = Part.makeCylinder(bore/2, width)
            gear_shape = gear_shape.cut(center_hole)
            
            # Create the final object
            gear_obj = doc.addObject("Part::Feature", f"Gear_T{teeth}_M{module}")
            gear_obj.Shape = gear_shape
            
            doc.recompute()
            
            return {
                'success': True,
                'message': f'Created gear: {teeth} teeth, module {module}, \u00f8{pitch_diameter:.1f}mm pitch diameter',
                'object': gear_obj,
                'specs': {
                    'teeth': teeth,
                    'module': module,
                    'pitch_diameter': pitch_diameter,
                    'outer_diameter': outer_diameter,
                    'root_diameter': root_diameter,
                    'width': width
                }
            }
            
        except Exception as e:
            print(f"Error creating gear: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error creating gear: {str(e)}"}
    
    def handle_cylinder(self, text):
        """Create a cylinder based on text description"""
        try:
            # Extract diameter/radius
            diameter_match = re.search(r'diameter\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            radius_match = re.search(r'radius\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            
            radius = 10.0  # Default
            if diameter_match:
                radius = float(diameter_match.group(1)) / 2
            elif radius_match:
                radius = float(radius_match.group(1))
            
            # Extract height/length
            height_match = re.search(r'(?:height|length)\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            height = float(height_match.group(1)) if height_match else 50.0
            
            # Create cylinder
            doc = FreeCAD.ActiveDocument or FreeCAD.newDocument("CADPart")
            cylinder = Part.makeCylinder(radius, height)
            obj = doc.addObject("Part::Feature", "Cylinder")
            obj.Shape = cylinder
            doc.recompute()
            
            return {'success': True, 'message': f"Created cylinder with radius {radius}mm and height {height}mm", 'object': obj}
            
        except Exception as e:
            print(f"Error creating cylinder: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error creating cylinder: {str(e)}"}
    
    def handle_extrude(self, text):
        """Handle extrusion commands with improved reliability"""
        try:
            print(f"Handling extrusion: {text}")
            print("Debug: ===== EXTRUDE OPERATION START =====")
            
            # Extract distance with better pattern matching
            distance_patterns = [
                r'(?:by|to|of)\s*(\d+(?:\.\d+)?)\s*(?:mm|millimeters?)?',
                r'(\d+(?:\.\d+)?)\s*(?:mm|millimeters?)',
                r'extrude.*?(\d+(?:\.\d+)?)',
            ]
            
            distance = 10.0  # Default
            for pattern in distance_patterns:
                distance_match = re.search(pattern, text, re.IGNORECASE)
                if distance_match:
                    distance = float(distance_match.group(1))
                    break
            
            print(f"Debug: Extrusion distance = {distance}mm")
            
            # Extract direction
            direction = 'up'  # Default direction
            if any(word in text.lower() for word in ['down', 'negative', 'inward', 'into']):
                direction = 'down'
            print(f"Debug: Extrusion direction = {direction}")
            
            # Ensure we have an active document
            if not FreeCAD.ActiveDocument:
                print("Debug: No active document, creating one")
                FreeCAD.newDocument("CADPart")
            
            doc = FreeCAD.ActiveDocument
            print(f"Debug: Active document is {doc.Name}")
            
            # Get selection
            try:
                selection = FreeCADGui.Selection.getSelectionEx()
                print(f"Debug: Found {len(selection)} selected objects")
                
                if not selection:
                    print("Debug: No selection found")
                    return {'success': False, 'message': 'Please select a face, sketch, or object to extrude first'}
                
            except Exception as sel_err:
                print(f"Debug: Selection error: {str(sel_err)}")
                return {'success': False, 'message': f'Selection error: {str(sel_err)}'}
            
            # Create extrusion vector
            if direction == 'down':
                extrude_vector = FreeCAD.Vector(0, 0, -distance)
            else:
                extrude_vector = FreeCAD.Vector(0, 0, distance)
            
            print(f"Debug: Extrusion vector: {extrude_vector}")
            
            # Process the selection
            success_count = 0
            error_messages = []
            
            for sel_item in selection:
                try:
                    obj = sel_item.Object
                    print(f"Debug: Processing object: {obj.Name} (Type: {obj.TypeId})")
                    
                    result_obj = None
                    
                    # Case 1: Face selection (most common for extrude commands)
                    if hasattr(sel_item, 'SubObjects') and sel_item.SubObjects:
                        print(f"Debug: Found {len(sel_item.SubObjects)} sub-objects")
                        
                        # Look for faces in the selection using proper FreeCAD API
                        faces = []
                        if hasattr(sel_item, 'SubElementNames'):
                            for sub_name in sel_item.SubElementNames:
                                if sub_name.startswith('Face'):
                                    # Get face index and extract the actual face from the shape
                                    face_index = int(sub_name[4:]) - 1
                                    if face_index < len(obj.Shape.Faces):
                                        faces.append(obj.Shape.Faces[face_index])
                        
                        if faces:
                            print(f"Debug: Found {len(faces)} face(s) to extrude")
                            face = faces[0]  # Use the first face
                            
                            try:
                                print("Debug: Attempting direct face extrusion")
                                extruded_shape = face.extrude(extrude_vector)
                                
                                # Create new object
                                extrude_name = f"Extrude_{obj.Name}_{int(abs(distance))}mm"
                                result_obj = doc.addObject("Part::Feature", extrude_name)
                                result_obj.Shape = extruded_shape
                                result_obj.ViewObject.Visibility = True
                                
                                print(f"Debug: Successfully created face extrusion: {extrude_name}")
                                success_count += 1
                                
                            except Exception as face_err:
                                print(f"Debug: Direct face extrusion failed: {str(face_err)}")
                                error_messages.append(f"Face extrusion failed: {str(face_err)}")
                    
                    # Case 2: Sketch object
                    elif obj.TypeId == "Sketcher::SketchObject":
                        print("Debug: Processing sketch object")
                        try:
                            # Try to create a face from the sketch and extrude it
                            sketch_wires = obj.Shape.Wires
                            if sketch_wires:
                                wire = sketch_wires[0]
                                if wire.isClosed():
                                    face = Part.Face(wire)
                                    extruded_shape = face.extrude(extrude_vector)
                                    
                                    extrude_name = f"Extrude_{obj.Name}_{int(abs(distance))}mm"
                                    result_obj = doc.addObject("Part::Feature", extrude_name)
                                    result_obj.Shape = extruded_shape
                                    result_obj.ViewObject.Visibility = True
                                    
                                    print(f"Debug: Successfully created sketch extrusion: {extrude_name}")
                                    success_count += 1
                                else:
                                    error_messages.append(f"Sketch {obj.Name} is not closed")
                            else:
                                error_messages.append(f"Sketch {obj.Name} has no wires")
                                
                        except Exception as sketch_err:
                            print(f"Debug: Sketch processing failed: {str(sketch_err)}")
                            error_messages.append(f"Sketch processing failed: {str(sketch_err)}")
                    
                    # Case 3: Objects with faces (try to extrude the largest face)
                    elif hasattr(obj, 'Shape') and obj.Shape.Faces:
                        print("Debug: Processing object with faces")
                        try:
                            # Get the largest face (most likely the one to extrude)
                            largest_face = max(obj.Shape.Faces, key=lambda f: f.Area)
                            print("Debug: Attempting clean face extrusion")
                            try:
                                # Create a clean copy of the face to avoid corruption
                                face_copy = largest_face.copy()
                                
                                # Create extrusion using proper FreeCAD extrude method
                                extruded_shape = face_copy.extrude(extrude_vector)
                                
                                # Ensure the shape is valid
                                if not extruded_shape.isValid():
                                    print("Debug: Invalid extruded shape, attempting to fix")
                                    extruded_shape = extruded_shape.fix()
                                
                                extrude_name = f"Extrude_{obj.Name}_{int(abs(distance))}mm"
                                result_obj = doc.addObject("Part::Feature", extrude_name)
                                result_obj.Shape = extruded_shape
                                
                                # Ensure object is visible and properly rendered
                                result_obj.ViewObject.Visibility = True
                                result_obj.ViewObject.DisplayMode = "Flat Lines"  # Clean display mode
                                
                                # Make the extruded object more visible
                                try:
                                    result_obj.ViewObject.ShapeColor = (0.0, 0.8, 0.0)  # Green color
                                    result_obj.ViewObject.Transparency = 20  # Slightly transparent
                                    
                                    # Force document recompute
                                    doc.recompute()
                                    
                                    # Clear selection and select the new object
                                    FreeCADGui.Selection.clearSelection()
                                    FreeCADGui.Selection.addSelection(result_obj)
                                    
                                    # Force view update
                                    FreeCADGui.updateGui()
                                except:
                                    pass
                                
                                print(f"Debug: Successfully created clean face extrusion: {extrude_name}")
                                success_count += 1
                            
                            except Exception as face_err:
                                print(f"Debug: Face extrusion failed: {str(face_err)}")
                                error_messages.append(f"Face extrusion failed: {str(face_err)}")
                            
                        except Exception as obj_err:
                            print(f"Debug: Object face extrusion failed: {str(obj_err)}")
                            error_messages.append(f"Object extrusion failed: {str(obj_err)}")
                    
                    else:
                        error_messages.append(f"Object {obj.Name} cannot be extruded (type: {obj.TypeId})")
                    
                except Exception as item_err:
                    print(f"Debug: Error processing selection item: {str(item_err)}")
                    error_messages.append(f"Processing error: {str(item_err)}")
            
            # Recompute document
            doc.recompute()
            
            # Update view
            if FreeCADGui.ActiveDocument:
                try:
                    FreeCADGui.ActiveDocument.ActiveView.viewAxometric()
                    FreeCADGui.updateGui()
                except:
                    pass  # View update is not critical
            
            # Return results
            if success_count > 0:
                message = f"Successfully extruded {success_count} item(s) by {distance}mm {direction}"
                if error_messages:
                    message += f" (with {len(error_messages)} errors)"
                
                print(f"Debug: {message}")
                print("Debug: ===== EXTRUDE OPERATION COMPLETE =====")
                return {'success': True, 'message': message}
            else:
                error_summary = "; ".join(error_messages) if error_messages else "Unknown error"
                print(f"Debug: No extrusions created. Errors: {error_summary}")
                print("Debug: ===== EXTRUDE OPERATION FAILED =====")
                return {'success': False, 'message': f'No extrusions created. {error_summary}'}
                
        except Exception as e:
            print(f"Error during extrusion: {str(e)}")
            traceback.print_exc()
            print("Debug: ===== EXTRUDE OPERATION FAILED =====")
            return {'success': False, 'message': f"Error during extrusion: {str(e)}"}
    
    def handle_fillet(self, text):
        """Handle fillet commands"""
        try:
            print(f"Handling fillet: {text}")
            
            # Extract radius
            radius_match = re.search(r'(?:radius|of)\s*(\d+(?:\.\d+)?)\s*(?:mm)?', text, re.IGNORECASE)
            radius = float(radius_match.group(1)) if radius_match else 2.0
            print(f"Debug: Fillet radius = {radius}mm")
            
            # Check if edges are selected
            try:
                selection = FreeCADGui.Selection.getSelectionEx()
                print(f"Debug: Found {len(selection)} selected objects")
                
                if not selection:
                    # If no selection, try to select the most recently created object
                    doc = FreeCAD.ActiveDocument
                    if doc and len(doc.Objects) > 0:
                        # Get the last created object
                        last_obj = doc.Objects[-1]
                        print(f"Debug: Auto-selecting last created object: {last_obj.Name}")
                        FreeCADGui.Selection.addSelection(last_obj)
                        selection = FreeCADGui.Selection.getSelectionEx()
                    else:
                        print("Debug: No objects in document to select")
                        return {'success': False, 'message': 'Please select an object or edges first'}
            except Exception as sel_err:
                print(f"Debug: Error during selection: {str(sel_err)}")
                traceback.print_exc()
                return {'success': False, 'message': f"Selection error: {str(sel_err)}"}
            
            results = []
            for sel_obj in selection:
                obj = sel_obj.Object
                print(f"Debug: Processing object for fillet: {obj.Name}")
                
                if not hasattr(obj, 'Shape') or not hasattr(obj.Shape, 'Edges') or len(obj.Shape.Edges) == 0:
                    print(f"Debug: Object {obj.Name} has no edges to fillet")
                    continue
                    
                print(f"Debug: Object has {len(obj.Shape.Edges)} edges")
                
                # Check if specific edges are selected
                selected_edges = []
                if hasattr(sel_obj, 'SubElementNames') and sel_obj.SubElementNames:
                    print(f"Debug: Found {len(sel_obj.SubElementNames)} sub-elements")
                    for sub in sel_obj.SubElementNames:
                        if sub.startswith('Edge'):
                            edge_idx = int(sub.replace('Edge', '')) - 1
                            selected_edges.append(edge_idx)
                            print(f"Debug: Selected edge {edge_idx}")
                
                # If no specific edges selected, use all edges
                if not selected_edges:
                    print("Debug: No specific edges selected, using all edges")
                    selected_edges = list(range(len(obj.Shape.Edges)))
                
                if not selected_edges:
                    print(f"Debug: No edges found for object {obj.Name}")
                    continue
                
                try:
                    # Create fillet
                    fillet_name = f"Fillet_{obj.Name}"
                    print(f"Debug: Creating fillet object {fillet_name}")
                    fillet = FreeCAD.ActiveDocument.addObject("Part::Fillet", fillet_name)
                    fillet.Base = obj
                    
                    # Add edges to fillet
                    edge_strings = []
                    for edge_idx in selected_edges:
                        if edge_idx < len(obj.Shape.Edges):
                            edge_strings.append((edge_idx+1, radius, radius))
                    
                    print(f"Debug: Adding {len(edge_strings)} edges to fillet")
                    fillet.Edges = edge_strings
                    
                    # Hide original object
                    if hasattr(FreeCADGui, "ActiveDocument") and FreeCADGui.ActiveDocument:
                        try:
                            FreeCADGui.ActiveDocument.getObject(obj.Name).Visibility = False
                            print(f"Debug: Set original object {obj.Name} visibility to False")
                        except Exception as vis_err:
                            print(f"Debug: Error setting visibility: {str(vis_err)}")
                    
                    results.append({
                        'object': fillet,
                        'radius': radius,
                        'edges': len(edge_strings)
                    })
                    print(f"Debug: Successfully added fillet to results")
                except Exception as fillet_err:
                    print(f"Debug: Error creating fillet: {str(fillet_err)}")
                    traceback.print_exc()
            
            # Recompute document
            FreeCAD.ActiveDocument.recompute()
            
            if not results:
                return {'success': False, 'message': 'No fillets were created'}
                
            return {
                'success': True,
                'message': f'Created {len(results)} fillet(s) with radius {radius}mm',
                'fillets': results
            }
            
        except Exception as e:
            print(f"Error creating fillet: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error creating fillet: {str(e)}"}
    
    def should_use_claude(self, text):
        """Determine if Claude should handle this request"""
        if not self.claude_available:
            return False
        
        # Use Claude for conversational requests, complex analysis, or when explicitly asked
        claude_keywords = [
            'explain', 'how', 'why', 'what', 'analyze', 'recommend', 'suggest',
            'compare', 'optimize', 'improve', 'claude', 'ai', 'help me understand'
        ]
        
        text_lower = text.lower()
        return any(keyword in text_lower for keyword in claude_keywords)
    
    def handle_claude_request(self, text):
        """Handle request using Claude AI"""
        try:
            # Get current CAD context
            context = self.context.get_context()
            
            # Build comprehensive prompt for Claude
            system_prompt = """You are an expert manufacturing engineer and CAD specialist integrated into FreeCAD. 
You help users with:
- CAD design and modeling
- Manufacturing processes and DFM analysis
- Material selection and optimization
- Engineering calculations and recommendations

Provide practical, actionable advice. If the user wants to create CAD geometry, provide specific FreeCAD Python code."""
            
            user_prompt = f"""Current CAD Context:
{context}

User Request: {text}

Please provide a helpful response with specific recommendations or FreeCAD code if applicable."""
            
            # Call Claude API
            response = self.anthropic_client.messages.create(
                model="claude-3-sonnet-20240229",
                max_tokens=2000,
                system=system_prompt,
                messages=[
                    {"role": "user", "content": user_prompt}
                ]
            )
            
            claude_response = response.content[0].text
            
            return {
                'success': True,
                'message': claude_response,
                'source': 'Claude AI',
                'type': 'conversational'
            }
            
        except Exception as e:
            print(f"Error with Claude request: {str(e)}")
            # Fallback to regular processing
            return self.ai_processor.process_advanced_command(text, self.context.get_context())
    
    def handle_text_to_cad_request(self, text):
        """Handle a Text-to-CAD request using the cloud service"""
        if not self.text_to_cad:
            return {
                "success": False,
                "message": "Text-to-CAD integration is not available"
            }
            
        try:
            print(f"Processing Text-to-CAD request: {text}")
            
            # Process the request using TextToCADIntegration
            result = self.text_to_cad.process_request(text)
            
            # Execute the FreeCAD code to actually create the CAD object
            if result.get("success", False):
                freecad_code = result.get("freecad_code", "")
                print(f"Got FreeCAD code with length: {len(freecad_code)}")
                if freecad_code:
                    print(f"About to execute FreeCAD code via execute_freecad_code")
                    
                    execution_result = self.text_to_cad.execute_freecad_code(freecad_code)
                    print(f"Execution result: {execution_result}")
                    
                    if not execution_result.get("success", False):
                        print(f"Failed to execute FreeCAD code: {execution_result.get('error', 'Unknown error')}")
                        return {
                            "success": False,
                            "message": f"Failed to execute CAD code: {execution_result.get('error', 'Unknown error')}"
                        }
                    else:
                        print("FreeCAD code executed successfully - CAD object should be visible in 3D view")
                else:
                    print("No FreeCAD code received from server")
                
                return {
                    "success": True,
                    "message": result.get("message", "CAD model created successfully"),
                    "engineering_analysis": result.get("engineering_analysis", "")
                }
            else:
                error_msg = result.get("error", "Unknown error in Text-to-CAD request")
                print(f"Text-to-CAD request failed: {error_msg}")
                return {
                    "success": False,
                    "message": f"Text-to-CAD failed: {error_msg}"
                }
                
        except Exception as e:
            print(f"Error in Text-to-CAD request: {str(e)}")
            traceback.print_exc()
            return {
                "success": False,
                "message": f"Text-to-CAD error: {str(e)}"
            }
    
    def add_fillets_to_object(self, obj, radius=2.0):
        """Add fillets to all edges of an object"""
        try:
            if not obj or not hasattr(obj, 'Shape') or not hasattr(obj.Shape, 'Edges'):
                return False
                
            # Create fillet
            fillet_name = f"Fillet_{obj.Name}"
            fillet = FreeCAD.ActiveDocument.addObject("Part::Fillet", fillet_name)
            fillet.Base = obj
            
            # Add all edges to fillet
            edge_strings = []
            for i in range(len(obj.Shape.Edges)):
                edge_strings.append((i+1, radius, radius))
            
            fillet.Edges = edge_strings
            
            # Hide original object
            if hasattr(FreeCADGui, "ActiveDocument") and FreeCADGui.ActiveDocument:
                FreeCADGui.ActiveDocument.getObject(obj.Name).Visibility = False
            
            # Recompute document
            FreeCAD.ActiveDocument.recompute()
            
            return True
            
        except Exception as e:
            print(f"Error adding fillets: {str(e)}")
            return False

    def handle_text_to_cad_request(self, text):
        """Handle a Text-to-CAD request using the cloud service"""
        if not self.text_to_cad:
            return {
                "success": False,
                "message": "Text-to-CAD integration is not available"
            }
            
        try:
            print(f"Processing Text-to-CAD request: {text}")
            
            # Create a progress callback function
            def progress_callback(message):
                print(f"Text-to-CAD progress: {message}")
            
            # Process the request using the improved TextToCADIntegration
            result = self.text_to_cad.process_request(text)
            
            # Execute the FreeCAD code to actually create the CAD object and make it visible - AXIS 5 DEBUG
            if result.get("success", False):
                freecad_code = result.get("freecad_code", "")
                print(f"🔍 AXIS 5 DEBUG: Got FreeCAD code with length: {len(freecad_code)}")
                if freecad_code:
                    print(f"🔍 AXIS 5 DEBUG: About to execute FreeCAD code via enhanced execute_freecad_code")
                    print(f"🔍 AXIS 5 DEBUG: First 200 chars of code: {freecad_code[:200]}...")
                    
                    execution_result = self.text_to_cad.execute_freecad_code(freecad_code)
                    print(f"🔍 AXIS 5 DEBUG: Execution result: {execution_result}")
                    
                    if not execution_result.get("success", False):
                        print(f"❌ AXIS 5 DEBUG: Failed to execute FreeCAD code: {execution_result.get('error', 'Unknown error')}")
                        return {
                            "success": False,
                            "message": f"Failed to execute CAD code: {execution_result.get('error', 'Unknown error')}"
                        }
                    else:
                        print("[OK] AXIS 5 DEBUG: FreeCAD code executed successfully - CAD object should be visible in 3D view")
                        print(f"[OK] AXIS 5 DEBUG: Enhanced GUI updates should have been applied for visibility")
                else:
                    print("❌ AXIS 5 DEBUG: No FreeCAD code received from server")
                
                return {
                    "success": True,
                    "message": result.get("message", "CAD model created successfully"),
                    "engineering_analysis": result.get("engineering_analysis", "")
                }
            else:
                error_msg = result.get("message", "Unknown error in Text-to-CAD request")
                print(f"Text-to-CAD request failed: {error_msg}")
                return {
                    "success": False,
                    "message": f"Failed to process Text-to-CAD request: {error_msg}",
                    "fallback_available": result.get("fallback_available", False)
                }
                
        except Exception as e:
            print(f"Error in Text-to-CAD request: {str(e)}")
            traceback.print_exc()
            return {
                "success": False,
                "message": f"Error processing Text-to-CAD request: {str(e)}"
            }

class CloudApiClient:
    """Client for communicating with the Manufacturing Co-Pilot Cloud API"""
    
    # Default endpoint for CAD analysis
    default_analysis_endpoint = "/api/analysis/cad"
    
    @classmethod
    def load_cloud_config(cls):
        """Load cloud configuration from JSON file if available"""
        try:
            # Check for config file in the same directory as this script
            script_dir = os.path.dirname(os.path.realpath(__file__))
            config_file = os.path.join(script_dir, "cloud_config.json")
            
            if os.path.exists(config_file):
                print(f"Loading cloud configuration from {config_file}")
                with open(config_file, "r") as f:
                    cloud_config = json.load(f)
                
                # Update default endpoint if specified
                if "default_analysis_endpoint" in cloud_config:
                    cls.default_analysis_endpoint = cloud_config["default_analysis_endpoint"]
                    print(f"Using custom analysis endpoint: {cls.default_analysis_endpoint}")
                
                return cloud_config
            else:
                print("No cloud_config.json file found, using defaults")
                return {}
        except Exception as e:
            print(f"Error loading cloud configuration: {e}")
            return {}
    
    def __init__(self, api_url: str = None, api_key: str = None):
        """Initialize the cloud API client"""
        # Load cloud configuration
        cloud_config = self.load_cloud_config()
        
        # Store the entire config in the instance
        self.config = cloud_config
        
        # Set API URL and key from config or parameters
        self.api_url = api_url or cloud_config.get("cloud_api_url", "https://freecad-copilot-service-501520737043.asia-south1.run.app")
        self.api_key = api_key or cloud_config.get("cloud_api_key", "dev_api_key_for_testing")
        self.default_analysis_endpoint = self.default_analysis_endpoint or cloud_config.get("default_analysis_endpoint", "/api/analysis/cad")
        self.timeout = cloud_config.get("connection_timeout", 10)  # Default timeout in seconds
        
        # Print debug info about DFM endpoint
        if "dfm_endpoint" in cloud_config:
            print(f"DEBUG: Loaded DFM endpoint from config: {cloud_config['dfm_endpoint']}")
        else:
            print("DEBUG: No DFM endpoint found in config")
            # Add default DFM endpoint if not present
            # Use the analysis endpoint for DFM since the dedicated DFM endpoint doesn't exist
            self.config["dfm_endpoint"] = "/api/analysis/cad"
        self.last_error = None
        self.connected = False
        self.connection_quality = "unknown"  # unknown, poor, fair, good, excellent
        self.last_latency = 0  # in ms
        self.last_check_time = 0
        self.connection_listeners = []  # callbacks for connection status changes
        
        # Test connection on init
        self.test_connection()
    
    def test_connection(self) -> bool:
        """Test connection to the cloud API"""
        try:
            # Load timeout from config or use default
            cloud_config = self.load_cloud_config()
            timeout = cloud_config.get("connection_timeout", 10)
            retry_count = cloud_config.get("retry_count", 3)
            
            # Only use the known working endpoint to avoid 404 errors
            endpoints_to_try = ["/health"]
            
            print(f"Testing connection with endpoint: {endpoints_to_try[0]}")
            
            # Try each endpoint with retries
            for endpoint in endpoints_to_try:
                for attempt in range(retry_count):
                    try:
                        start_time = time.time()
                        response = self._make_request(endpoint, method="GET", timeout=timeout)
                        end_time = time.time()
                        
                        # Calculate latency in milliseconds
                        latency = int((end_time - start_time) * 1000)
                        self.last_latency = latency
                        self.last_check_time = time.time()
                        
                        # Determine connection quality based on latency
                        if latency < 200:
                            self.connection_quality = "excellent"
                        elif latency < 500:
                            self.connection_quality = "good"
                        elif latency < 1000:
                            self.connection_quality = "fair"
                        else:
                            self.connection_quality = "poor"
                            
                        # Connection successful
                        old_status = self.connected
                        self.connected = True
                        
                        # Notify listeners if status changed
                        if not old_status and self.connected:
                            self._notify_connection_change()
                            
                        return True
                    except Exception as e:
                        print(f"Attempt {attempt+1}/{retry_count} failed for endpoint {endpoint}: {str(e)}")
                        if attempt == retry_count - 1:
                            continue  # Try next endpoint
                        time.sleep(0.5)  # Brief delay between retries
            
            # If we get here, all endpoints failed
            self.last_error = "Failed to connect to cloud API"
            old_status = self.connected
            self.connected = False
            self.connection_quality = "poor"  # Set to poor instead of unknown for UI clarity
            
            # Try one more time with the default API key
            print("Trying connection with default API key...")
            self.api_key = "dev_api_key_for_testing"
            
            # Try the most reliable endpoint with the default key
            try:
                response = self._make_request("/health", method="GET", timeout=timeout)
                print("Connection successful with default API key")
                self.connected = True
                self.connection_quality = "fair"
                
                # Update the config file with the working API key
                if hasattr(self, 'config'):
                    self.config["cloud_api_key"] = self.api_key
                    self._save_config_to_file()
                    
                # Notify listeners of the connection change
                self._notify_connection_change()
                return True
            except Exception as e:
                print(f"Connection with default API key also failed: {str(e)}")
            
            # If we still can't connect, return a local fallback response
            return False
        except Exception as e:
            self.last_error = str(e)
            old_status = self.connected
            self.connected = False
            self.connection_quality = "unknown"
            
            # Notify listeners if status changed
            if old_status and not self.connected:
                self._notify_connection_change()
            
            return False
    
    def get_chat_response(self, message: str) -> Dict[str, Any]:
        """Get a response from the cloud API for a chat message"""
        try:
            # Get active document info if available
            cad_data = self._get_cad_data()
            
            # Check if this is a DFM analysis request
            message_lower = message.lower()
            dfm_terms = [
                "dfm", 
                "check for manufacturability",
                "design for manufacturing",
                "manufacturable",
                "3d print",
                "3d printing",
                "printable",
                "can this be printed",
                "can this be manufactured",
                "cnc",
                "machining",
                "machinable",
                "manufacturing issues",
                "manufacturing problems",
                "manufacturing constraints",
                "check this part"
            ]
            # Log the message for debugging
            print(f"DEBUG: Checking if message is DFM request: '{message}'")
            
            # Check if any DFM term is in the message
            is_dfm_request = any(term in message_lower for term in dfm_terms)
            print(f"DEBUG: Is DFM request: {is_dfm_request}")
            
            # Prepare payload for analysis endpoint
            payload = {
                "message": message,
                "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
                "mode": "general",
                "cad_data": cad_data
            }
            
            # Determine which endpoint to use
            endpoint = self.default_analysis_endpoint
            
            # Debug config information
            print(f"DEBUG: Has config attribute: {hasattr(self, 'config')}")
            if hasattr(self, 'config'):
                print(f"DEBUG: Config keys: {list(self.config.keys())}")
                print(f"DEBUG: DFM endpoint in config: {'dfm_endpoint' in self.config}")
                if 'dfm_endpoint' in self.config:
                    print(f"DEBUG: DFM endpoint value: {self.config['dfm_endpoint']}")
            
            # If this is a DFM request and dfm_endpoint is configured, use it
            if is_dfm_request:
                print("DEBUG: This is a DFM request")
                if hasattr(self, 'config') and 'dfm_endpoint' in self.config:
                    print(f"DEBUG: Using DFM endpoint: {self.config['dfm_endpoint']}")
                    endpoint = self.config['dfm_endpoint']
                else:
                    print("DEBUG: No DFM endpoint configured, using default endpoint")
            else:
                print("DEBUG: Not a DFM request, using default endpoint")
            
            # Prepare the appropriate payload based on the endpoint
            request_payload = payload
            
            # If this is a DFM request, format the payload appropriately
            if is_dfm_request:
                print("DEBUG: Formatting payload for DFM endpoint")
                
                # Format payload for the new DFM endpoint structure
                print("DEBUG: Formatting payload for new DFM endpoint structure")
                
                # Extract CAD data
                if 'cad_data' not in payload:
                    print("ERROR: Missing cad_data in payload")
                    payload['cad_data'] = {}
                
                cad_data = payload['cad_data']
                part_name = cad_data.get('name', 'Unknown Part')
                
                # Default values
                material = cad_data.get('material', 'ABS')
                process = 'fdm'  # Default to FDM 3D printing
                
                # Extract manufacturing intent from message if available
                message = payload.get('message', '').lower()
                
                # More detailed process detection
                if 'cnc' in message or 'machin' in message or 'mill' in message:
                    process = 'cnc'
                    print(f"DEBUG: Detected CNC machining process from query: '{message}'")
                elif '3d print' in message or 'fdm' in message or 'printing' in message or 'printed' in message:
                    process = 'fdm'
                    print(f"DEBUG: Detected 3D printing process from query: '{message}'")
                elif 'injection' in message or 'molding' in message or 'moulding' in message:
                    process = 'injection_molding'
                    print(f"DEBUG: Detected injection molding process from query: '{message}'")
                
                print(f"DEBUG: Selected manufacturing process: {process}")
                
                # Extract features from CAD data
                features = []
                
                # Add walls if we have thickness information
                if 'dimensions' in cad_data and 'thickness' in cad_data['dimensions']:
                    features.append({
                        "type": "wall",
                        "dimensions": {"thickness": cad_data['dimensions'].get('thickness', 1.5)},
                        "geometry_ref": {"face_index": None}
                    })
                
                # Add fillets if we have radius information
                if 'manufacturing_features' in cad_data and 'min_fillet_radius' in cad_data['manufacturing_features']:
                    features.append({
                        "type": "fillet",
                        "dimensions": {"radius": cad_data['manufacturing_features'].get('min_fillet_radius', 0.5)},
                        "geometry_ref": {"edge_index": None}
                    })
                
                # Add holes if we have any in the features
                if 'manufacturing_features' in cad_data and 'holes' in cad_data['manufacturing_features']:
                    hole_count = cad_data['manufacturing_features'].get('holes', 0)
                    if hole_count > 0:
                        features.append({
                            "type": "hole",
                            "dimensions": {"diameter": 2.0},  # Default diameter
                            "geometry_ref": {"face_index": None}
                        })
                
                # Create the DFM-specific payload that works with both endpoints
                dfm_data = {
                    "material": material,
                    "process": process,
                    "features": features,
                    "tolerances": {"general": 0.1},
                    "surface_finish": "normal"
                }
                
                # Integrate DFM data into the standard payload format
                request_payload = {
                    "message": payload["message"],
                    "timestamp": payload["timestamp"],
                    "mode": "dfm",  # Set mode to dfm
                    "cad_data": payload["cad_data"],
                    "dfm_data": dfm_data,  # Add the DFM-specific data
                    "analysis_type": "dfm",
                    "manufacturing_process": process,  # Explicitly specify the manufacturing process
                    "query_intent": {
                        "process_specific": True,
                        "process_type": process,
                        "original_query": payload["message"]
                    }
                }
                
                print(f"DEBUG: New DFM payload: {request_payload}")
                print(f"DEBUG: Enhanced payload for DFM: {request_payload}")
                print(f"DEBUG: DFM payload: {request_payload}")
            
            # Try the selected endpoint with retries
            max_retries = 3
            retry_delay = 1  # seconds
            
            # For DFM requests, use the dedicated endpoint if available
            if is_dfm_request:
                # Check if we should use the new dedicated DFM endpoint
                if self.config.get('use_dedicated_dfm_endpoint', False) and '/check_dfm' in self.config.get('dfm_endpoint', ''):
                    # Use the dedicated endpoint without query parameters
                    print(f"DEBUG: Using dedicated DFM endpoint: {endpoint}")
                else:
                    # Fall back to the analysis endpoint with query parameters
                    endpoint = f"{endpoint}?analysis_type=dfm&process={process}"
                    print(f"DEBUG: Using analysis endpoint with DFM and process parameters: {endpoint}")
            
            for attempt in range(1, max_retries + 1):
                try:
                    if attempt > 1:
                        print(f"Retry attempt {attempt}/{max_retries} for endpoint {endpoint}")
                    response = self._make_request(endpoint, payload=request_payload)
                    # If successful, update connection status
                    if not self.connected:
                        old_status = self.connected
                        self.connected = True
                        if old_status != self.connected:
                            self._notify_connection_change()
                
                    # For DFM requests, format the response appropriately
                    if is_dfm_request:
                        print("DEBUG: Formatting DFM response")
                        print(f"DEBUG: Response keys: {response.keys() if isinstance(response, dict) else 'Not a dict'}")                        
                        # Get part name from payload
                        part_name = "Unknown Part"
                        original_query = ""
                        if isinstance(payload, dict):
                            if 'cad_data' in payload:
                                part_name = payload['cad_data'].get('name', 'Unknown Part')
                            elif 'material' in payload and 'features' in payload:
                                # This is the new DFM payload format
                                part_name = "Part"
                            
                            # Store the original query for context
                            original_query = payload.get('message', '')
                            
                        # Add the original query to the response for context
                        if isinstance(response, dict) and original_query:
                            response['original_query'] = original_query
                        
                        # Create a DFM-specific response
                        if isinstance(response, dict):
                            # Check if this is a response from the new DFM endpoint
                            if 'violations' in response:
                                print("DEBUG: Found violations data in response (new DFM format)")
                                dfm_response = {
                                    "response": self._format_dfm_response(response, part_name),
                                    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S")
                                }
                                return dfm_response
                            # Check if this is an analysis result with manufacturability data (legacy format)
                            elif 'manufacturability_index' in response or 'design_issues' in response:
                                print("DEBUG: Found manufacturability data in response (legacy format)")
                                
                                # Determine if this is a process-specific query
                                process_type = ''
                                if original_query:
                                    if '3d print' in original_query.lower() or 'printed' in original_query.lower() or 'printing' in original_query.lower():
                                        process_type = 'fdm'
                                        print(f"DEBUG: Detected 3D printing query: '{original_query}'")
                                    elif 'cnc' in original_query.lower() or 'machin' in original_query.lower() or 'mill' in original_query.lower():
                                        process_type = 'cnc'
                                        print(f"DEBUG: Detected CNC machining query: '{original_query}'")
                                
                                # Add process type to the response
                                if process_type:
                                    response['manufacturing_process'] = process_type
                                
                                dfm_response = {
                                    "response": self._format_dfm_response(response, part_name),
                                    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S")
                                }
                                return dfm_response
                
                    return response
                except Exception as e:
                    print(f"Primary endpoint attempt {attempt} failed: {str(e)}")
                    if attempt < max_retries:
                        print(f"Waiting {retry_delay}s before retry...")
                        time.sleep(retry_delay)
                        retry_delay *= 2  # Exponential backoff
                    else:
                        first_error = e
            
            # If we get here, all primary endpoint attempts failed
            print("All primary endpoint attempts failed, trying fallbacks")
            
            # Try fallback endpoints if available
            if hasattr(self, 'config') and 'fallback_endpoints' in self.config:
                for endpoint in self.config['fallback_endpoints']:
                    try:
                        print(f"Trying fallback endpoint: {endpoint}")
                        response = self._make_request(endpoint, payload=payload)
                        return response
                    except Exception as e:
                        print(f"Fallback endpoint {endpoint} failed: {str(e)}")
            
            # If all endpoints fail, try the /api/chat endpoint as last resort
            try:
                print("Trying generic chat endpoint: /api/chat")
                chat_payload = {"message": message}
                response = self._make_request("/api/chat", payload=chat_payload)
                return response
            except Exception as e:
                print(f"Chat endpoint failed: {str(e)}")
                
                # Force reconnection attempt
                print("Attempting to reconnect to cloud service...")
                self.test_connection()
                
                # If reconnection successful, try one more time with the original endpoint
                if self.connected:
                    print("Reconnected successfully, retrying original request")
                    try:
                        response = self._make_request(endpoint, payload=request_payload)
                        return response
                    except Exception as retry_error:
                        print(f"Retry after reconnection failed: {str(retry_error)}")
                        
                # If we still can't connect, return a local fallback response
                return {
                    "response": "I'm processing your request locally. Cloud connection is currently unavailable.",
                    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S")
                }
                
            # If we get here, all endpoints failed
            raise Exception(f"All endpoints failed. Primary error: {str(first_error)}")
        except Exception as e:
            self.last_error = str(e)
            # Update connection status if needed
            if self.connected:
                old_status = self.connected
                self.connected = False
                self.connection_quality = "unknown"
                if old_status != self.connected:
                    self._notify_connection_change()
            
            return {
                "error": str(e),
                "response": f"⚠️ Cloud connection error: {str(e)}. Please check your internet connection and API configuration.\n\nYou can click on the connection indicator to retry.",
                "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S")
            }
    
    def _get_cad_data(self) -> Dict[str, Any]:
        """Get CAD data from active document if available"""
        try:
            import FreeCAD
            
            if FreeCAD.ActiveDocument:
                doc = FreeCAD.ActiveDocument
                objects = doc.Objects
                
                # Basic document info
                doc_info = {
                    "name": doc.Name,
                    "object_count": len(objects),
                    "objects": []
                }
                
                # Get info about each object
                for obj in objects:
                    obj_info = {
                        "name": obj.Name,
                        "label": obj.Label,
                        "type": obj.TypeId
                    }
                    
                    # Add shape info if available
                    if hasattr(obj, 'Shape'):
                        bbox = obj.Shape.BoundBox
                        obj_info["dimensions"] = {
                            "x": bbox.XLength,
                            "y": bbox.YLength,
                            "z": bbox.ZLength
                        }
                        obj_info["volume"] = obj.Shape.Volume
                    
                    doc_info["objects"].append(obj_info)
                
                return doc_info
            else:
                return {"status": "no_active_document"}
                
        except Exception as e:
            print(f"Error getting CAD data: {e}")
            return {"status": "error", "message": str(e)}
    
    def _make_request(self, endpoint: str, payload: Dict[str, Any] = None, method: str = "POST", timeout: int = None) -> Dict[str, Any]:
        """Make a request to the cloud API"""
        url = f"{self.api_url}{endpoint}"
        
        # Set up headers with API key if available
        headers = {"Content-Type": "application/json"}
        if self.api_key:
            # Use X-API-Key as the primary authentication method
            # This is the standard expected by the cloud service
            headers["X-API-Key"] = self.api_key
            print("Using X-API-Key authentication")
        
        # Use provided timeout or default from config
        if timeout is None:
            cloud_config = self.load_cloud_config()
            timeout = cloud_config.get("connection_timeout", 10)
        
        try:
            print(f"Making {method} request to {url} with timeout {timeout}s")
            start_time = time.time()
            
            if method == "GET":
                response = requests.get(url, headers=headers, timeout=timeout)
            elif method == "POST":
                response = requests.post(url, json=payload, headers=headers, timeout=timeout)
            else:
                raise ValueError(f"Unsupported HTTP method: {method}")
            
            # Calculate latency
            end_time = time.time()
            latency = int((end_time - start_time) * 1000)
            self.last_latency = latency
            
            # Log response status
            print(f"Response status code: {response.status_code}, latency: {latency}ms")
            
            # Check if response is successful
            if response.status_code >= 400:
                print(f"Error response: {response.text}")
                
                # Handle specific error codes
                if response.status_code == 401:
                    # Authentication error - try to recover
                    print("Authentication error. Trying to recover...")
                    # Reload config to get fresh API key
                    cloud_config = self.load_cloud_config()
                    self.api_key = cloud_config.get("cloud_api_key", "dev_api_key_for_testing")
                    raise ValueError(f"Authentication failed: {response.text}. Updated API key for next attempt.")
                elif response.status_code == 404:
                    # Not found error
                    raise ValueError(f"Endpoint not found: {endpoint}")
                elif response.status_code == 422 and 'cad_data' in response.text:
                    raise ValueError("API requires cad_data field")
            
            response.raise_for_status()
            
            # Update connection quality based on latency
            if latency < 200:
                self.connection_quality = "excellent"
            elif latency < 500:
                self.connection_quality = "good"
            elif latency < 1000:
                self.connection_quality = "fair"
            else:
                self.connection_quality = "poor"
            
            # Parse response
            return response.json()
            
        except requests.exceptions.RequestException as e:
            self.last_error = str(e)
            print(f"Cloud API request failed: {str(e)}")
            if hasattr(e, 'response') and e.response is not None:
                print(f"Response status code: {e.response.status_code}")
                try:
                    print(f"Response content: {e.response.text}")
                except:
                    pass
            # Update connection status
            old_status = self.connected
            self.connected = False
            self.connection_quality = "unknown"
            
            # Notify listeners if status changed
            if old_status and not self.connected:
                self._notify_connection_change()
                
            raise Exception(f"Cloud API request failed: {str(e)}")
        
        except Exception as e:
            self.last_error = str(e)
            print(f"Unexpected error: {str(e)}")
            raise

    def add_connection_listener(self, callback):
        """Add a callback function to be notified of connection status changes"""
        if callback not in self.connection_listeners:
            self.connection_listeners.append(callback)
    
    def remove_connection_listener(self, callback):
        """Remove a connection status callback"""
        if callback in self.connection_listeners:
            self.connection_listeners.remove(callback)
    
    def _notify_connection_change(self):
        """Notify all listeners of connection status change"""
        for callback in self.connection_listeners:
            try:
                callback(self.connected, self.connection_quality, self.last_latency)
            except Exception as e:
                print(f"Error in connection listener callback: {str(e)}")
                
    def _save_config_to_file(self):
        """Save the current configuration to the config file"""
        try:
            if hasattr(self, 'config'):
                script_dir = os.path.dirname(os.path.realpath(__file__))
                config_file = os.path.join(script_dir, "cloud_config.json")
                
                print(f"Saving updated configuration to {config_file}")
                with open(config_file, "w") as f:
                    json.dump(self.config, f, indent=2)
                print("Configuration saved successfully")
                return True
            return False
        except Exception as e:
            print(f"Error saving configuration: {str(e)}")
            return False
            
    def _format_dfm_response(self, analysis_result, part_name):
        """Format DFM analysis results into a user-friendly response with numbered list for better readability"""
        try:
            # Check if this is the new DFM endpoint response format
            if 'violations' in analysis_result:
                return self._format_new_dfm_response(analysis_result, part_name)
            else:
                # Use the existing formatter for the old response format
                return self._format_legacy_dfm_response(analysis_result, part_name)
        except Exception as e:
            print(f"Error formatting DFM response: {str(e)}")
            return f"Error formatting DFM analysis results: {str(e)}"
    
    def _format_new_dfm_response(self, analysis_result, part_name):
        """Format DFM analysis results from the new endpoint structure"""
        try:
            # Start with part name as a header
            response_text = f"DFM Analysis for {part_name}:\n\n"
            
            violations = analysis_result.get('violations', [])
            
            # Start numbered list
            item_num = 1
            
            # Add overall assessment
            if not violations:
                response_text += f"{item_num}. [OK] Overall: Excellent manufacturability\n"
            else:
                # Calculate overall severity based on highest severity score
                max_severity = max([v.get('severity_score', 0) for v in violations]) if violations else 0
                
                if max_severity >= 90:
                    response_text += f"{item_num}. 🚨 Overall: Critical manufacturability issues detected\n"
                elif max_severity >= 70:
                    response_text += f"{item_num}. ⚠️ Overall: Significant manufacturability issues detected\n"
                else:
                    response_text += f"{item_num}. ℹ️ Overall: Minor manufacturability issues detected\n"
            item_num += 1
            
            # Add process information
            process_name = "Unknown"
            
            # Try to get process from the response first
            if 'manufacturing_process' in analysis_result:
                process = analysis_result['manufacturing_process']
                if process == 'fdm':
                    process_name = "FDM 3D Printing"
                elif process == 'cnc':
                    process_name = "CNC Machining"
                elif process == 'injection_molding':
                    process_name = "Injection Molding"
            # Fall back to checking violations text
            elif violations and len(violations) > 0 and 'issue' in violations[0]:
                issue_text = violations[0]['issue'].lower()
                if 'fdm' in issue_text or '3d print' in issue_text or 'printing' in issue_text:
                    process_name = "FDM 3D Printing"
                    process = "fdm"
                elif 'cnc' in issue_text or 'machin' in issue_text or 'mill' in issue_text:
                    process_name = "CNC Machining"
                    process = "cnc"
            
            response_text += f"{item_num}. Manufacturing Process: {process_name}\n"
            item_num += 1
            
            # Add violations with severity indicators
            response_text += f"\n{item_num}. Manufacturability Issues:\n"
            item_num += 1
            
            if not violations:
                response_text += "   ✓ No specific manufacturability issues detected.\n"
            else:
                for i, violation in enumerate(violations, 1):
                    # Get severity and issue details
                    severity_score = violation.get('severity_score', 0)
                    issue = violation.get('issue', 'Unknown issue')
                    suggestion = violation.get('suggestion', '')
                    
                    # Choose emoji based on severity score
                    if severity_score >= 90:
                        emoji = "🚨"  # Red alert for critical issues
                    elif severity_score >= 70:
                        emoji = "⚠️"  # Warning for moderate issues
                    else:
                        emoji = "ℹ️"  # Info for minor issues
                        
                    # Format the issue and suggestion
                    issue_text = f"{emoji} {issue}"
                    if suggestion:
                        issue_text += f" - {suggestion}"
                    
                    response_text += f"   {i}. {issue_text}\n"
            
            return response_text
        except Exception as e:
            print(f"Error formatting new DFM response: {str(e)}")
            return f"Error formatting DFM analysis results: {str(e)}"
    
    def _format_legacy_dfm_response(self, analysis_result, part_name):
        """Format DFM analysis results from the legacy endpoint structure"""
        try:
            # Check if this is a 3D printing request by looking at the original query
            original_query = ''
            if 'original_query' in analysis_result:
                original_query = analysis_result.get('original_query', '').lower()
                print(f"DEBUG: Found original query in response: '{original_query}'")
            elif 'query_intent' in analysis_result:
                original_query = analysis_result.get('query_intent', {}).get('original_query', '').lower()
            
            # Force process detection from the original message
            process = ''
            if '3d print' in original_query or 'printed' in original_query or 'printing' in original_query:
                process = 'fdm'
                print("DEBUG: Forcing 3D printing specific formatting based on query")
            elif 'cnc' in original_query or 'machin' in original_query or 'mill' in original_query:
                process = 'cnc'
                print("DEBUG: Forcing CNC machining specific formatting based on query")
            
            # If we couldn't detect from query, try to get from response
            if not process:
                process = analysis_result.get('manufacturing_process', '')
                if not process and 'request_metadata' in analysis_result:
                    process = analysis_result.get('request_metadata', {}).get('manufacturing_process', '')
            
            # Default to generic if no process is specified
            process_name = "Manufacturing"
            
            # Force 3D printing specific response for 3D printing queries
            if '3d print' in original_query or 'printed' in original_query or 'printing' in original_query:
                process = 'fdm'
                process_name = "3D Printing (FDM)"
                print("DEBUG: Forcing 3D printing specific response format")
            # Force CNC machining specific response for machining queries
            elif 'cnc' in original_query or 'machin' in original_query or 'mill' in original_query:
                process = 'cnc'
                process_name = "CNC Machining"
                print("DEBUG: Forcing CNC machining specific response format")
            # Otherwise use the detected process
            elif process == 'fdm':
                process_name = "3D Printing (FDM)"
            elif process == 'cnc':
                process_name = "CNC Machining"
            elif process == 'injection_molding':
                process_name = "Injection Molding"
                
            # Start with part name and process as a header
            response_text = f"{process_name} Analysis for {part_name}:\n\n"
            
            # Get manufacturability index and complexity
            mfg_index = analysis_result.get('manufacturability_index', 0)
            complexity = analysis_result.get('manufacturing_features', {}).get('complexity_rating', 'Unknown')
            
            # Start numbered list
            item_num = 1
            
            # Add overall assessment as item #1 with process-specific wording
            if process == 'fdm':
                if mfg_index > 90:
                    response_text += f"{item_num}. [OK] Overall: Excellent 3D printability (Score: {mfg_index}/100)\n"
                elif mfg_index > 70:
                    response_text += f"{item_num}. ✓ Overall: Good 3D printability (Score: {mfg_index}/100)\n"
                elif mfg_index > 50:
                    response_text += f"{item_num}. ⚠️ Overall: Fair 3D printability (Score: {mfg_index}/100)\n"
                else:
                    response_text += f"{item_num}. 🚨 Overall: Poor 3D printability (Score: {mfg_index}/100)\n"
            elif process == 'cnc':
                if mfg_index > 90:
                    response_text += f"{item_num}. [OK] Overall: Excellent machinability (Score: {mfg_index}/100)\n"
                elif mfg_index > 70:
                    response_text += f"{item_num}. ✓ Overall: Good machinability (Score: {mfg_index}/100)\n"
                elif mfg_index > 50:
                    response_text += f"{item_num}. ⚠️ Overall: Fair machinability (Score: {mfg_index}/100)\n"
                else:
                    response_text += f"{item_num}. 🚨 Overall: Poor machinability (Score: {mfg_index}/100)\n"
            else:
                if mfg_index > 90:
                    response_text += f"{item_num}. [OK] Overall: Excellent manufacturability (Score: {mfg_index}/100)\n"
                elif mfg_index > 70:
                    response_text += f"{item_num}. ✓ Overall: Good manufacturability (Score: {mfg_index}/100)\n"
                elif mfg_index > 50:
                    response_text += f"{item_num}. ⚠️ Overall: Fair manufacturability (Score: {mfg_index}/100)\n"
                else:
                    response_text += f"{item_num}. 🚨 Overall: Poor manufacturability (Score: {mfg_index}/100)\n"
            item_num += 1
            
            # Add complexity as item #2 with process-specific context
            if process == 'fdm':
                response_text += f"{item_num}. Print Complexity: {complexity}\n"
                item_num += 1
                
                # Add 3D printing specific recommendations
                response_text += f"{item_num}. 3D Printing Recommendations:\n"
                response_text += f"   • Recommended material: PLA or ABS\n"
                response_text += f"   • Layer height: 0.2mm\n"
                response_text += f"   • Infill: 20-30%\n"
                if complexity.lower() == 'high':
                    response_text += f"   • Supports: Required\n"
                else:
                    response_text += f"   • Supports: Likely not needed\n"
            elif process == 'cnc':
                response_text += f"{item_num}. Machining Complexity: {complexity}\n"
                item_num += 1
                
                # Add CNC machining specific recommendations
                response_text += f"{item_num}. CNC Machining Recommendations:\n"
                response_text += f"   • Recommended material: Aluminum or mild steel\n"
                response_text += f"   • Minimum tool diameter: 3mm\n"
                if complexity.lower() == 'high':
                    response_text += f"   • Setup: Multi-axis machining recommended\n"
                else:
                    response_text += f"   • Setup: Standard 3-axis machining\n"
            else:
                response_text += f"{item_num}. Complexity: {complexity}\n"
            item_num += 1
            
            # Add design issues with severity indicators
            design_issues = analysis_result.get('design_issues', [])
            
            # For 3D printing queries, add specific 3D printing issues if none exist
            if process == 'fdm' and not design_issues:
                # Add some generic 3D printing considerations
                if analysis_result.get('dimensions', {}).get('z', 0) < 1.0:
                    design_issues.append("Layer height too thin - minimum 0.1mm recommended for FDM printing")
                elif analysis_result.get('dimensions', {}).get('z', 0) > 200:
                    design_issues.append("Model height exceeds typical build volume of many desktop 3D printers")
                
                # Add some generic 3D printing recommendations
                design_issues.append("Consider using PLA for easiest printing or ABS for better durability")
                design_issues.append("Print with 20% infill for a good balance of strength and material usage")
                design_issues.append("Orient the part for minimal support requirements")
            
            # Get the manufacturing process from the request or response
            process = analysis_result.get('manufacturing_process', '')
            if not process and 'request_metadata' in analysis_result:
                process = analysis_result.get('request_metadata', {}).get('manufacturing_process', '')
            
            # Process-specific section title
            if process == 'fdm':
                response_text += f"\n{item_num}. 3D Printing Considerations:\n"
            elif process == 'cnc':
                response_text += f"\n{item_num}. CNC Machining Considerations:\n"
            else:
                response_text += f"\n{item_num}. Manufacturability Issues:\n"
            item_num += 1
            
            if not design_issues:
                if process == 'fdm':
                    response_text += "   ✓ No specific 3D printing issues detected. The model appears to be printable.\n"
                    response_text += "   ℹ️ Recommended print settings: Layer height: 0.2mm, Infill: 20%, Support: No\n"
                elif process == 'cnc':
                    response_text += "   ✓ No specific CNC machining issues detected. The model appears to be machinable.\n"
                else:
                    response_text += "   ✓ No specific manufacturability issues detected.\n"
            else:
                for i, issue in enumerate(design_issues, 1):
                    # Determine severity based on keywords
                    severity = "info"
                    issue_text = issue.lower()
                    
                    if any(kw in issue_text for kw in ["critical", "severe", "cannot", "impossible", "fail"]):
                        severity = "critical"
                        emoji = "🚨"  # Red alert for critical issues
                    elif any(kw in issue_text for kw in ["warning", "recommend", "should", "consider", "improve"]):
                        severity = "warning"
                        emoji = "⚠️"  # Warning for moderate issues
                    else:
                        emoji = "ℹ️"  # Info for minor issues
                        
                    # Add process-specific context to generic issues
                    if process == 'fdm':
                        # Add 3D printing context to generic issues
                        if "thin" in issue_text or "thickness" in issue_text:
                            issue = f"{issue} (Critical for 3D printing - may cause print failure)"
                        elif "overhang" in issue_text:
                            issue = f"{issue} (May require supports during printing)"
                        elif "sharp" in issue_text or "corner" in issue_text:
                            issue = f"{issue} (Consider adding fillets for better print quality)"
                    elif process == 'cnc':
                        # Add CNC machining context to generic issues
                        if "internal corner" in issue_text or "sharp corner" in issue_text:
                            issue = f"{issue} (Not achievable with standard CNC tooling)"
                        elif "undercut" in issue_text:
                            issue = f"{issue} (May require multi-axis machining)"
                    
                    response_text += f"   {i}. {emoji} {issue}\n"
            
            # Add material recommendations
            materials = analysis_result.get('material_suggestions', [])
            if materials:
                response_text += f"\n{item_num}. Recommended Materials:\n"
                item_num += 1
                for i, material in enumerate(materials, 1):
                    response_text += f"   {i}. {material}\n"
            
            # Add process recommendations
            processes = analysis_result.get('process_recommendations', [])
            if processes:
                response_text += f"\n{item_num}. Recommended Manufacturing Processes:\n"
                for i, process in enumerate(processes, 1):
                    response_text += f"   {i}. {process}\n"
            
            return response_text
        except Exception as e:
            print(f"Error formatting DFM response: {str(e)}")
            return f"Error formatting DFM analysis results: {str(e)}"
    
    def get_connection_info(self):
        """Get detailed connection information"""
        return {
            "connected": self.connected,
            "quality": self.connection_quality,
            "latency": self.last_latency,
            "last_check": self.last_check_time,
            "last_error": self.last_error
        }

# Singleton cloud client instance
_cloud_client_instance = None

def get_cloud_client() -> CloudApiClient:
    """Get the singleton cloud client instance"""
    global _cloud_client_instance
    if _cloud_client_instance is None:
        _cloud_client_instance = CloudApiClient()
    return _cloud_client_instance

class StandaloneCoPilot(QtWidgets.QWidget):
    """Standalone Manufacturing Co-Pilot with built-in singleton pattern"""
    
    def __init__(self, parent=None):
        """Initialize the standalone co-pilot"""
        super().__init__(parent)
        
        # Connect to cloud
        self.cloud_client = get_cloud_client()
        self.cloud_connected = self.cloud_client.connected
        
        # Initialize NL CAD editor
        self.nl_cad_editor = NaturalLanguageCADEditor(self.cloud_client)
        print("Natural Language CAD Editor initialized")
        
        # Initialize Manufacturing Feature Manager for cloud features
        self.mfg_feature_manager = ManufacturingFeatureManager()
        print("Manufacturing Feature Manager initialized for cloud services")
        
        # Set up the UI
        self.setup_ui()
        
        # Register as connection listener
        self.cloud_client.add_connection_listener(self.update_status)
        
        # Update cloud status in UI with initial values
        conn_info = self.cloud_client.get_connection_info()
        self.update_status(
            conn_info["connected"],
            conn_info["quality"],
            conn_info["latency"]
        )
        
        # Set up periodic connection check
        self.connection_timer = QtCore.QTimer()
        self.connection_timer.timeout.connect(self.check_connection)
        self.connection_timer.start(60000)  # Check every minute
    
