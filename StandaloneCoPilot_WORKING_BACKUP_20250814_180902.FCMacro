    def on_dfm_clicked(self):
        """Handle DFM analysis button click with advanced options"""
        self.add_system_message("Preparing advanced DFM analysis...")
        try:
            # Check if there's an active document
            if not FreeCAD.ActiveDocument:
                self.add_system_message("No active document found")
                self.add_assistant_message("Please open or create a model before running DFM analysis.")
                return
            
            # Create dialog for advanced DFM options
            dialog = QtWidgets.QDialog(self)
            dialog.setWindowTitle("Advanced DFM Analysis Options")
            dialog.setMinimumWidth(400)
            
            # Create form layout for options
            form_layout = QtWidgets.QFormLayout(dialog)
            
            # Manufacturing process selection
            process_combo = QtWidgets.QComboBox()
            process_combo.addItems([
                "3D Printing (FDM)", 
                "CNC Machining", 
                "Injection Molding",
                "Sheet Metal Forming",
                "Die Casting"
            ])
            form_layout.addRow("Manufacturing Process:", process_combo)
            
            # Material selection
            material_combo = QtWidgets.QComboBox()
            material_combo.addItems([
                "PLA", "ABS", "Nylon",  # 3D Printing materials
                "Aluminum", "Steel", "Brass",  # Metals
                "Polypropylene", "ABS", "Polycarbonate"  # Injection molding materials
            ])
            form_layout.addRow("Material:", material_combo)
            
            # Production volume
            volume_spin = QtWidgets.QSpinBox()
            volume_spin.setRange(1, 1000000)
            volume_spin.setValue(100)
            volume_spin.setSingleStep(10)
            form_layout.addRow("Production Volume:", volume_spin)
            
            # Advanced analysis checkbox
            advanced_check = QtWidgets.QCheckBox("Enable advanced analysis")
            advanced_check.setChecked(True)
            advanced_check.setToolTip("Includes detailed cost analysis and alternative process recommendations")
            form_layout.addRow("", advanced_check)
            
            # Add buttons
            button_box = QtWidgets.QDialogButtonBox(
                QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
            )
            button_box.accepted.connect(dialog.accept)
            button_box.rejected.connect(dialog.reject)
            form_layout.addRow(button_box)
            
            # Show dialog and get results
            if dialog.exec_() != QtWidgets.QDialog.Accepted:
                self.add_system_message("DFM analysis cancelled")
                return
            
            # Get selected options
            process_text = process_combo.currentText()
            material_text = material_combo.currentText().lower()
            production_volume = volume_spin.value()
            advanced_analysis = advanced_check.isChecked()
            
            # Map process text to process code
            process_map = {
                "3D Printing (FDM)": "3d_printing",
                "CNC Machining": "cnc_machining",
                "Injection Molding": "injection_molding",
                "Sheet Metal Forming": "sheet_metal",
                "Die Casting": "die_casting"
            }
            process_code = process_map.get(process_text, "3d_printing")
            
            # Update status
            self.cloud_feature_status.setText("Processing advanced DFM analysis...")
            self.add_system_message(f"Running advanced DFM analysis for {process_text} with {material_text} material...")
            
            # Run DFM analysis using the manufacturing feature manager with advanced options
            result = self.mfg_feature_manager.analyze_dfm(
                manufacturing_process=process_code,
                material=material_text,
                production_volume=production_volume,
                advanced_analysis=advanced_analysis
            )
            
            if result and result.get('success'):
                print("DEBUG: DFM analysis successful, processing UI display")
                print(f"DEBUG: Result keys: {list(result.keys())}")
                
                # Get the data from the result
                data = result.get('data', {})
                print(f"DEBUG: Data keys in result: {list(data.keys())}")
                
                # Try to get data from the transformed format first
                score = data.get('manufacturability_score', 0)
                issues = data.get('issues', [])
                recommendations = data.get('recommendations', [])
                report_text = data.get('report_text', '')
                
                # If we don't have a score, try to get it from the original format
                if score == 0 and 'overall_manufacturability_score' in data:
                    score = data.get('overall_manufacturability_score', 0)
                    print("DEBUG: Using overall_manufacturability_score from transformed data")
                    
                # If we don't have issues, try to get them from the original format
                if not issues and 'manufacturing_issues' in data:
                    issues = data.get('manufacturing_issues', [])
                    print(f"DEBUG: Using manufacturing_issues from transformed data: {issues}")
                    
                # If we don't have issues, try to get them from design_issues
                print(f"DEBUG: Before design_issues check - issues length: {len(issues)}")
                if not issues and 'design_issues' in data:
                    design_issues = data.get('design_issues', [])
                    print(f"DEBUG: Found {len(design_issues)} design_issues: {design_issues}")
                    
                    # Convert design_issues to our format
                    for issue in design_issues:
                        if isinstance(issue, str):
                            print(f"DEBUG: Converting string issue: {issue}")
                            issues.append({
                                'severity': 'medium',
                                'description': issue
                            })
                        elif isinstance(issue, dict):
                            print(f"DEBUG: Adding dict issue: {issue}")
                            issues.append(issue)
                    
                    print(f"DEBUG: Converted {len(issues)} design_issues to issues format")
                elif 'design_issues' in data:
                    print(f"DEBUG: Skipping design_issues conversion - already have {len(issues)} issues")
                else:
                    print("DEBUG: No design_issues found in data")
                    
                # If we don't have recommendations, try to get them from the original format
                if not recommendations and 'expert_recommendations' in data:
                    recommendations = data.get('expert_recommendations', [])
                    print("DEBUG: Using expert_recommendations from transformed data")
                
                # Store the analysis data for visualization (CRITICAL FIX)
                self.last_analysis = {
                    'manufacturing_issues': issues,
                    'design_issues': data.get('design_issues', []),
                    'overall_manufacturability_score': score,
                    'overall_rating': data.get('overall_rating', ''),
                    'primary_process': data.get('primary_process', ''),
                    'alternative_processes': data.get('alternative_processes', []),
                    'expert_recommendations': recommendations
                }
                print(f"DEBUG: Set last_analysis with {len(issues)} manufacturing_issues for visualization")
                
                print(f"DEBUG: UI received score: {score}")
                print(f"DEBUG: UI received {len(issues)} issues")
                print(f"DEBUG: UI received {len(recommendations)} recommendations")
                print(f"DEBUG: UI received report_text of length {len(report_text)}")
                if report_text:
                    print(f"DEBUG: First 100 chars of report_text: {report_text[:100]}")
                else:
                    print("DEBUG: No report_text received, generating from available data")
                    # Generate comprehensive report text from all available data
                    report_lines = []
                    report_lines.append("=== DESIGN FOR MANUFACTURING ANALYSIS ===")
                    report_lines.append(f"Manufacturability Score: {score}/100")
                    
                    # Add overall rating if available
                    overall_rating = data.get('overall_rating', '')
                    if overall_rating:
                        report_lines.append(f"Overall Rating: {overall_rating}")
                    report_lines.append("")
                    
                    # Add geometry summary if available
                    geometry_summary = data.get('geometry_summary', {})
                    if geometry_summary:
                        report_lines.append("--- Geometry Analysis ---")
                        if 'volume' in geometry_summary:
                            report_lines.append(f"Volume: {geometry_summary['volume']:.2f} mm³")
                        if 'faces' in geometry_summary:
                            report_lines.append(f"Faces: {geometry_summary['faces']}")
                        if 'holes' in geometry_summary:
                            report_lines.append(f"Holes: {geometry_summary['holes']}")
                        if 'fillets' in geometry_summary:
                            report_lines.append(f"Fillets: {geometry_summary['fillets']}")
                        report_lines.append("")
                    
                    # Add issues with red color (HTML formatting)
                    report_lines.append(f"--- Manufacturing Issues ({len(issues)}) ---")
                    # Apply red color to ALL manufacturing issues text
                    if issues:
                        for issue in issues:
                            if isinstance(issue, dict):
                                description = issue.get('description', 'Unknown issue')
                                severity = issue.get('severity', 'medium')
                                recommendation = issue.get('recommendation', '')
                                
                                # Add severity indicator with RED COLOR
                                if severity == 'critical':
                                    report_lines.append(f"<span style='color: #ff4444;'>❌ {description}</span>")
                                elif severity == 'high':
                                    report_lines.append(f"<span style='color: #ff4444;'>⚠️ {description}</span>")
                                else:
                                    report_lines.append(f"<span style='color: #ff4444;'>ℹ️ {description}</span>")
                                    
                                if recommendation:
                                    report_lines.append(f"<span style='color: #ff4444;'>   → {recommendation}</span>")
                            else:
                                report_lines.append(f"<span style='color: #ff4444;'>• {issue}</span>")
                    else:
                        report_lines.append("No manufacturability issues found.")
                    report_lines.append("")
                    
                    # Add cost analysis if available
                    cost_analysis = data.get('cost_analysis', {})
                    if cost_analysis:
                        report_lines.append("--- Cost Analysis ---")
                        if 'estimated_cost_per_part' in cost_analysis:
                            cost = cost_analysis['estimated_cost_per_part']
                            if isinstance(cost, dict):
                                if 'inr' in cost:
                                    report_lines.append(f"Estimated Cost: ₹{cost['inr']:.2f} per part")
                                if 'usd' in cost:
                                    report_lines.append(f"Estimated Cost (USD): ${cost['usd']:.2f} per part")
                                    report_lines.append(f"Exchange Rate: 1 USD = ₹83 (approx)")
                            else:
                                report_lines.append(f"Estimated Cost: ₹{cost:.2f} per part")
                        
                        if 'material_cost' in cost_analysis:
                            report_lines.append(f"Material Cost: ₹{cost_analysis['material_cost']:.2f}")
                        if 'processing_cost' in cost_analysis:
                            report_lines.append(f"Processing Cost: ₹{cost_analysis['processing_cost']:.2f}")
                        if 'tooling_cost' in cost_analysis:
                            report_lines.append(f"Tooling Cost: ₹{cost_analysis['tooling_cost']:.2f}")
                        report_lines.append("")
                    
                    # Add process recommendations
                    process_recs = data.get('process_recommendations', [])
                    if process_recs:
                        report_lines.append("--- Process Recommendations ---")
                        for proc in process_recs:
                            if isinstance(proc, dict):
                                process_name = proc.get('process', 'Unknown Process')
                                suitability = proc.get('suitability_score', 'N/A')
                                cost = proc.get('estimated_cost', 'N/A')
                                report_lines.append(f"• {process_name}: Suitability {suitability}/100, Cost: {cost}")
                                
                                advantages = proc.get('advantages', [])
                                if advantages:
                                    for adv in advantages:
                                        report_lines.append(f"  ✓ {adv}")
                                        
                                limitations = proc.get('limitations', [])
                                if limitations:
                                    for lim in limitations:
                                        report_lines.append(f"  ⚠ {lim}")
                            else:
                                report_lines.append(f"• {proc}")
                        report_lines.append("")
                    
                    # Add AI insights if available (from hybrid analysis)
                    ai_insights = data.get('ai_insights', {})
                    if ai_insights:
                        report_lines.append("--- AI Insights ---")
                        if ai_insights.get('ai_analysis_available'):
                            complexity = ai_insights.get('complexity_rating', 'Unknown')
                            moldability = ai_insights.get('moldability_score', 0)
                            report_lines.append(f"Complexity Rating: {complexity}")
                            report_lines.append(f"Moldability Score: {moldability}/10")
                            report_lines.append("AI Analysis: Available")
                        else:
                            report_lines.append("AI Analysis: Not Available")
                            note = ai_insights.get('note', '')
                            if note:
                                report_lines.append(f"Note: {note}")
                        report_lines.append("")
                    
                    # Add Indian market context
                    indian_context = data.get('indian_market_context', {})
                    if indian_context:
                        report_lines.append("--- Indian Market Context ---")
                        if 'suppliers' in indian_context:
                            suppliers = indian_context['suppliers']
                            if suppliers:
                                report_lines.append("Recommended Suppliers:")
                                for supplier in suppliers:
                                    if isinstance(supplier, dict):
                                        name = supplier.get('name', 'Unknown')
                                        location = supplier.get('location', 'Unknown')
                                        specialization = supplier.get('specialization', '')
                                        report_lines.append(f"  • {name} ({location}) - {specialization}")
                                    else:
                                        report_lines.append(f"  • {supplier}")
                        
                        if 'lead_times' in indian_context:
                            lead_times = indian_context['lead_times']
                            report_lines.append(f"Typical Lead Times: {lead_times}")
                        
                        if 'market_rates' in indian_context:
                            rates = indian_context['market_rates']
                            if isinstance(rates, dict):
                                for process, rate in rates.items():
                                    report_lines.append(f"Market Rate ({process}): {rate}")
                            else:
                                report_lines.append(f"Market Rates: {rates}")
                        
                        if 'quality_standards' in indian_context:
                            standards = indian_context['quality_standards']
                            report_lines.append(f"Quality Standards: {standards}")
                        report_lines.append("")
                    
                    # Add analysis summary if available (from hybrid analysis)
                    analysis_summary = data.get('analysis_summary', {})
                    if analysis_summary:
                        report_lines.append("--- Analysis Summary ---")
                        primary = analysis_summary.get('primary_analysis', '')
                        if primary:
                            report_lines.append(f"Primary Analysis: {primary}")
                        
                        ai_enhancement = analysis_summary.get('ai_enhancement', '')
                        if ai_enhancement:
                            report_lines.append(f"AI Enhancement: {ai_enhancement}")
                        
                        cost_analysis = analysis_summary.get('cost_analysis', '')
                        if cost_analysis:
                            report_lines.append(f"Cost Analysis: {cost_analysis}")
                        
                        confidence = analysis_summary.get('confidence_level', '')
                        if confidence:
                            report_lines.append(f"Confidence Level: {confidence}")
                        report_lines.append("")
                    
                    # Add alternative materials from cloud AI (if available)
                    alt_materials = data.get('alternative_materials', [])
                    if alt_materials:
                        report_lines.append("--- AI-Recommended Alternative Materials ---")
                        for material in alt_materials:
                            report_lines.append(f"• {material}")
                        report_lines.append("")
                    
                    # Add alternative processes from cloud AI (if available)
                    alt_processes = data.get('alternative_processes_ai', [])
                    if alt_processes:
                        report_lines.append("--- AI-Recommended Alternative Processes ---")
                        for process in alt_processes:
                            report_lines.append(f"• {process}")
                        report_lines.append("")
                    
                    # Add expert recommendations
                    if recommendations:
                        report_lines.append("--- Expert Recommendations ---")
                        for rec in recommendations:
                            if isinstance(rec, dict):
                                description = rec.get('description', 'Unknown recommendation')
                                priority = rec.get('priority', '')
                                if priority:
                                    report_lines.append(f"• [{priority}] {description}")
                                else:
                                    report_lines.append(f"• {description}")
                            else:
                                report_lines.append(f"• {rec}")
                    
                    report_text = "\n".join(report_lines)
                    print(f"DEBUG: Generated comprehensive report text of length {len(report_text)}")
                    
                    # Apply red color to Manufacturing Issues section for HTML display
                    report_text_with_color = report_text.replace('--- Manufacturing Issues', '--- <span style="color: #ff4444; font-weight: bold;">Manufacturing Issues')
                    report_text_with_color = report_text_with_color.replace(') ---', ') ---</span>')
                    print(f"DEBUG: Applied red color styling to Manufacturing Issues section")
                    
                    data['report_text'] = report_text_with_color
                
                # Create a formatted message
                message = f"<b>Advanced DFM Analysis Results</b><br>"
                message += f"<b>Process:</b> {process_text}<br>"
                message += f"<b>Material:</b> {material_text}<br>"
                message += f"<b>Production Volume:</b> {production_volume} units<br>"
                message += f"<b>Manufacturability Score:</b> {score}/100<br><br>"
                
                # Check if we have a pre-formatted report text
                report_text = data.get('report_text', '')
                if report_text:
                    print(f"DEBUG: Processing report_text for display, length: {len(report_text)}")
                    # Convert the report text to HTML with red color for Manufacturing Issues
                    report_html = report_text.replace('\n', '<br>')
                    # Apply red color to Manufacturing Issues section
                    report_html = report_html.replace('--- Manufacturing Issues', '<span style="color: #ff4444; font-weight: bold;">--- Manufacturing Issues')
                    report_html = report_html.replace(') ---', ') ---</span>')
                    print(f"DEBUG: HTML report length: {len(report_html)}")
                    message += f"<div style='background-color: #2d2d2d; color: #ffffff; padding: 10px; border-radius: 5px;'>{report_html}</div><br>"
                    print("DEBUG: Added report HTML to message")
                    
                    # Also print the report to the console for debugging
                    print("\n=== DFM REPORT TEXT ===\n")
                    print(report_text)
                    print("\n=== END DFM REPORT TEXT ===\n")
                else:
                    print("DEBUG: No report_text available for display")
                
                # Issues are already displayed in the report above, no need to duplicate them here
                
                # Get cost analysis if advanced analysis was enabled
                if advanced_analysis:
                    cost_analysis = self.mfg_feature_manager.get_cost_analysis()
                    if cost_analysis:
                        message += "<b>Cost Analysis:</b><br>"
                        total_cost = cost_analysis.get('total_cost', 0)
                        message += f"Total Cost: ₹{total_cost:.2f}<br>"
                        
                        # Show cost breakdown
                        breakdown = cost_analysis.get('cost_breakdown', {})
                        if breakdown:
                            message += "<u>Cost Breakdown:</u><br>"
                            for category, amount in breakdown.items():
                                message += f"- {category}: ${float(amount):.2f}<br>"
                            message += "<br>"
                    
                    # Get alternative processes
                    alt_processes = self.mfg_feature_manager.get_alternative_processes()
                    if alt_processes:
                        message += "<b>Alternative Manufacturing Processes:</b><br>"
                        for proc in alt_processes:
                            proc_name = proc.get('process_name', 'Unknown')
                            suitability = proc.get('suitability_score', 0)
                            est_cost = proc.get('estimated_cost', 0)
                            # Convert cost to INR if it's in USD
                            if isinstance(est_cost, str) and '$' in est_cost:
                                # Extract numeric value and convert
                                import re
                                usd_match = re.search(r'\$([\d.]+)', est_cost)
                                if usd_match:
                                    usd_value = float(usd_match.group(1))
                                    inr_value = usd_value * 83
                                    cost_display = f"₹{inr_value:.2f}"
                                else:
                                    cost_display = est_cost.replace('$', '₹')
                            elif isinstance(est_cost, (int, float)):
                                cost_display = f"₹{est_cost:.2f}"
                            else:
                                cost_display = str(est_cost).replace('$', '₹')
                            message += f"- {proc_name}: Suitability {suitability}/100, Est. Cost: {cost_display}<br>"
                        message += "<br>"
                
                # Display expert recommendations
                if recommendations:
                    message += "<b>Expert Recommendations:</b><br>"
                    for i, rec in enumerate(recommendations):
                        message += f"{i+1}. {rec}<br>"
                
                # Add the formatted message to chat
                print("DEBUG: Adding DFM analysis results to chat")
                self.add_assistant_message(message)
                print("DEBUG: DFM analysis results added to chat")
                
                # Don't automatically visualize - only when user clicks "Show Problem Areas" button
                print("DEBUG: Using direct visualization to bypass cloud_integration issues")
                print(f"DEBUG: Found {len(issues)} issues to visualize")
                if len(issues) > 0:
                    print(f"DEBUG: First issue: {issues[0]}")
                    for i, issue in enumerate(issues):
                        title = issue.get('title', 'Unknown issue')
                        location = issue.get('location', 'Unknown location')
                        print(f"DEBUG: Issue {i+1}: {title[:50]}... at location {location}")
                self.add_system_message("DFM analysis complete. Issues visualized in the 3D view.")
                
                # SHOW PROBLEM AREAS BUTTONS AFTER SUCCESSFUL DFM ANALYSIS (RESTORED WORKFLOW)
                print(f"DEBUG: Final button visibility check - issues length: {len(issues)}")
                print(f"DEBUG: Issues content: {issues}")
                if issues:  # Only show if there are actual issues to visualize
                    print("DEBUG: SHOWING Problem Areas button - issues found!")
                    self.show_problems_button.setVisible(True)
                    self.add_system_message("[OK] Click 'Show Problem Areas' to highlight manufacturing issues with colored overlays.")
                else:
                    print("DEBUG: NOT showing Problem Areas button - no issues found")
                    self.add_system_message("ℹ️ No manufacturing issues found - no problem areas to highlight.")
            else:
                error_msg = result.get('error', 'Unknown error during DFM analysis') if result else "Failed to get DFM analysis results"
                self.add_system_message(f"Error: {error_msg}")
                self.add_assistant_message("I couldn't complete the DFM analysis. Please check if your model is valid and try again.")
        except Exception as e:
            self.add_system_message(f"Error during DFM analysis: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status
            self.cloud_feature_status.setText("Ready")
    
    def on_cost_clicked(self):
        """Handle cost estimation button click with enhanced options"""
        self.add_system_message("Preparing cost estimation...")
        try:
            # Check if there's an active document
            if not FreeCAD.ActiveDocument:
                self.add_system_message("No active document found")
                self.add_assistant_message("Please open or create a model before running cost estimation.")
                return
            
            # Create dialog for cost estimation options
            dialog = QtWidgets.QDialog(self)
            dialog.setWindowTitle("Advanced Cost Estimation Options")
            dialog.setMinimumWidth(400)
            
            # Create form layout for options
            form_layout = QtWidgets.QFormLayout(dialog)
            
            # Manufacturing process selection
            process_combo = QtWidgets.QComboBox()
            process_combo.addItems([
                "3D Printing (FDM)", 
                "CNC Machining", 
                "Injection Molding",
                "Sheet Metal Forming",
                "Die Casting"
            ])
            form_layout.addRow("Manufacturing Process:", process_combo)
            
            # Material selection
            material_combo = QtWidgets.QComboBox()
            material_combo.addItems([
                "PLA", "ABS", "Nylon",  # 3D Printing materials
                "Aluminum", "Steel", "Brass",  # Metals
                "Polypropylene", "ABS", "Polycarbonate"  # Injection molding materials
            ])
            form_layout.addRow("Material:", material_combo)
            
            # Production volume
            volume_spin = QtWidgets.QSpinBox()
            volume_spin.setRange(1, 1000000)
            volume_spin.setValue(100)
            volume_spin.setSingleStep(10)
            form_layout.addRow("Production Volume:", volume_spin)
            
            # Region selection
            region_combo = QtWidgets.QComboBox()
            region_combo.addItems(["Global", "North America", "Europe", "Asia", "Other"])
            form_layout.addRow("Region:", region_combo)
            
            # Add buttons
            button_box = QtWidgets.QDialogButtonBox(
                QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
            )
            button_box.accepted.connect(dialog.accept)
            button_box.rejected.connect(dialog.reject)
            form_layout.addRow(button_box)
            
            # Show dialog and get results
            if dialog.exec_() != QtWidgets.QDialog.Accepted:
                self.add_system_message("Cost estimation cancelled")
                return
            
            # Get selected options
            process_text = process_combo.currentText()
            material_text = material_combo.currentText().lower()
            production_volume = volume_spin.value()
            region_text = region_combo.currentText().lower().replace(" ", "_")
            
            # Map process text to process code
            process_map = {
                "3D Printing (FDM)": "3d_printing",
                "CNC Machining": "cnc_machining",
                "Injection Molding": "injection_molding",
                "Sheet Metal Forming": "sheet_metal",
                "Die Casting": "die_casting"
            }
            process_code = process_map.get(process_text, "3d_printing")
            
            # Update status
            self.cloud_feature_status.setText("Processing cost estimation...")
            self.add_system_message(f"Running cost estimation for {process_text} with {material_text} material...")
            
            # Run cost estimation using the manufacturing feature manager with advanced options
            result = self.mfg_feature_manager.estimate_cost(
                manufacturing_process=process_code,
                material=material_text,
                quantity=production_volume,
                region=region_text
            )
            
            if result and result.get('success'):
                # Try to get enhanced cost analysis from DFM engine first
                cost_analysis = self.mfg_feature_manager.get_cost_analysis()
                
                if cost_analysis:
                    # Use the enhanced cost analysis from DFM engine
                    total_cost = cost_analysis.get('total_cost', 0)
                    currency = cost_analysis.get('currency', 'USD')
                    breakdown = cost_analysis.get('cost_breakdown', {})
                    optimization = cost_analysis.get('optimization_suggestions', [])
                else:
                    # Fall back to standard cost estimation
                    total_cost = result.get('total_cost', 0)
                    currency = result.get('currency', 'USD')
                    breakdown = result.get('cost_breakdown', {})
                    optimization = result.get('optimization_suggestions', [])
                
                # Create a formatted message
                message = f"<b>Cost Estimation Results</b><br>"
                message += f"<b>Total Estimated Cost:</b> {currency} {total_cost:.2f}<br><br>"
                
                if breakdown:
                    message += "<b>Cost Breakdown:</b><br>"
                    for category, amount in breakdown.items():
                        message += f"{category}: {currency} {float(amount):.2f}<br>"
                    message += "<br>"
                
                if optimization:
                    message += "<b>Cost Optimization Suggestions:</b><br>"
                    for i, suggestion in enumerate(optimization):
                        message += f"{i+1}. {suggestion}<br>"
                
                # Add the formatted message to chat
                self.add_assistant_message(message)
            else:
                error_msg = result.get('error', 'Unknown error during cost estimation') if result else "Failed to get cost estimation results"
                self.add_system_message(f"Error: {error_msg}")
                self.add_assistant_message("I couldn't complete the cost estimation. Please check if your model is valid and try again.")
        except Exception as e:
            self.add_system_message(f"Error during cost estimation: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status
            self.cloud_feature_status.setText("Ready")
    
    def on_tools_clicked(self):
        """Handle tool recommendations button click with enhanced options"""
        self.add_system_message("Preparing tool recommendations...")
        try:
            # Check if there's an active document
            if not FreeCAD.ActiveDocument:
                self.add_system_message("No active document found")
                self.add_assistant_message("Please open or create a model before running tool recommendations.")
                return
            
            # Create dialog for tool recommendation options
            dialog = QtWidgets.QDialog(self)
            dialog.setWindowTitle("Advanced Tool Recommendation Options")
            dialog.setMinimumWidth(400)
            
            # Create form layout for options
            form_layout = QtWidgets.QFormLayout(dialog)
            
            # Manufacturing process selection (focus on machining processes)
            process_combo = QtWidgets.QComboBox()
            process_combo.addItems([
                "CNC Machining", 
                "Milling",
                "Turning",
                "Drilling",
                "EDM"
            ])
            form_layout.addRow("Manufacturing Process:", process_combo)
            
            # Material selection
            material_combo = QtWidgets.QComboBox()
            material_combo.addItems([
                "Aluminum", "Steel", "Stainless Steel", "Brass", "Titanium", 
                "Plastic", "Composite", "Wood"
            ])
            form_layout.addRow("Material:", material_combo)
            
            # Machine type selection
            machine_combo = QtWidgets.QComboBox()
            machine_combo.addItems([
                "3-Axis CNC", "5-Axis CNC", "CNC Lathe", "CNC Mill", "Universal"
            ])
            form_layout.addRow("Machine Type:", machine_combo)
            
            # Add buttons
            button_box = QtWidgets.QDialogButtonBox(
                QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
            )
            button_box.accepted.connect(dialog.accept)
            button_box.rejected.connect(dialog.reject)
            form_layout.addRow(button_box)
            
            # Show dialog and get results
            if dialog.exec_() != QtWidgets.QDialog.Accepted:
                self.add_system_message("Tool recommendations cancelled")
                return
            
            # Get selected options
            process_text = process_combo.currentText()
            material_text = material_combo.currentText().lower()
            machine_type = machine_combo.currentText().lower().replace("-", "_").replace(" ", "_")
            
            # Map process text to process code
            process_map = {
                "CNC Machining": "cnc_machining",
                "Milling": "milling",
                "Turning": "turning",
                "Drilling": "drilling",
                "EDM": "edm"
            }
            process_code = process_map.get(process_text, "cnc_machining")
            
            # Update status
            self.cloud_feature_status.setText("Processing tool recommendations...")
            self.add_system_message(f"Running tool recommendations for {process_text} with {material_text} material...")
            
            # Run tool recommendations using the manufacturing feature manager with advanced options
            result = self.mfg_feature_manager.recommend_tools(
                manufacturing_process=process_code,
                material=material_text,
                machine_type=machine_type
            )
            
            if result and result.get('success'):
                # Get data from the result
                data = result.get('data', {})
                tools = data.get('tools', [])
                machine_type_result = data.get('machine_type', machine_type)
                material_result = data.get('material', material_text)
                
                # Create a formatted message
                message = f"<b>Advanced Tool Recommendations</b><br>"
                message += f"<b>Process:</b> {process_text}<br>"
                message += f"<b>Machine Type:</b> {machine_type_result}<br>"
                message += f"<b>Material:</b> {material_result}<br><br>"
                
                if tools:
                    message += "<b>Recommended Tools:</b><br>"
                    for i, tool in enumerate(tools):
                        tool_name = tool.get('name', f"Tool {i+1}")
                        tool_type = tool.get('type', 'Unknown')
                        diameter = tool.get('diameter', 0)
                        speed = tool.get('speed', 0)
                        feed = tool.get('feed', 0)
                        
                        message += f"<b>{i+1}. {tool_name}</b> ({tool_type})<br>"
                        message += f"   Diameter: {diameter}mm | Speed: {speed} RPM | Feed: {feed} mm/min<br>"
                        
                        # Add efficiency rating if available
                        if 'efficiency_rating' in tool:
                            efficiency = tool.get('efficiency_rating', 0)
                            message += f"   Efficiency Rating: {efficiency}/100<br>"
                        
                        # Add tool path strategy if available
                        if 'recommended_strategy' in tool:
                            strategy = tool.get('recommended_strategy', '')
                            message += f"   Recommended Strategy: {strategy}<br>"
                        
                        if 'description' in tool:
                            message += f"   <i>{tool['description']}</i><br>"
                        message += "<br>"
                else:
                    message += "<b>No tool recommendations available for this model.</b><br>"
                
                # Add the formatted message to chat
                self.add_assistant_message(message)
                
                # Visualize tool paths if available
                if hasattr(self.mfg_feature_manager, 'visualize_tool_paths'):
                    self.mfg_feature_manager.visualize_tool_paths()
                    self.add_system_message("Tool paths visualized in the 3D view.")
            else:
                error_msg = result.get('error', 'Unknown error during tool recommendations') if result else "Failed to get tool recommendations"
                self.add_system_message(f"Error: {error_msg}")
                self.add_assistant_message("I couldn't get tool recommendations. Please check if your model is valid and try again.")
        except Exception as e:
            self.add_system_message(f"Error during tool recommendations: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status
            self.cloud_feature_status.setText("Ready")
    
    def on_compare_clicked(self):
        """Handle manufacturing method comparison button click"""
        self.add_system_message("Comparing manufacturing methods...")
        try:
            # Check if there's an active document
            if not FreeCAD.ActiveDocument:
                self.add_system_message("No active document found")
                self.add_assistant_message("Please open or create a model before comparing manufacturing methods.")
                return
                
            # Update status
            self.cloud_feature_status.setText("Comparing manufacturing methods...")
            
            # Compare manufacturing methods using the manufacturing feature manager
            result = self.mfg_feature_manager.compare_manufacturing_methods()
            
            if result and result.get('success'):
                # Format the comparison results for display
                comparisons = result.get('comparisons', [])
                recommendation = result.get('recommended_method', {})
                
                # Create a formatted message
                message = f"<b>Manufacturing Method Comparison</b><br><br>"
                
                if recommendation:
                    method_name = recommendation.get('name', 'Unknown')
                    reason = recommendation.get('reason', 'No specific reason provided')
                    message += f"<b>Recommended Method:</b> {method_name}<br>"
                    message += f"<b>Reason:</b> {reason}<br><br>"
                
                if comparisons:
                    message += "<b>Method Comparison:</b><br>"
                    message += "<table border='1' cellpadding='3' style='border-collapse: collapse;'>"
                    message += "<tr><th>Method</th><th>Cost</th><th>Time</th><th>Quality</th><th>Suitability</th></tr>"
                    
                    for comp in comparisons:
                        method = comp.get('method', 'Unknown')
                        cost = comp.get('cost', 'N/A')
                        time = comp.get('time', 'N/A')
                        quality = comp.get('quality', 'N/A')
                        suitability = comp.get('suitability', 0)
                        
                        # Convert suitability to stars
                        stars = '★' * int(suitability) + '☆' * (5 - int(suitability))
                        
                        message += f"<tr><td>{method}</td><td>{cost}</td><td>{time}</td><td>{quality}</td><td>{stars}</td></tr>"
                    
                    message += "</table>"
                
                # Add the formatted message to chat
                self.add_assistant_message(message)
            else:
                error_msg = result.get('error', 'Unknown error comparing manufacturing methods') if result else "Failed to compare manufacturing methods"
                self.add_system_message(f"Error: {error_msg}")
                self.add_assistant_message("I couldn't compare manufacturing methods. Please check if your model is valid and try again.")
        except Exception as e:
            self.add_system_message(f"Error comparing manufacturing methods: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status
            self.cloud_feature_status.setText("Ready")

    def on_show_problems_clicked(self):
        """Handle Show Problem Areas button click (RESTORED HEATMAP OVERLAY FEATURE)"""
        self.add_system_message("Showing manufacturing problem areas...")
        try:
            # Check if there's an active document
            if not FreeCAD.ActiveDocument:
                self.add_system_message("No active document found")
                self.add_assistant_message("Please open or create a model before showing problem areas.")
                return
                
            # Update status
            self.cloud_feature_status.setText("Visualizing problem areas...")
            
            # Get the current Claude-detected issues from the latest analysis
            current_issues = []
            if hasattr(self, 'last_analysis') and self.last_analysis:
                current_issues = self.last_analysis.get('manufacturing_issues', [])
                print(f"DEBUG: Found {len(current_issues)} current Claude issues to visualize")
                if current_issues:
                    # Handle different issue formats robustly
                    first_issue = current_issues[0]
                    issue_title = first_issue.get('title', first_issue.get('description', 'Unknown issue'))
                    print(f"DEBUG: First current issue: {issue_title}")
            
            # Pass the current issues to the visualization function
            if current_issues:
                # Update BOTH the mfg_feature_manager AND cloud_integration with current data
                current_data = {
                    "success": True,
                    "data": {
                        "manufacturing_issues": current_issues
                    }
                }
                
                # Update mfg_feature_manager
                if not hasattr(self.mfg_feature_manager, 'last_dfm_result'):
                    self.mfg_feature_manager.last_dfm_result = {}
                self.mfg_feature_manager.last_dfm_result = current_data
                
                # Update cloud_integration (this is what's actually being called)
                if hasattr(self, 'cloud_integration') and self.cloud_integration:
                    if not hasattr(self.cloud_integration, 'last_dfm_result'):
                        self.cloud_integration.last_dfm_result = {}
                    self.cloud_integration.last_dfm_result = current_data
                    print(f"DEBUG: Updated cloud_integration with {len(current_issues)} current issues")
                
                print(f"DEBUG: Updated both managers with {len(current_issues)} current issues")
            
            # Use the existing visualize_dfm_issues function
            success = self.mfg_feature_manager.visualize_dfm_issues()
            
            if success:
                self.add_system_message("[OK] Problem areas visualized with colored overlays")
                self.add_assistant_message(
                    "<b>Manufacturing Problem Areas Displayed</b><br><br>"
                    "I've overlaid transparent colored markers on your CAD model to highlight manufacturing issues:<br><br>"
                    "🔴 <b>Red:</b> Critical/High severity issues<br>"
                    "🟠 <b>Orange:</b> Medium severity issues<br>"
                    "🔵 <b>Blue:</b> Low severity issues<br><br>"
                    "Each marker shows the location and description of manufacturing problems. "
                    "Click 'Hide Problem Areas' to remove the overlays."
                )
                
                # Show Hide button and hide Show button (CORRECT WORKFLOW)
                self.show_problems_button.setVisible(False)
                self.hide_problems_button.setVisible(True)
            else:
                self.add_system_message("No manufacturing issues found to visualize")
                self.add_assistant_message("No manufacturing problem areas were detected in your current model.")
        except Exception as e:
            self.add_system_message(f"Error showing problem areas: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status
            self.cloud_feature_status.setText("Ready")
    
    def on_hide_problems_clicked(self):
        """Handle Hide Problem Areas button click (ROBUST DFM VISUALIZATION SYSTEM)"""
        self.add_system_message("Hiding manufacturing problem areas...")
        try:
            # Check if there's an active document
            if not FreeCAD.ActiveDocument:
                self.add_system_message("No active document found")
                return
                
            # Update status
            self.cloud_feature_status.setText("Removing problem area overlays...")
            
            # Use the robust DFM visualization system to hide overlays
            doc = FreeCAD.ActiveDocument
            hidden_count = 0
            
            # Find all objects with DFM overlays and hide them
            for obj in doc.Objects:
                if hasattr(obj, 'Mesh') or hasattr(obj, 'Shape'):
                    try:
                        # Try to toggle overlays for this object (hide them)
                        self.mfg_feature_manager.toggle_overlays(obj.Name, visible=False)
                        hidden_count += 1
                        print(f"DEBUG: Hidden overlays for {obj.Name}")
                    except Exception as toggle_error:
                        print(f"DEBUG: No overlays found for {obj.Name}: {toggle_error}")
                        continue
            
            # Also remove any remaining old-style DFM visualization
            self.mfg_feature_manager._remove_existing_dfm_visualization(doc)
            
            if hidden_count > 0:
                self.add_system_message(f"[OK] Problem area overlays hidden for {hidden_count} objects")
                self.add_assistant_message(
                    "<b>Problem Area Overlays Hidden</b><br><br>"
                    f"Manufacturing problem area overlays have been hidden for {hidden_count} objects. "
                    "The overlays are still available and can be shown again using 'Show Problem Areas'."
                )
            else:
                self.add_system_message("[OK] No active overlays found to hide")
                self.add_assistant_message(
                    "<b>No Active Overlays</b><br><br>"
                    "No manufacturing problem area overlays were found to hide. "
                    "Use 'Show Problem Areas' to create overlays first."
                )
            
            # Hide both buttons - workflow complete (CORRECT WORKFLOW)
            self.show_problems_button.setVisible(False)
            self.hide_problems_button.setVisible(False)
        except Exception as e:
            self.add_system_message(f"Error hiding problem areas: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status
            self.cloud_feature_status.setText("Ready")

    
    def closeEvent(self, event):
        """Handle window close event"""
        global _STANDALONE_INSTANCE
        print("Closing Standalone Co-Pilot")
        _STANDALONE_INSTANCE = None
        event.accept()

class StandaloneCoPilotTaskPanel:
    """Task panel for the Standalone Co-Pilot"""
    
    def __init__(self, widget):
        """Initialize the task panel"""
        self.form = widget
        self.widget = widget
        print("StandaloneCoPilotTaskPanel initialized")
    
    def accept(self):
        """Handle accept event"""
        print("StandaloneCoPilotTaskPanel accepted")
        self._cleanup()
        return True
    
    def reject(self):
        """Handle reject event"""
        print("StandaloneCoPilotTaskPanel rejected")
        self._cleanup()
        return True
    
    def _cleanup(self):
        """Clean up resources"""
        global _STANDALONE_INSTANCE
        _STANDALONE_INSTANCE = None
        print("Reset _STANDALONE_INSTANCE to None")
    
    def getStandardButtons(self):
        """Return standard buttons"""
        return 0

def show_standalone_copilot():
    """Show the standalone co-pilot with singleton pattern"""
    global _STANDALONE_INSTANCE
    
    print("\n=== STARTING STANDALONE CO-PILOT ===\n")
    
    # Check if an instance already exists
    if _STANDALONE_INSTANCE is not None:
        print("Standalone Co-Pilot is already running - activating existing instance")
        try:
            # Try to bring existing instance to front
            _STANDALONE_INSTANCE.activateWindow()
            _STANDALONE_INSTANCE.raise_()
            
            # Show message to user
            QtWidgets.QMessageBox.information(
                None,
                "Co-Pilot Already Running",
                "Manufacturing Co-Pilot is already running. Using the existing instance."
            )
        except Exception as e:
            print(f"Error activating existing instance: {e}")
        return
    
    try:
        # Close any active FreeCAD task dialogs
        if FreeCADGui.Control.activeDialog():
            print("Closing active FreeCAD task dialog")
            FreeCADGui.Control.closeDialog()
        
        # Create new instance
        copilot = StandaloneCoPilot()
        _STANDALONE_INSTANCE = copilot
        
        # Show in FreeCAD task panel
        panel = StandaloneCoPilotTaskPanel(copilot)
        FreeCADGui.Control.showDialog(panel)
        print("Standalone Co-Pilot shown in task panel")
        
        print("\n=== STANDALONE CO-PILOT STARTED SUCCESSFULLY ===\n")
    except Exception as e:
        print(f"Error showing Standalone Co-Pilot: {e}")
        traceback.print_exc()
        _STANDALONE_INSTANCE = None
        
        # Show error message
        QtWidgets.QMessageBox.critical(
            None,
            "Co-Pilot Error",
            f"Failed to start Standalone Co-Pilot:\n\n{str(e)}"
        )

# Main entry point
if __name__ == "__main__":
    print("\n=== STANDALONE CO-PILOT MACRO STARTING ===\n")
    
    try:
        # Show the standalone co-pilot
        show_standalone_copilot()
    except Exception as e:
        print(f"ERROR starting Standalone Co-Pilot: {e}")
        traceback.print_exc()
        
        # Show error message
        try:
            QtWidgets.QMessageBox.critical(
                None,
                "Co-Pilot Error",
                f"Failed to start Standalone Co-Pilot:\n\n{str(e)}"
            )
        except Exception as msg_err:
            print(f"Error showing message: {msg_err}")
    
    print("\n=== STANDALONE CO-PILOT MACRO INITIALIZATION COMPLETE ===\n")
