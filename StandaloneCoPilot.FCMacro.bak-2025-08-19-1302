    def on_dfm_clicked(self):
        """Handle DFM analysis button click with advanced options"""
        self.add_system_message("Preparing advanced DFM analysis...")
        try:
            # Check if there's an active document
            if not FreeCAD.ActiveDocument:
                self.add_system_message("No active document found")
                self.add_assistant_message("Please open or create a model before running DFM analysis.")
                return
            
            # Create dialog for advanced DFM options
            dialog = QtWidgets.QDialog(self)
            dialog.setWindowTitle("Advanced DFM Analysis Options")
            dialog.setMinimumWidth(400)
            
            # Create form layout for options
            form_layout = QtWidgets.QFormLayout(dialog)
            
            # Manufacturing process selection
            process_combo = QtWidgets.QComboBox()
            process_combo.addItems([
                "3D Printing (FDM)", 
                "CNC Machining", 
                "Injection Molding",
                "Sheet Metal Forming",
                "Die Casting"
            ])
            form_layout.addRow("Manufacturing Process:", process_combo)
            
            # Material selection
            material_combo = QtWidgets.QComboBox()
            material_combo.addItems([
                "PLA", "ABS", "Nylon",  # 3D Printing materials
                "Aluminum", "Steel", "Brass",  # Metals
                "Polypropylene", "ABS", "Polycarbonate"  # Injection molding materials
            ])
            form_layout.addRow("Material:", material_combo)
            
            # Production volume
            volume_spin = QtWidgets.QSpinBox()
            volume_spin.setRange(1, 1000000)
            volume_spin.setValue(100)
            volume_spin.setSingleStep(10)
            form_layout.addRow("Production Volume:", volume_spin)
            
            # Advanced analysis checkbox
            advanced_check = QtWidgets.QCheckBox("Enable advanced analysis")
            advanced_check.setChecked(True)
            advanced_check.setToolTip("Includes detailed cost analysis and alternative process recommendations")
            form_layout.addRow("", advanced_check)
            
            # Add buttons
            button_box = QtWidgets.QDialogButtonBox(
                QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
            )
            button_box.accepted.connect(dialog.accept)
            button_box.rejected.connect(dialog.reject)
            form_layout.addRow(button_box)
            
            # Show dialog and get results
            if dialog.exec_() != QtWidgets.QDialog.Accepted:
                self.add_system_message("DFM analysis cancelled")
                return
            
            # Get selected options
            process_text = process_combo.currentText()
            material_text = material_combo.currentText().lower()
            production_volume = volume_spin.value()
            advanced_analysis = advanced_check.isChecked()
            
            # Map process text to process code
            process_map = {
                "3D Printing (FDM)": "3d_printing",
                "CNC Machining": "cnc_machining",
                "Injection Molding": "injection_molding",
                "Sheet Metal Forming": "sheet_metal",
                "Die Casting": "die_casting"
            }
            process_code = process_map.get(process_text, "3d_printing")
            
            # Update status
            self.cloud_feature_status.setText("Processing advanced DFM analysis...")
            self.add_system_message(f"Running advanced DFM analysis for {process_text} with {material_text} material...")
            
            # Run DFM analysis using the manufacturing feature manager with advanced options
            result = self.mfg_feature_manager.analyze_dfm(
                manufacturing_process=process_code,
                material=material_text,
                production_volume=production_volume,
                advanced_analysis=advanced_analysis
            )
            
            if result and result.get('success'):
                print("DEBUG: DFM analysis successful, processing UI display")
                print(f"DEBUG: Result keys: {list(result.keys())}")
                
                # Get the data from the result
                data = result.get('data', {})
                print(f"DEBUG: Data keys in result: {list(data.keys())}")
                
                # Try to get data from the transformed format first
                score = data.get('manufacturability_score', 0)
                issues = data.get('issues', [])
                recommendations = data.get('recommendations', [])
                report_text = data.get('report_text', '')
                
                # If we don't have a score, try to get it from the original format
