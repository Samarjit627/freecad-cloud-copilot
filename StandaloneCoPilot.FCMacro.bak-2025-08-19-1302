    def remove_last_processing_message(self):
        """Remove the last 'Processing...' message from chat history"""
        print("DEBUG: Removing last processing message")
        
        # Initialize chat_entries if needed
        if not hasattr(self, 'chat_entries') or not isinstance(self.chat_entries, list):
            print("DEBUG: No chat_entries list to remove from")
            return
            
        # Find and remove the last processing message
        for i in range(len(self.chat_entries) - 1, -1, -1):
            if "Processing..." in self.chat_entries[i]:
                print(f"DEBUG: Found processing message at index {i}")
                self.chat_entries.pop(i)
                print("DEBUG: Removed processing message, refreshing display")
                self._update_chat_display()
                return
                
        print("DEBUG: No processing message found to remove")
    
