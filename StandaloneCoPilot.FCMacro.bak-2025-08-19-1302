    def handle_gear(self, text):
        # Ensure regex is available even if global imports changed
        try:
            import re  # noqa: F401
        except Exception:
            re = None
        """Create a gear based on text description"""
        try:
            print(f"Creating gear from: {text}")
            # Prefer the template manager (supports helix/double-helical/FCGear)
            import sys, os
            try:
                base_dir = os.path.dirname(__file__)
            except Exception:
                base_dir = os.getcwd()
            cad_templates_dir = os.path.join(base_dir, 'cad_templates')
            if cad_templates_dir not in sys.path:
                sys.path.append(cad_templates_dir)
            try:
                import template_manager as _tm
                manager = _tm.get_template_manager()
                template, params = manager.parse_text_request(text)
                if template == 'gear':
                    # Ensure an active document
                    doc = FreeCAD.ActiveDocument or FreeCAD.newDocument('Gear')
                    obj = manager.create_part('gear', doc=doc, **params)
                    if obj is not None:
                        try:
                            import FreeCADGui
                            FreeCADGui.ActiveDocument = FreeCADGui.getDocument(doc.Name)
                            obj.ViewObject.Visibility = True
                            FreeCAD.ActiveDocument.recompute()
                            FreeCADGui.Selection.clearSelection()
                            FreeCADGui.Selection.addSelection(obj)
                            FreeCADGui.updateGui()
                        except Exception as _:
                            pass
                        return {'success': True, 'message': 'Created gear via template manager', 'object': obj}
                    else:
                        print('Template manager failed to create gear; falling back to legacy')
                else:
                    print(f'Template manager parsed template={template}; falling back to legacy')
            except Exception as tm_err:
                print(f'Template manager unavailable or failed: {tm_err}')

            # Legacy fallback (spur-like)
            # Extract teeth/module/width minimally for legacy path
            teeth_match = re.search(r'(\d+)\s*(?:tooth|teeth|toothed)', text, re.IGNORECASE)
            teeth = int(teeth_match.group(1)) if teeth_match else 20
            module_match = re.search(r'module\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            module = float(module_match.group(1)) if module_match else 2.0
            width_match = re.search(r'width|thickness\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            # Fix regex precedence: try width first, then thickness
            if not width_match:
                width_match = re.search(r'(?:width|thickness)\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            width = float(width_match.group(1)) if width_match else 10.0
            return self.create_gear(teeth, module, width)
            
        except Exception as e:
            print(f"Error creating gear: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error creating gear: {str(e)}"}

    def handle_measure_gear(self, text):
        """Measure last created or selected gear and report key dimensions."""
        try:
            import FreeCAD as App
            doc = App.ActiveDocument
            if not doc:
                return {'success': False, 'message': 'No active document'}
            # Prefer selected object
            try:
                import FreeCADGui
                sel = FreeCADGui.Selection.getSelection()
            except Exception:
                sel = []
            candidates = sel if sel else list(reversed(doc.Objects))
            gear = None
            for o in candidates:
                # Skip annotations or objects without a Shape
                try:
                    type_id = getattr(o, 'TypeId', '')
                    if 'Annotation' in type_id:
                        continue
                except Exception:
                    pass
                shp = getattr(o, 'Shape', None)
                if shp is None:
                    continue
                if hasattr(o, 'num_teeth') or (getattr(o, 'Name', '').lower().startswith('gear') or 'Gear' in getattr(o, 'Label', '')):
                    gear = o
                    break
            if not gear:
                return {'success': False, 'message': 'No gear-like object found'}
            # Extract properties with fallbacks
            def _get(obj, names, default=None):
                for n in names:
                    if hasattr(obj, n):
                        try:
                            return float(getattr(obj, n))
                        except Exception:
                            try:
                                return int(getattr(obj, n))
                            except Exception:
                                pass
                return default
            teeth = int(_get(gear, ['num_teeth','teeth','NbTeeth','NumberOfTeeth','z'], 0))
            module = float(_get(gear, ['module','Module','m'], 0.0) or 0.0)
            pa = float(_get(gear, ['pressure_angle','PressureAngle','alpha'], 20.0) or 20.0)
            beta = float(_get(gear, ['helix_angle','HelixAngle','beta','Beta'], 0.0) or 0.0)
            # Height/width from property or from shape bounding box
            try:
                height = float(_get(gear, ['height','Width','Thickness','w'], 0.0))
                if not height or height <= 0:
                    height = float(getattr(gear, 'Shape').BoundBox.ZLength)
            except Exception:
                height = float(getattr(gear, 'Shape').BoundBox.ZLength)
            bore = float(_get(gear, ['bore_diameter','axle_holesize'], 0.0) or 0.0)
            # Compute diameters from module/teeth
            pd = module * teeth if module and teeth else gear.Shape.BoundBox.DiagonalLength/5.0
            od = pd + 2*module if module else gear.Shape.BoundBox.XLength
            rd = pd - 2.5*module if module else max(od - 3*module, 0)
            hand = 'Left' if beta < 0 else ('Right' if beta > 0 else 'Spur')
            msg = (
                f"Measured gear '{gear.Label or gear.Name}':\n"
                f"- Teeth: {teeth}\n"
                f"- Module: {module:g}  PA: {pa:g}°  Helix: {beta:g}° ({hand})\n"
                f"- Pitch Ø: {pd:.2f} mm\n"
                f"- Outer Ø: {od:.2f} mm\n"
                f"- Root Ø: {rd:.2f} mm\n"
                f"- Width: {height:.2f} mm\n"
                f"- Bore: {bore:.2f} mm"
            )
            print(msg)
            return {'success': True, 'message': msg, 'object': gear}
        except Exception as e:
            traceback.print_exc()
            return {'success': False, 'message': f'Error measuring gear: {str(e)}'}
    
    def create_gear(self, teeth=20, module=2.0, width=10.0):
        """Create a gear with the specified parameters"""
        try:
            # Ensure we have an active document
            doc = FreeCAD.ActiveDocument
            if not doc:
                doc = FreeCAD.newDocument("Gear")
            
            # Calculate gear dimensions
            pitch_diameter = teeth * module
            outer_diameter = pitch_diameter + 2 * module  # Addendum
            root_diameter = pitch_diameter - 2.5 * module  # Dedendum
            
            # Create the base cylinder at the root diameter
            base_cylinder = Part.makeCylinder(root_diameter/2, width)
            
            # Create the teeth by adding blocks around the perimeter
            tooth_angle = 360.0 / teeth  # Angle between teeth
            tooth_width_angle = tooth_angle * 0.4  # Width of each tooth in degrees
            
            # Create a compound shape to hold all teeth
            all_teeth = []
            
            for i in range(teeth):
                # Calculate the angle for this tooth
                angle = i * tooth_angle
                
                # Create a tooth as a box
                tooth_height = (outer_diameter - root_diameter) / 2  # Radial height of tooth
                tooth_width = root_diameter * math.sin(math.radians(tooth_width_angle))  # Arc width at root diameter
                
                # Create the tooth as a box
                tooth = Part.makeBox(tooth_height, tooth_width, width)
                
                # Position the tooth at the edge of the root cylinder
                tooth.translate(FreeCAD.Vector(root_diameter/2, -tooth_width/2, 0))
                
                # Rotate the tooth to its position
                tooth.rotate(FreeCAD.Vector(0, 0, 0), FreeCAD.Vector(0, 0, 1), angle)
                
                # Add to our collection
                all_teeth.append(tooth)
            
            # Fuse all teeth with the base cylinder
            gear_shape = base_cylinder
            for tooth in all_teeth:
                gear_shape = gear_shape.fuse(tooth)
            
            # Create a center bore
            bore = module * 5  # Reasonable bore size based on module
            center_hole = Part.makeCylinder(bore/2, width)
            gear_shape = gear_shape.cut(center_hole)
            
            # Create the final object
            gear_obj = doc.addObject("Part::Feature", f"Gear_T{teeth}_M{module}")
            gear_obj.Shape = gear_shape
            
            doc.recompute()
            
            return {
                'success': True,
                'message': f'Created gear: {teeth} teeth, module {module}, \u00f8{pitch_diameter:.1f}mm pitch diameter',
                'object': gear_obj,
                'specs': {
                    'teeth': teeth,
                    'module': module,
                    'pitch_diameter': pitch_diameter,
                    'outer_diameter': outer_diameter,
                    'root_diameter': root_diameter,
                    'width': width
                }
            }
            
        except Exception as e:
            print(f"Error creating gear: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error creating gear: {str(e)}"}
    
    def handle_cylinder(self, text):
        """Create a cylinder based on text description"""
        try:
            # Extract diameter/radius
            diameter_match = re.search(r'diameter\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            radius_match = re.search(r'radius\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            
            radius = 10.0  # Default
            if diameter_match:
                radius = float(diameter_match.group(1)) / 2
            elif radius_match:
                radius = float(radius_match.group(1))
            
            # Extract height/length
            height_match = re.search(r'(?:height|length)\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
            height = float(height_match.group(1)) if height_match else 50.0
            
            # Create cylinder
            doc = FreeCAD.ActiveDocument or FreeCAD.newDocument("CADPart")
            cylinder = Part.makeCylinder(radius, height)
            obj = doc.addObject("Part::Feature", "Cylinder")
            obj.Shape = cylinder
            doc.recompute()
            
            return {'success': True, 'message': f"Created cylinder with radius {radius}mm and height {height}mm", 'object': obj}
            
        except Exception as e:
            print(f"Error creating cylinder: {str(e)}")
            traceback.print_exc()
            return {'success': False, 'message': f"Error creating cylinder: {str(e)}"}
    
    def handle_extrude(self, text):
        """Handle extrusion commands with improved reliability"""
        try:
            print(f"Handling extrusion: {text}")
            print(f"Debug: ===== EXTRUDE OPERATION START (v2025-08-18-1) =====")
            
            # Extract distance with better pattern matching
            distance_patterns = [
                r'(?:by|to|of)\s*(\d+(?:\.\d+)?)\s*(?:mm|millimeters?)?',
                r'(\d+(?:\.\d+)?)\s*(?:mm|millimeters?)',
                r'extrude.*?(\d+(?:\.\d+)?)',
            ]
            
            distance = 10.0  # Default
            for pattern in distance_patterns:
                distance_match = re.search(pattern, text, re.IGNORECASE)
                if distance_match:
                    distance = float(distance_match.group(1))
                    break
            
            print(f"Debug: Extrusion distance = {distance}mm")
            
            # Extract direction
            direction = 'up'  # Default direction
            if any(word in text.lower() for word in ['down', 'negative', 'inward', 'into']):
                direction = 'down'
            print(f"Debug: Extrusion direction = {direction}")
            
            # Ensure we have an active document
            if not FreeCAD.ActiveDocument:
                print("Debug: No active document, creating one")
                FreeCAD.newDocument("CADPart")
            
            doc = FreeCAD.ActiveDocument
            print(f"Debug: Active document is {doc.Name}")
            
            # Get selection
            try:
                selection = FreeCADGui.Selection.getSelectionEx()
                print(f"Debug: Found {len(selection)} selected objects")
                
                if not selection:
                    print("Debug: No selection found")
                    return {'success': False, 'message': 'Please select a face, sketch, or object to extrude first'}
                
            except Exception as sel_err:
                print(f"Debug: Selection error: {str(sel_err)}")
                return {'success': False, 'message': f'Selection error: {str(sel_err)}'}
            
            # Create extrusion vector
            if direction == 'down':
                extrude_vector = FreeCAD.Vector(0, 0, -distance)
            else:
                extrude_vector = FreeCAD.Vector(0, 0, distance)
            
            print(f"Debug: Extrusion vector: {extrude_vector}")
            
            # Process the selection
            success_count = 0
            error_messages = []
            
            for sel_item in selection:
                try:
                    obj = sel_item.Object
                    print(f"Debug: Processing object: {obj.Name} (Type: {obj.TypeId})")
                    
                    result_obj = None
                    
                    # Case 1: Face selection (most common for extrude commands)
                    if hasattr(sel_item, 'SubObjects') and sel_item.SubObjects:
                        print(f"Debug: Found {len(sel_item.SubObjects)} sub-objects")
                        
                        # Look for faces in the selection using proper FreeCAD API
                        faces = []
                        if hasattr(sel_item, 'SubElementNames'):
                            for sub_name in sel_item.SubElementNames:
                                if sub_name.startswith('Face'):
                                    # Get face index and extract the actual face from the shape
                                    face_index = int(sub_name[4:]) - 1
                                    if face_index < len(obj.Shape.Faces):
                                        faces.append(obj.Shape.Faces[face_index])
                        
                        sub_objects = sel_item.SubObjects
                        print(f"Debug: Found {len(sub_objects)} face(s) to extrude")
                        # If no face actually selected, infer a face from the single solid (robust for cubes)
                        if len(sub_objects) == 0 and hasattr(obj, 'Shape') and len(obj.Shape.Faces) > 0:
                            try:
                                print("Debug: No selected face; attempting face inference from solid")
                                faces = obj.Shape.Faces
                                # Prefer largest planar face with normal ~ +Z
                                import math
                                def face_area(f):
                                    try:
                                        return f.Area
                                    except Exception:
                                        return 0.0
                                def face_normal(f):
                                    try:
                                        # sample at face parameter mid-point
                                        u1,u2,v1,v2 = f.ParameterRange
                                        mid = f.normalAt((u1+u2)/2.0, (v1+v2)/2.0)
                                        return mid
                                    except Exception:
                                        try:
                                            return f.Surface.Axis
                                        except Exception:
                                            return None
                                # Score faces: planar first, then alignment with +Z, then area
                                def score(f):
                                    planar = int(getattr(getattr(f, 'Surface', None), 'isPlanar', lambda: False)())
                                    n = face_normal(f)
                                    align = 0.0
                                    if n is not None:
                                        try:
                                            nz = n.normalize()
                                            align = max(0.0, min(1.0, nz.z))
                                        except Exception:
                                            pass
                                    return (planar, align, face_area(f))
                                best = max(faces, key=score)
                                sub_objects = [best]
                                print("Debug: Inferred 1 face from solid for extrusion")
                            except Exception as infer_err:
                                print(f"Debug: Face inference failed: {infer_err}")
                        
                        try:
                            print("Debug: Attempting direct face extrusion [shape-based]")
                            vec = FreeCAD.Vector(0,0,distance if direction == 'up' else -distance)
                            print(f"Debug: Extrusion vector: {vec}")
                            # Robust path across FreeCAD versions: always extrude the actual Part.Face shape
                            # Determine a concrete face from either selected subelements or inferred face
                            face_obj = None
                            if hasattr(sel_item, 'SubElementNames') and sel_item.SubElementNames:
                                for sub_name in sel_item.SubElementNames:
                                    if sub_name.startswith('Face'):
                                        idx = int(sub_name[4:]) - 1
                                        if 0 <= idx < len(obj.Shape.Faces):
                                            face_obj = obj.Shape.Faces[idx]
                                            break
                            if face_obj is None:
                                face_obj = sub_objects[0]

                            extruded_shape = face_obj.extrude(vec)
                            result_obj = FreeCAD.ActiveDocument.addObject("Part::Feature", f"Extrude_{obj.Label}_{int(distance)}mm")
                            result_obj.Shape = extruded_shape
                            FreeCAD.ActiveDocument.recompute()
                            print(f"Debug: Successfully created face extrusion (shape): {result_obj.Name}")

                            result_obj.ViewObject.Visibility = True
                            success_count += 1
                            # Align view and selection for user visibility
                            try:
                                if hasattr(FreeCADGui, 'Selection'):
                                    FreeCADGui.Selection.clearSelection()
                                    FreeCADGui.Selection.addSelection(result_obj)
                                if FreeCADGui.ActiveDocument and FreeCADGui.ActiveDocument.ActiveView:
                                    FreeCADGui.ActiveDocument.ActiveView.viewAxometric()
                                    FreeCADGui.ActiveDocument.ActiveView.fitAll()
                                FreeCADGui.updateGui()
                            except Exception as _view_err:
                                print(f"Debug: View alignment after extrude failed: {_view_err}")

                        except Exception as face_err:
                            print(f"Debug: Direct face extrusion failed: {str(face_err)}")
                            error_messages.append(f"Face extrusion failed: {str(face_err)}")
                    
                    # Case 2: Sketch object
                    elif obj.TypeId == "Sketcher::SketchObject":
                        print("Debug: Processing sketch object")
                        try:
                            # Try to create a face from the sketch and extrude it
                            sketch_wires = obj.Shape.Wires
                            if sketch_wires:
                                wire = sketch_wires[0]
                                if wire.isClosed():
                                    face = Part.Face(wire)
                                    extruded_shape = face.extrude(extrude_vector)
                                    
                                    extrude_name = f"Extrude_{obj.Name}_{int(abs(distance))}mm"
                                    result_obj = doc.addObject("Part::Feature", extrude_name)
                                    result_obj.Shape = extruded_shape
                                    result_obj.ViewObject.Visibility = True
                                    
                                    print(f"Debug: Successfully created sketch extrusion: {extrude_name}")
                                    success_count += 1
                                else:
                                    error_messages.append(f"Sketch {obj.Name} is not closed")
                            else:
