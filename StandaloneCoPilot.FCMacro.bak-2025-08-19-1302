    def eventFilter(self, obj, event):
        """Handle events for input field"""
        if obj is self.input_field and event.type() == QtCore.QEvent.KeyPress:
            if event.key() == QtCore.Qt.Key_Return and not event.modifiers() & QtCore.Qt.ShiftModifier:
                self.send_message()
                return True
        return super().eventFilter(obj, event)
    
    def _workspace_has_part(self):
        """Return True if any solid exists in the active document."""
        try:
            import FreeCAD as App
            doc = App.ActiveDocument
            if not doc:
                return False
            print(f"DEBUG: _workspace_has_part checking doc='{doc.Label or doc.Name}' with {len(getattr(doc,'Objects',[]) or [])} objects")
            for obj in getattr(doc, 'Objects', []) or []:
                try:
                    shp = getattr(obj, 'Shape', None)
                    obj_type = getattr(obj, 'TypeId', type(obj).__name__)
                    if shp and not shp.isNull():
                        solids_ok = hasattr(shp, 'Solids') and len(shp.Solids) > 0
                        faces_ok = hasattr(shp, 'Faces') and len(shp.Faces) > 0
                        try:
                            vol_ok = float(getattr(shp,'Volume',0.0)) > 0.0
                        except Exception:
                            vol_ok = False
                        if solids_ok or (faces_ok and vol_ok):
                            print(f"DEBUG: Detected part candidate: {obj.Label or obj.Name} ({obj_type}) | solids={getattr(shp,'Solids',None)} volume={getattr(shp,'Volume',None)}")
                            return True
                    # Mesh support
                    if obj_type.startswith('Mesh') or obj_type == 'Mesh::Feature':
                        msh = getattr(obj,'Mesh',None)
                        if msh and hasattr(msh,'CountFacets') and msh.CountFacets > 0:
                            print(f"DEBUG: Detected mesh part candidate: {obj.Label or obj.Name} facets={msh.CountFacets}")
                            return True
                except Exception:
                    continue
            # Selection fallback: if any selection present, consider as context
            try:
                import FreeCADGui
                sel = FreeCADGui.Selection.getSelectionEx()
                if sel:
                    print(f"DEBUG: Selection present ({len(sel)}); treating as part available")
                    return True
            except Exception:
                pass
        except Exception:
            pass
        return False

    def send_message(self):
        """Send a message to the cloud service"""
        message = self.input_field.toPlainText().strip()
        if not message:
            return
        
        # Add user message to chat history
        self.add_user_message(message)
        
        # Clear input field
        self.input_field.clear()
        
        # Show processing indicator
        self.add_system_message("Processing...")

        # Route explicit DFM/manufacturability requests first (tolerant to spelling/variants)
        try:
            lower = message.lower()
            norm = lower.replace('-', ' ').replace('_', ' ')
            dfm_intent = (
                ('dfm' in norm) or
                ('manufactur' in norm and any(w in norm for w in ['analy', 'analyse', 'check', 'assess', 'evaluate', 'review'])) or
                ('manufacturability' in norm) or
                ('problem area' in norm) or ('show problem' in norm) or ('manufacturing issues' in norm)
            )
            print(f"DEBUG: DFM intent detected? {dfm_intent} | msg='{message}'")
            if dfm_intent:
                has_part = self._workspace_has_part()
                self.remove_last_processing_message()
                if has_part:
                    self.add_assistant_message("Got it — analyzing manufacturability of the current part…")
                    self.on_dfm_clicked()
                else:
                    # As a last resort, run DFM against any preselected sub-shapes if present
                    try:
                        import FreeCADGui
                        if FreeCADGui.Selection.getSelection():
                            self.add_assistant_message("I don't see a solid body, but you have a selection. I'll run a targeted DFM analysis on the selection…")
                            self.on_dfm_clicked()
                            return
                    except Exception:
                        pass
                    self.add_assistant_message("I don't see a part in the workspace. Import a STEP/IGES or create a shape, then I'll run an Advance DFM analysis.")
                return
        except Exception:
            pass

        # Lightweight greeting/engagement handler
        try:
            _greet_words = {"hi", "hello", "hey", "hola", "yo", "namaste"}
            if message.lower() in _greet_words or message.lower().startswith(("hi ", "hello ", "hey ")):
                self.remove_last_processing_message()
                self.add_assistant_message("Hi! I'm your manufacturing co‑pilot. I can create parts, modify geometry, or run DFM analysis. What are you working on?")
                return
        except Exception:
            pass

        # Pilot: After first user action, if a part exists, acknowledge once
        try:
            if not getattr(self, '_pilot_part_ack_done', False):
                if self._workspace_has_part():
                    self.add_system_message("Detected a part in the workspace.")
                    # Gentle, single follow-up to engage (only when not DFM intent)
                    self.add_assistant_message("Would you like me to run an Advance DFM analysis, show problem areas, or make a CAD edit?")
                    self._pilot_part_ack_done = True
        except Exception:
            pass
        
        # Try text-to-CAD first (if available)
        if hasattr(self, 'nl_cad_editor') and hasattr(self.nl_cad_editor, 'text_to_cad') and self.nl_cad_editor.text_to_cad.is_text_to_cad_request(message):
            self.process_cad_command(message)
        # Check if this is a regular CAD command
        elif self.is_cad_command(message):
            self.process_cad_command(message)
        else:
            # Use Axis 5 Claude AI for conversational CAD generation and manufacturing intelligence
            try:
                # Remove processing indicator
                self.remove_last_processing_message()
                
                # Use Claude AI processor for advanced conversational processing
                if hasattr(self, 'ai_processor') and self.ai_processor:
                    print(f"🤖 Axis 5 processing conversational request: {message[:50]}...")
                    ai_response = self.ai_processor.process_advanced_command(message)
                    
                    if ai_response and ai_response.get('success'):
                        response_text = ai_response.get('response', 'No response received')
                        
                        # Check if Claude generated FreeCAD code for CAD generation
                        freecad_code = ai_response.get('freecad_code')
                        if freecad_code:
                            print(f"[OK] Axis 5 generated FreeCAD code: {len(freecad_code)} chars")
                            # Execute the FreeCAD code for CAD generation
                            try:
                                exec(freecad_code)
                                if FreeCAD.ActiveDocument:
                                    FreeCAD.ActiveDocument.recompute()
                                if hasattr(FreeCADGui, 'ActiveDocument') and FreeCADGui.ActiveDocument:
                                    import os
                                    if os.getenv('AXIS5_FITALL_ON_CREATE', '0') == '1':
                                        FreeCADGui.ActiveDocument.ActiveView.fitAll()
                                response_text += "\n\n[OK] CAD model generated successfully and visible in 3D view!"
                            except Exception as code_err:
                                print(f"Error executing Axis 5's FreeCAD code: {str(code_err)}")
                                response_text += f"\n\n⚠️ Error executing generated CAD code: {str(code_err)}"
                        
                        # Add Axis 5's conversational response to chat
                        source = ai_response.get('source', 'ai')
                        if source == 'claude_conversational':
                            self.add_assistant_message(f"🤖 Axis 5: {response_text}")
                        else:
                            self.add_assistant_message(response_text)
                    else:
                        error_msg = ai_response.get('error', 'Unknown error') if ai_response else 'No response'
                        print(f"Axis 5 processing failed: {error_msg}")
                        # Fallback to cloud service
                        response = self.cloud_client.get_chat_response(message)
                        
                        # Extract response text
                        if "response" in response:
                            response_text = response["response"]
                        elif "error" in response:
                            response_text = f"Error: {response['error']}"
                        else:
                            print(f"Debug: Received empty response from cloud: {response}")
                            response_text = "I couldn't get a reply from the cloud service. I can help you create/modify CAD or run DFM analysis. What would you like to do?"
                        
                        # Add fallback response
                        self.add_assistant_message(response_text)
                else:
                    # Fallback to cloud service if AI processor not available
                    response = self.cloud_client.get_chat_response(message)
                    
                    # Extract response text
                    if "response" in response:
                        response_text = response["response"]
                    elif "error" in response:
                        response_text = f"Error: {response['error']}"
                    else:
                        print(f"Debug: Received empty response from cloud: {response}")
                        response_text = "I couldn't get a reply from the cloud service. I can help you create/modify CAD or run DFM analysis. What would you like to do?"
                    
                    # Add fallback response
                    self.add_assistant_message(response_text)
                
            except Exception as e:
                # Remove processing indicator
                self.remove_last_processing_message()
                
                # Add error message
                self.add_system_message(f"Axis 5 Error: {str(e)}")
                print(f"Error in Axis 5 processing: {e}")
                traceback.print_exc()
    
    def is_cad_command(self, text):
        """Check if the text is a CAD command"""
        cad_indicators = [
            'create', 'make', 'add', 'generate',
            'box', 'cylinder', 'sphere', 'cube',
            'bracket', 'gear', 'housing', 'shaft',
            'extrude', 'extend', 'pull', 'fillet', 'round'
        ]
        
        text_lower = text.lower()
        return any(indicator in text_lower for indicator in cad_indicators)
    
    def process_cad_command(self, text):
        """Process a CAD command using the NL CAD editor"""
        try:
            # Remove processing indicator
            self.remove_last_processing_message()
            
            # Add system message
            self.add_system_message(f"Creating CAD model from: '{text}'")
            
            # Update status indicator
            self.cloud_feature_status.setText("Processing Text-to-CAD request...")
            
            # Process command with NL CAD editor
            result = self.nl_cad_editor.process_command(text)
            
            # Add route badge if available (non-invasive UI info)
            try:
                route = result.get('route') if isinstance(result, dict) else None
                if route:
                    # Normalize known routes
                    route_map = {
                        'text_to_cad_server': 'Text-to-CAD server',
                        'local_handler': 'Local handler',
                        'llm_assisted_code': 'LLM-assisted code'
                    }
                    route_label = route_map.get(route, route)
                    self.add_system_message(f"Route: {route_label}")
                # Indicate if LLM refinement occurred
                if isinstance(result, dict) and result.get('llm_refined'):
                    rp = result.get('refined_prompt')
                    if rp:
                        self.add_system_message("LLM refined the prompt for clarity")
            except Exception:
                pass

            if result['success']:
                # Add success message
                self.add_system_message(f"[OK] {result['message']}")
                
                # Check for engineering analysis from Text-to-CAD
                if 'engineering_analysis' in result and result['engineering_analysis']:
                    # Format engineering analysis as a detailed message
                    analysis_message = f"I've created the CAD model based on your description. You can see it in the 3D view.\n\n"
                    analysis_message += f"**Engineering Analysis:**\n{result['engineering_analysis']}"
                    self.add_assistant_message(analysis_message)
                else:
                    # Add standard assistant message with details
                    self.add_assistant_message(f"I've created the CAD model based on your description. You can see it in the 3D view.")
            else:
                # Add error message
                self.add_system_message(f"❌ {result['message']}")
                
                # Add assistant message with error
                self.add_assistant_message(f"I couldn't create the CAD model. {result['message']}")
            
        except Exception as e:
            # Add error message
            self.add_system_message(f"Error processing CAD command: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status indicator
            self.cloud_feature_status.setText("Ready")
    
    def update_status(self, connected, quality="unknown", latency=0):
        """Update the cloud connection status indicator"""
        if connected:
            # Set color based on connection quality
            if quality == "excellent":
                self.status_indicator.setStyleSheet("color: #00AA00;")  # Bright green
                status_text = "Cloud: Excellent"
            elif quality == "good":
                self.status_indicator.setStyleSheet("color: #00CC00;")  # Green
                status_text = "Cloud: Good"
            elif quality == "fair":
                self.status_indicator.setStyleSheet("color: #CCCC00;")  # Yellow
                status_text = "Cloud: Fair"
            elif quality == "poor":
                self.status_indicator.setStyleSheet("color: #CC6600;")  # Orange
                status_text = "Cloud: Poor"
            else:
                self.status_indicator.setStyleSheet("color: #00CC00;")  # Default green
                status_text = "Cloud: Connected"
                
            self.status_text.setText(status_text)
            self.cloud_connected = True
            
            # Update tooltip with detailed info
            tooltip = f"Cloud Status: {quality.title()}\nLatency: {latency}ms"
            self.status_widget.setToolTip(tooltip)
        else:
            self.status_indicator.setStyleSheet("color: red;")
            self.status_text.setText("Cloud: Disconnected")
            self.cloud_connected = False
            self.status_widget.setToolTip("Cloud connection failed. Click to retry.")
    
    def retry_connection(self, event):
        """Retry cloud connection when status indicator is clicked"""
        self.add_system_message("Retrying cloud connection...")
        success = self.cloud_client.test_connection()
        if success:
            self.add_system_message("Cloud connection restored!")
        else:
            self.add_system_message(f"Cloud connection failed: {self.cloud_client.last_error}")
    
    def check_connection(self):
        """Periodically check cloud connection"""
        # Only run check if more than 5 minutes since last check
        current_time = time.time()
        if current_time - self.cloud_client.last_check_time > 300:
            print("Performing periodic connection check")
            self.cloud_client.test_connection()
    
