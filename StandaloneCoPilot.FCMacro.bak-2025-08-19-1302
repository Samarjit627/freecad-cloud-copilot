    def on_hide_problems_clicked(self):
        """Handle Hide Problem Areas button click (ROBUST DFM VISUALIZATION SYSTEM)"""
        self.add_system_message("Hiding manufacturing problem areas...")
        try:
            # Check if there's an active document
            if not FreeCAD.ActiveDocument:
                self.add_system_message("No active document found")
                return
                
            # Update status
            self.cloud_feature_status.setText("Removing problem area overlays...")
            
            # Use the robust DFM visualization system to hide overlays
            doc = FreeCAD.ActiveDocument
            hidden_count = 0
            
            # Find all objects with DFM overlays and hide them
            for obj in doc.Objects:
                if hasattr(obj, 'Mesh') or hasattr(obj, 'Shape'):
                    try:
                        # Try to toggle overlays for this object (hide them)
                        self.mfg_feature_manager.toggle_overlays(obj.Name, visible=False)
                        hidden_count += 1
                        print(f"DEBUG: Hidden overlays for {obj.Name}")
                    except Exception as toggle_error:
                        print(f"DEBUG: No overlays found for {obj.Name}: {toggle_error}")
                        continue
            
            # Also remove any remaining old-style DFM visualization
            self.mfg_feature_manager._remove_existing_dfm_visualization(doc)
            
            if hidden_count > 0:
                self.add_system_message(f"[OK] Problem area overlays hidden for {hidden_count} objects")
                self.add_assistant_message(
                    "<b>Problem Area Overlays Hidden</b><br><br>"
                    f"Manufacturing problem area overlays have been hidden for {hidden_count} objects. "
                    "The overlays are still available and can be shown again using 'Show Problem Areas'."
                )
            else:
                self.add_system_message("[OK] No active overlays found to hide")
                self.add_assistant_message(
                    "<b>No Active Overlays</b><br><br>"
                    "No manufacturing problem area overlays were found to hide. "
                    "Use 'Show Problem Areas' to create overlays first."
                )
            
            # Hide both buttons - workflow complete (CORRECT WORKFLOW)
            self.show_problems_button.setVisible(False)
            self.hide_problems_button.setVisible(False)
        except Exception as e:
            self.add_system_message(f"Error hiding problem areas: {str(e)}")
            traceback.print_exc()
        finally:
            # Reset status
            self.cloud_feature_status.setText("Ready")

    
