    def _update_chat_display(self):
        """Update the chat display with the current chat history"""
        print("DEBUG: _update_chat_display called")
        
        try:
            # Check if chat_entries attribute exists and is a list
            if not hasattr(self, 'chat_entries'):
                print("DEBUG: Initializing chat_entries as a list")
                self.chat_entries = []
            
            # Ensure chat_entries is a list
            if not isinstance(self.chat_entries, list):
                print(f"DEBUG: Converting chat_entries from {type(self.chat_entries)} to list")
                self.chat_entries = [str(self.chat_entries)]
            
            # Check if chat_history attribute exists and is a QTextEdit/QTextBrowser widget
            if hasattr(self, 'chat_history') and isinstance(self.chat_history, (QtWidgets.QTextEdit, QtWidgets.QTextBrowser)):
                print("DEBUG: chat_history is a QTextEdit widget")
                print(f"DEBUG: Found {len(self.chat_entries)} chat entries")
                
                # Join all entries with proper HTML line breaks
                html_content = "<html><body>"
                for entry in self.chat_entries:
                    html_content += entry + "<br><br>"
                html_content += "</body></html>"
                
                # Set the HTML content to the widget
                print(f"DEBUG: Setting HTML content of length {len(html_content)}")
                self.chat_history.setHtml(html_content)
                print("DEBUG: Updated chat_history widget with HTML content")
                
                # Scroll to bottom
                scrollbar = self.chat_history.verticalScrollBar()
                scrollbar.setValue(scrollbar.maximum())
                print("DEBUG: Scrolled to bottom of chat_history")
            else:
                print("DEBUG: chat_history is not a QTextEdit widget, outputting to console instead")
                print("\n=== CHAT HISTORY ===\n")
                for entry in self.chat_entries:
                    # Strip HTML tags for console output
                    plain_text = re.sub('<[^<]+?>', '', entry)
                    print(plain_text)
                print("\n=== END CHAT HISTORY ===\n")
        except Exception as e:
            print(f"ERROR: Failed to update chat display: {str(e)}")
            traceback.print_exc()
            
